---
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '../styles/fonts.css';
import '@fontsource-variable/figtree';
import '@fontsource/noto-naskh-arabic/arabic-500.css';
import '@fontsource/noto-naskh-arabic/arabic-600.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-300.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Backdrop from '../components/Backdrop.astro';
import Lightbox from '../components/Lightbox.astro';
import EmblemSymbol from '../components/EmblemSymbol.astro';
// the faces the first screen is set in: asked for with the HTML, not after the first layout
import displayFace from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url';
import italicFace from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-italic.woff2?url';
import textFace from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import arabicDisplayFace from '@fontsource/noto-naskh-arabic/files/noto-naskh-arabic-arabic-600-normal.woff2?url';
import arabicTextFace from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url';
import { locales, localeMeta, path, asset, tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { profile } from '../content/profile';
import { ids } from '../lib/seo';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** path below the locale root, e.g. 'work/cheezy' */
  route?: string;
  ogImage?: string;
  /** this page's own nodes, added to the site-wide graph (the site and the person) */
  jsonLd?: Record<string, unknown>[];
  /** pages that are not content (404): kept out of search, with no canonical of their own */
  noindex?: boolean;
}

const { lang, title, description, route = '', ogImage = `og/default-${lang}.jpg`, jsonLd = [], noindex = false } = Astro.props;
const dir = localeMeta[lang].dir;
const site = Astro.site!;
const canonical = new URL(path(lang, route), site).href;
const og = new URL(asset(ogImage), site).href;
const preloads = lang === 'ar' ? [arabicDisplayFace, arabicTextFace] : [displayFace, italicFace, textFace];
// Vercel Web Analytics (cookieless, same origin). The script only exists on Vercel deployments.
const analytics = import.meta.env.PROD && !!process.env.VERCEL;
const id = ids(site);
const website = {
  '@type': 'WebSite',
  '@id': id.website,
  url: new URL('/', site).href,
  name: profile.name.en,
  alternateName: profile.name.ar,
  inLanguage: [...locales],
  publisher: { '@id': id.person },
};
const person = {
  '@type': 'Person',
  '@id': id.person,
  name: profile.name.en,
  alternateName: profile.name.ar,
  jobTitle: profile.role.en,
  email: `mailto:${profile.email}`,
  url: new URL(path('en'), site).href,
  image: new URL(asset('media/profile/portrait-color.webp'), site).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Tunis', addressCountry: 'TN' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Université Sesame' },
  knowsLanguage: ['ar', 'en', 'fr'],
  sameAs: [profile.links.github, profile.links.linkedin],
};
---

<!doctype html>
<html lang={lang} dir={dir} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name.en} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="theme-color" content="#f5efe1" />
    <meta name="color-scheme" content="light" />
    {preloads.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    {!noindex && (
      <Fragment>
        <link rel="canonical" href={canonical} />
        {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(path(l, route), site).href} />)}
        <link rel="alternate" hreflang="x-default" href={new URL(path('en', route), site).href} />
      </Fragment>
    )}

    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('site.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={tr(profile.name, lang)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${profile.name.en}`} />
    <meta property="og:locale" content={localeMeta[lang].ogLocale} />
    {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': [website, person, ...jsonLd] })} />
    {analytics && (
      <Fragment>
        <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
        <script is:inline defer src="/_vercel/insights/script.js"></script>
      </Fragment>
    )}

    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
      try {
        localStorage.setItem('lang', document.documentElement.lang);
        if (localStorage.getItem('motion') === 'off') document.documentElement.classList.add('motion-off');
      } catch (e) {}
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('reduced');
      // when has this page arrived? (scripts/settled.ts) — at once, or when the brush has passed
      window.__settled = new Promise(function (done) {
        if (!('onpagereveal' in window)) return done();
        addEventListener('pagereveal', function (e) {
          if (!e.viewTransition) return done();
          window.__swept = true;
          e.viewTransition.finished.then(done, done);
        }, { once: true });
        setTimeout(done, 4000); // a tab opened in the background never reveals: don't wait for it
      });
    </script>
  </head>
  <body data-lang={lang}>
    <div class="vt-ink" aria-hidden="true"></div>
    <EmblemSymbol />
    <Backdrop />
    <a class="skip-link" href="#main">{tr(ui.skip, lang)}</a>
    <Nav lang={lang} route={route} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} route={route} />
    <Lightbox lang={lang} />
    <canvas class="ink" data-ink aria-hidden="true" hidden></canvas>
    <script>
      import { initMotion } from '../scripts/motion';
      import { initFilms } from '../scripts/films';
      import { settled } from '../scripts/settled';
      settled.then(() => initFilms());
      initMotion();
      // living ink (scripts/ink.ts) is for a mouse or a pen: on a phone its code is never fetched
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const idle: (f: () => void) => void = (window as any).requestIdleCallback ?? ((f) => setTimeout(f, 300));
        settled.then(() => idle(() => import('../scripts/ink').then((m) => m.initInk())));
      }
    </script>
  </body>
</html>
