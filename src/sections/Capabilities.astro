---
// Capabilities as information design: every tool from the six projects' real stacks, set as a
// field of words grouped by what they do and sized by how many projects they built. Point at a
// project and the field keeps only the tools behind it; point at a tool and the projects it built
// light up. Nothing here is self-assessed — it is read from src/content/projects.ts.
import { tr, type Locale, type L } from '../i18n/config';
import { ui } from '../i18n/ui';
import { projects } from '../content/projects';
import { capabilities, languagesSpoken } from '../content/capabilities';

interface Props { lang: Locale }
const { lang } = Astro.props;

const normal = (t: string) => t.replace(/^Groq.*/, 'Groq').replace(/^YOLOv8n?$/, 'YOLOv8').replace(/^React \d+$/, 'React').replace(/^Vercel Functions$/, 'Vercel').replace(/^Unity \d+$/, 'Unity');
const usage = new Map<string, string[]>();
for (const p of projects) for (const t of new Set(p.stack.map(normal))) usage.set(t, [...(usage.get(t) ?? []), p.slug]);

const groups: { name: L; tools: string[] }[] = [
  { name: capabilities[0].name, tools: ['YOLOv8', 'Whisper', 'Groq', 'Gemini', 'RAG', 'Web Speech API'] },
  { name: capabilities[1].name, tools: ['React Native', 'Expo', 'React', 'Next.js', 'TypeScript', 'JavaScript', 'TanStack Start', 'Tailwind CSS', 'FastAPI', 'Flask', 'Supabase', 'SQLite', 'Leaflet', 'Recharts', 'Vercel', 'Railway'] },
  { name: capabilities[2].name, tools: ['Python', 'NumPy', 'SciPy', 'pandas', 'scikit-learn', 'Matplotlib', 'requests', 'BeautifulSoup', 'pytest', 'GitHub Actions'] },
  { name: capabilities[3].name, tools: ['Unity', 'C#', 'URP', 'Input System', 'Three.js', 'Remotion', 'Playwright'] },
];
const placed = new Set(groups.flatMap((g) => g.tools));
const rest = [...usage.keys()].filter((t) => !placed.has(t));
if (rest.length) groups[1].tools.push(...rest);
const title = (slug: string) => projects.find((p) => p.slug === slug)!.title;
const heading: L = { en: 'What built what.', fr: 'Qui a construit quoi.', ar: 'ما الذي بنى ماذا.' };
const hint: L = { en: 'Point at a project to keep only its tools; point at a tool to see what it built.', fr: 'Survolez un projet pour ne garder que ses outils ; survolez un outil pour voir ce qu’il a construit.', ar: 'أشِر إلى مشروع لتبقى أدواته فقط، وإلى أداة لترى ما بنته.' };
---

<section id="capabilities" class="caps" aria-labelledby="caps-title" data-tone="light" data-chapter-name={tr(ui.capabilities.kicker, lang)} data-caps>
  <header class="caps__head">
    <h2 id="caps-title" class="caps__title">{tr(heading, lang)}</h2>
    <p class="caps__hint">{tr(hint, lang)}</p>
  </header>

  <div class="caps__projects" role="group" aria-label={tr(ui.nav.work, lang)}>
    {projects.map((p) => (
      <button type="button" data-proj={p.slug} aria-pressed="false" style={`--hue:${p.tone}`}>{p.title}</button>
    ))}
  </div>

  <div class="caps__field">
    {groups.map((g) => (
      <div class="caps__group">
        <h3 class="caps__gname">{tr(g.name, lang)}</h3>
        <ul class="caps__tools" lang="en">
          {g.tools.filter((t) => usage.has(t)).map((t) => {
            const used = usage.get(t)!;
            return (
              <li class="tool" data-p={used.join(' ')} data-w={Math.min(3, used.length)}>
                {t}<span class="sr-only"> — {used.map(title).join(', ')}</span>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
  <p class="caps__langs" lang="en">{languagesSpoken.join('  ·  ')}</p>
</section>

<style>
  .caps { position: relative; padding: 7rem var(--gutter) 6rem; background: #fbfaf6; }
  .caps__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem 3rem; }
  .caps__title { font-family: 'Cormorant Garamond', var(--font-display); font-size: clamp(3rem, 1.5rem + 5vw, 7rem); font-weight: 500; font-style: italic; line-height: 0.9; letter-spacing: -0.02em; }
  :lang(ar) .caps__title { font-style: normal; line-height: 1.3; }
  .caps__hint { max-inline-size: 22rem; font-size: 0.9rem; color: var(--muted); }

  .caps__projects { display: flex; flex-wrap: wrap; gap: 0.4rem 1.6rem; margin-block: 2.6rem 3rem; padding-block: 1rem; border-block: 1px solid var(--line); }
  .caps__projects button { position: relative; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); transition: color var(--dur-2); }
  .caps__projects button::before { content: ''; display: inline-block; inline-size: 0.55rem; block-size: 0.55rem; margin-inline-end: 0.5rem; border-radius: 1px; background: var(--hue); opacity: 0.35; rotate: 45deg; transition: opacity var(--dur-2); }
  .caps__projects button:hover, .caps__projects button:focus-visible, .caps__projects button[aria-pressed='true'], .caps__projects button.is-lit { color: var(--ink); }
  .caps__projects button:hover::before, .caps__projects button[aria-pressed='true']::before, .caps__projects button.is-lit::before { opacity: 1; }

  .caps__field { display: grid; gap: 2.6rem; }
  .caps__group { display: grid; grid-template-columns: minmax(10rem, 1fr) minmax(0, 4fr); gap: 1rem 3vw; align-items: baseline; }
  .caps__gname { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--rust); }
  :lang(ar) .caps__gname { letter-spacing: 0; text-transform: none; font-size: 0.9rem; }
  .caps__tools { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.1rem 1.1rem; }
  .tool { font-family: 'Cormorant Garamond', serif; line-height: 1.05; color: var(--ink); cursor: default; transition: opacity 0.45s var(--ease-out), color 0.45s var(--ease-out); }
  .tool[data-w='1'] { font-size: clamp(1.4rem, 1rem + 1vw, 2rem); color: var(--ink-2); }
  .tool[data-w='2'] { font-size: clamp(2rem, 1.2rem + 2vw, 3.4rem); font-style: italic; }
  .tool[data-w='3'] { font-size: clamp(2.8rem, 1.5rem + 3.4vw, 5.2rem); font-weight: 600; }
  /* focus on a project: everything it did not use steps back */
  .caps.is-focusing .tool:not(.is-on) { opacity: 0.12; }
  .caps.is-focusing .tool.is-on { color: var(--focus-hue, var(--ink)); }
  .caps__langs { margin-block-start: 3.5rem; font-size: 0.8rem; letter-spacing: 0.1em; color: var(--muted); }
  @media (max-width: 760px) { .caps__group { grid-template-columns: 1fr; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-caps]');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-proj]')];
    const tools = [...root.querySelectorAll<HTMLElement>('.tool')];
    let pinned: string | null = null;
    const focus = (slug: string | null) => {
      root.classList.toggle('is-focusing', !!slug);
      const b = buttons.find((x) => x.dataset.proj === slug);
      root.style.setProperty('--focus-hue', b ? getComputedStyle(b).getPropertyValue('--hue') : '');
      tools.forEach((t) => t.classList.toggle('is-on', !!slug && t.dataset.p!.split(' ').includes(slug)));
    };
    buttons.forEach((b) => {
      const slug = b.dataset.proj!;
      b.addEventListener('pointerenter', () => focus(slug));
      b.addEventListener('pointerleave', () => focus(pinned));
      b.addEventListener('focus', () => focus(slug));
      b.addEventListener('blur', () => focus(pinned));
      b.addEventListener('click', () => {
        pinned = pinned === slug ? null : slug;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.proj === pinned)));
        focus(pinned);
      });
    });
    tools.forEach((t) => {
      const used = t.dataset.p!.split(' ');
      t.addEventListener('pointerenter', () => buttons.forEach((b) => b.classList.toggle('is-lit', used.includes(b.dataset.proj!))));
      t.addEventListener('pointerleave', () => buttons.forEach((b) => b.classList.remove('is-lit')));
    });
  }
</script>
