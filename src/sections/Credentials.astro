---
// Credentials as the real documents: a sideways rail of certificate sheets, each opening
// full size in the lightbox. Filterable by group; drag, scroll or use the arrows.
import Brush from '../components/Brush.astro';
import { formatMonth, tr, asset, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { credentialGroups, credentialCount } from '../content/credentials';
import dims from '../data/certificate-dimensions.json';

interface Props { lang: Locale }
const { lang } = Astro.props;
const D = dims as unknown as Record<string, [number, number]>;
const items = credentialGroups.flatMap((g) => g.items.map((c) => ({ ...c, group: g.id })));
const tilt = [-1.6, 1.1, -0.6, 1.5, -1.2, 0.7];
---

<section id="credentials" class="section creds" aria-labelledby="creds-title" data-tone="light" data-chapter-name={tr(ui.nav.credentials, lang)}>
  <div class="wrap creds__head">
    <div class="section-head">
      <p class="kicker" data-reveal>{tr(ui.credentials.kicker, lang)}</p>
      <h2 id="creds-title" class="display" data-lines>{tr(ui.credentials.title, lang)}</h2>
    </div>
    <div class="creds__tools" data-reveal>
      <div class="creds__filters" role="group" aria-label={tr(ui.credentials.kicker, lang)}>
        <button type="button" data-filter="all" aria-pressed="true">{tr(ui.credentials.all, lang)} <span>{credentialCount}</span></button>
        {credentialGroups.map((g) => (
          <button type="button" data-filter={g.id} aria-pressed="false">{tr(g.name, lang)} <span>{g.items.length}</span></button>
        ))}
      </div>
      <div class="creds__arrows">
        <button class="ibtn ibtn--prev" type="button" data-rail-prev aria-label={tr(ui.work.prevItem, lang)}></button>
        <button class="ibtn ibtn--next" type="button" data-rail-next aria-label={tr(ui.work.nextItem, lang)}></button>
      </div>
    </div>
  </div>

  <div class="creds__rail" data-rail tabindex="0" aria-label={tr(ui.credentials.hint, lang)}>
    <ul class="creds__track">
      {items.map((c, i) => {
        const [w, h] = D[c.image] ?? [1800, 1200];
        const meta = `${c.issuer} · ${formatMonth(c.date, lang)}`;
        return (
          <li class="sheet" data-group={c.group} style={`--r:${tilt[i % tilt.length]}deg; --bob:${(i % 5) * -1.3}s`}>
            <button
              class="sheet__paper"
              type="button"
              data-lightbox
              data-group="certs"
              data-src={asset(`media/certificates/${c.image}.webp`)}
              data-title={c.title}
              data-meta={meta}
              data-verify={c.verify}
              aria-label={`${tr(ui.credentials.view, lang)}: ${c.title}`}
            >
              <img src={asset(`media/certificates/${c.image}-sm.webp`)} width={Math.round(w / 2.37)} height={Math.round(h / 2.37)} alt="" loading="lazy" decoding="async" draggable="false" />
            </button>
            <div class="sheet__cap">
              <p class="sheet__title" lang="en">{c.title}</p>
              <p class="label">{meta}</p>
              {c.highlight && <p class="sheet__hl">{tr(c.highlight, lang)}</p>}
              {c.verify && <a class="sheet__verify link-u" href={c.verify} target="_blank" rel="noopener" aria-label={`${tr(ui.credentials.verify, lang)}: ${c.title}`}>{tr(ui.credentials.verify, lang)} <span class="arrow" aria-hidden="true">↗</span></a>}
            </div>
          </li>
        );
      })}
    </ul>
  </div>

  <div class="wrap creds__foot">
    <div class="creds__progress" aria-hidden="true"><i data-rail-progress></i></div>
    <p class="label">{tr(ui.credentials.hint, lang)}</p>
  </div>
  <div class="wrap"><Brush seed={21} length={900} class="creds__stroke" /></div>
</section>

<style>
  .creds__head { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 1.5rem; }
  .creds__head .section-head { margin-block-end: 0; }
  .creds__tools { display: grid; justify-items: end; gap: 1rem; }
  .creds__filters { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.35rem; }
  /* filters: words with a count; the chosen one is underlined with the brush */
  .creds__filters button {
    position: relative;
    padding: 0.45rem 0.05rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color var(--dur-2);
  }
  :lang(ar) .creds__filters button { letter-spacing: 0; text-transform: none; font-size: 0.92rem; }
  .creds__filters button span { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.05rem; font-weight: 500; letter-spacing: 0; color: var(--rust); margin-inline-start: 0.3rem; }
  .creds__filters button::after {
    content: '';
    position: absolute;
    inset-inline: -0.2em;
    inset-block-end: -0.05rem;
    block-size: 0.5rem;
    background: var(--ink);
    -webkit-mask: url('/ink/under.png') center / 100% 100% no-repeat;
    mask: url('/ink/under.png') center / 100% 100% no-repeat;
    clip-path: inset(-50% 100% -50% 0);
    transition: clip-path 0.7s var(--ease-out);
  }
  [dir='rtl'] .creds__filters button::after { clip-path: inset(-50% 0 -50% 100%); }
  .creds__filters button:hover { color: var(--ink); }
  .creds__filters button[aria-pressed='true'] { color: var(--ink); }
  .creds__filters button[aria-pressed='true']::after { clip-path: inset(-50% 0 -50% 0); }
  .creds__arrows { display: flex; gap: 0.4rem; }

  .creds__rail {
    margin-block-start: clamp(2rem, 4vw, 3.5rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    cursor: grab;
    padding-block: 2rem 1rem;
  }
  /* on wide screens the rail stops short of the chapter scroll at the page edge (Nav), and the
     sheets fade into the paper before they reach it */
  @media (min-width: 1100px) and (min-height: 620px) {
    .creds__rail {
      margin-inline-end: calc(var(--rod-w) + 1.6rem);
      -webkit-mask-image: linear-gradient(to left, transparent, #000 3.5rem);
      mask-image: linear-gradient(to left, transparent, #000 3.5rem);
    }
    :global([dir='rtl']) .creds__rail {
      -webkit-mask-image: linear-gradient(to right, transparent, #000 3.5rem);
      mask-image: linear-gradient(to right, transparent, #000 3.5rem);
    }
  }
  .creds__rail::-webkit-scrollbar { display: none; }
  .creds__rail.is-dragging { cursor: grabbing; scroll-snap-type: none; }
  .creds__rail:focus-visible { outline-offset: -4px; }
  .creds__track {
    display: flex;
    align-items: flex-start;
    gap: clamp(1.4rem, 3vw, 2.8rem);
    inline-size: max-content;
    padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
  }
  .sheet { scroll-snap-align: start; display: grid; gap: 1rem; inline-size: max-content; max-inline-size: 30rem; }
  .sheet[hidden] { display: none; }
  .sheet__paper {
    display: block;
    border-radius: 3px;
    background: #fff;
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.9) inset, 0 22px 40px -22px rgb(40 36 30 / 0.55), 0 3px 8px -4px rgb(40 36 30 / 0.3);
    transform: rotate(var(--r));
    animation: sheet-float 7s ease-in-out infinite alternate;
    animation-delay: var(--bob);
    transition: box-shadow 0.5s var(--ease-out), transform 0.5s var(--ease-out);
  }
  .sheet__paper img { block-size: clamp(170px, 21vw, 260px); inline-size: auto; max-inline-size: none; border-radius: 3px; }
  @keyframes sheet-float {
    from { transform: translateY(-4px) rotate(var(--r)); }
    to { transform: translateY(5px) rotate(calc(var(--r) * -0.5)); }
  }
  .sheet__paper:hover, .sheet__paper:focus-visible {
    animation-play-state: paused;
    transform: translateY(-8px) rotate(0deg) scale(1.02);
    box-shadow: 0 34px 60px -26px rgb(40 36 30 / 0.6), 0 3px 8px -4px rgb(40 36 30 / 0.3);
  }
  .sheet__cap { display: grid; gap: 0.25rem; max-inline-size: 22rem; }
  .sheet__title { font-weight: 600; line-height: 1.3; }
  .sheet__hl { font-size: var(--step--1); color: var(--rust); }
  .sheet__verify { justify-self: start; font-size: var(--step--1); font-weight: 600; color: var(--rust); }

  .creds__foot { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-block-start: 1rem; }
  .creds__progress { flex: 1; block-size: 2px; background: var(--line); border-radius: 2px; overflow: hidden; max-inline-size: 28rem; }
  .creds__progress i { display: block; block-size: 100%; inline-size: 100%; background: var(--ink); transform-origin: left; transform: scaleX(var(--p, 0.1)); }
  [dir='rtl'] .creds__progress i { transform-origin: right; }
  .creds :global(.creds__stroke) { inline-size: 100%; block-size: 22px; margin-block-start: clamp(3rem, 6vw, 5rem); opacity: 0.8; }

  @media (max-width: 900px) {
    .creds__head { grid-template-columns: 1fr; }
    .creds__tools { justify-items: start; }
    .creds__filters { justify-content: flex-start; }
  }
</style>

<script>
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  if (rail) {
    const sheets = [...rail.querySelectorAll<HTMLElement>('.sheet')];
    const bar = document.querySelector<HTMLElement>('[data-rail-progress]')!;
    const rtl = document.dir === 'rtl';
    const progress = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      const p = max > 0 ? Math.abs(rail.scrollLeft) / max : 1;
      bar.style.setProperty('--p', String(Math.max(0.06, rail.clientWidth / rail.scrollWidth + p * (1 - rail.clientWidth / rail.scrollWidth))));
    };
    rail.addEventListener('scroll', progress, { passive: true });
    addEventListener('resize', progress);
    progress();

    // filters
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) =>
      b.addEventListener('click', () => {
        document.querySelectorAll('[data-filter]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        const f = b.dataset.filter;
        sheets.forEach((s) => (s.hidden = f !== 'all' && s.dataset.group !== f));
        rail.scrollTo({ left: 0, behavior: 'smooth' });
        requestAnimationFrame(progress);
      }),
    );

    // arrows
    const page = (dir: number) => rail.scrollBy({ left: dir * rail.clientWidth * 0.75 * (rtl ? -1 : 1), behavior: 'smooth' });
    document.querySelector('[data-rail-prev]')!.addEventListener('click', () => page(-1));
    document.querySelector('[data-rail-next]')!.addEventListener('click', () => page(1));

    // mouse drag-to-scroll (touch scrolls natively)
    let down = false, startX = 0, startLeft = 0, moved = 0;
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true; moved = 0; startX = e.clientX; startLeft = rail.scrollLeft;
    });
    addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      moved = Math.max(moved, Math.abs(dx));
      if (moved > 5) { rail.classList.add('is-dragging'); rail.scrollLeft = startLeft - dx; }
    });
    addEventListener('pointerup', () => { down = false; setTimeout(() => rail.classList.remove('is-dragging'), 0); });
    rail.addEventListener('click', (e) => { if (moved > 5) { e.stopPropagation(); e.preventDefault(); moved = 0; } }, true);
    rail.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); rail.scrollBy({ left: 320, behavior: 'smooth' }); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); rail.scrollBy({ left: -320, behavior: 'smooth' }); }
    });
  }
</script>
