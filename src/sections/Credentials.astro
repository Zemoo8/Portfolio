---
import { formatMonth, tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { credentialGroups } from '../content/credentials';

interface Props { lang: Locale }
const { lang } = Astro.props;
---

<section id="credentials" class="section creds wrap" aria-labelledby="creds-title">
  <header class="section-head">
    <p class="kicker" data-reveal>{tr(ui.credentials.kicker, lang)}</p>
    <h2 id="creds-title" class="display" data-lines>{tr(ui.credentials.title, lang)}</h2>
  </header>

  <div class="creds__groups">
    {credentialGroups.map((g) => (
      <section class="creds__group" aria-label={tr(g.name, lang)}>
        <h3 class="mono creds__name" data-reveal>{tr(g.name, lang)} <span>{String(g.items.length).padStart(2, '0')}</span></h3>
        <ul>
          {g.items.map((c, i) => (
            <li class:list={['cred', c.highlight && 'cred--feature']} data-reveal style={`--i:${i % 6}`}>
              <div class="cred__main">
                <p class="cred__title" lang="en">{c.title}</p>
                <p class="cred__issuer">{c.issuer}</p>
                {c.highlight && <p class="cred__hl">{tr(c.highlight, lang)}</p>}
              </div>
              <p class="cred__date mono"><span class="sr-only">{tr(ui.credentials.issued, lang)} </span><time datetime={c.date}>{formatMonth(c.date, lang)}</time></p>
              {c.verify ? (
                <a class="cred__verify mono link-u" href={c.verify} target="_blank" rel="noopener" aria-label={`${tr(ui.credentials.verify, lang)}: ${c.title}`}>
                  {tr(ui.credentials.verify, lang)} <span class="arrow" aria-hidden="true">↗</span>
                </a>
              ) : <span class="cred__verify" />}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</section>

<style>
  .creds__groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(var(--gutter) * 1.2); align-items: start; }
  .creds__name { display: flex; justify-content: space-between; padding-block-end: 1rem; border-block-end: 1px solid var(--line-strong); color: var(--paper); }
  .creds__name span { color: var(--signal); }
  .cred { display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'main date' 'main verify'; gap: 0.2rem 1rem; padding-block: 1.05rem; border-block-end: 1px solid var(--line); }
  .cred__main { grid-area: main; }
  .cred__date { grid-area: date; text-align: end; white-space: nowrap; }
  .cred__verify { grid-area: verify; justify-self: end; align-self: end; color: var(--paper-2); }
  .cred__title { font-size: var(--step-0); line-height: 1.3; }
  .cred__issuer { font-size: var(--step--1); color: var(--muted); margin-block-start: 0.2rem; }
  .cred--feature .cred__title { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.05; }
  .cred__hl { margin-block-start: 0.5rem; font-size: var(--step--1); color: var(--signal); }
  @media (max-width: 1100px) { .creds__groups { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) { .creds__groups { grid-template-columns: 1fr; } }
</style>
