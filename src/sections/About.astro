---
// About, as a photograph: the portrait large, making its own circle; the one sentence that says
// how he works crosses into the picture; the rest is quiet and small.
import Portrait from '../components/Portrait.astro';
import { tr, type Locale, type L } from '../i18n/config';
import { ui } from '../i18n/ui';
import { profile } from '../content/profile';

interface Props { lang: Locale }
const { lang } = Astro.props;
const heading: L = { en: 'I learn by shipping.', fr: 'J’apprends en livrant.', ar: 'أتعلّم بالإنجاز.' };
const now: L = {
  en: 'Licence (L3) in Computer Science & Multimedia, Université Sesame',
  fr: 'Licence (L3) Informatique & Multimédia, Université Sesame',
  ar: 'الإجازة (السنة الثالثة) في الإعلامية والملتيميديا، جامعة سيزام',
};
---

<section id="about" class="about" aria-labelledby="about-title" data-tone="light" data-chapter-name={tr(ui.nav.about, lang)}>
  <div class="about__photo"><Portrait lang={lang} /></div>
  <div class="about__text">
    <h2 id="about-title" class="about__title" data-lines>{tr(heading, lang)}</h2>
    <div class="about__body">
      {profile.about.map((para, i) => <p data-reveal style={`--i:${i}`}>{tr(para, lang)}</p>)}
    </div>
    <dl class="about__facts" data-reveal>
      <div><dt>{tr(ui.about.now, lang)}</dt><dd>{tr(now, lang)}</dd></div>
      <div><dt>{tr(ui.about.languages, lang)}</dt><dd>{profile.languages.map((l) => `${tr(l.name, lang)} (${tr(l.level, lang)})`).join(' · ')}</dd></div>
      <div><dt>{tr(ui.about.outside, lang)}</dt><dd>{profile.interests.map((x) => tr(x, lang)).join(' · ')}</dd></div>
    </dl>
  </div>
</section>

<style>
  .about {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    min-block-size: 100svh;
    padding: 7rem var(--gutter) 5rem;
    background: #f3ecdd;
    overflow: clip;
  }
  .about__photo { margin-inline-start: -8vw; }
  .about__photo :global(.portrait) { inline-size: min(58vw, 44rem); }
  .about__text { position: relative; z-index: 2; display: grid; gap: 2rem; padding-inline-start: 2vw; }
  .about__title {
    font-family: 'Cormorant Garamond', var(--font-display);
    font-size: clamp(3.4rem, 1.5rem + 7vw, 9rem);
    font-weight: 500;
    font-style: italic;
    line-height: 0.88;
    letter-spacing: -0.03em;
    max-inline-size: 11ch;
    margin-inline-start: -13vw; /* the sentence crosses into the photograph */
  }
  :lang(ar) .about__title { font-family: var(--font-arabic-display); font-style: normal; line-height: 1.3; max-inline-size: 9ch; }
  .about__body { display: grid; gap: 1rem; max-inline-size: 30rem; font-size: 1.05rem; line-height: 1.65; color: var(--ink-2); }
  :lang(ar) .about__body { line-height: 1.95; }
  .about__facts { display: grid; gap: 0.9rem; max-inline-size: 30rem; font-size: 0.9rem; }
  .about__facts dt { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--rust); }
  :lang(ar) .about__facts dt { letter-spacing: 0; font-size: 0.85rem; }
  .about__facts dd { color: var(--ink-2); }
  @media (max-width: 900px) {
    .about { grid-template-columns: 1fr; padding-block: 5rem 4rem; }
    .about__photo { margin-inline: -12vw 0; }
    .about__photo :global(.portrait) { inline-size: 100vw; }
    .about__text { margin: -18vw 0 0; }
    .about__title { margin-inline-start: 0; }
  }
</style>
