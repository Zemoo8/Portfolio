---
// About, as an album lying open: two leaves in one frame of black lacquer and brocade, as the
// folding screen's leaves are framed. On the left leaf, gold leaf with a bough of the screen's pine
// (public/art/screen.webp), the portrait in its moon window; on the right, paper, the words.
// What is true of him now is set out along the foot of the page as three slips, and the languages
// he speaks are seals cut in outline, as the tools are in the Capabilities chapter.
// It arrives closed and opens from the spine (transform only).
import Portrait from '../components/Portrait.astro';
import { tr, type Locale, type L } from '../i18n/config';
import { ui } from '../i18n/ui';
import { profile } from '../content/profile';

interface Props { lang: Locale }
const { lang } = Astro.props;
const heading: L = { en: 'I learn by shipping.', fr: 'J’apprends en livrant.', ar: 'أتعلّم بالإنجاز.' };
// Ahmed's motto, in his own words
const motto: L = {
  en: 'Nothing is gained without giving something of equal worth — so I work hard, and earn the right to play hard.',
  fr: 'Rien ne s’obtient sans donner quelque chose d’égale valeur — alors je travaille dur, pour mériter de profiter pleinement.',
  ar: 'لا شيء يُنال دون أن تُقدِّم ما يعادله قيمةً — لذلك أعمل بجدّ، لأستحقّ أن أستمتع بجدّ.',
};
const now: L = {
  en: 'Licence (L3) in Computer Science & Multimedia, Université Sesame',
  fr: 'Licence (L3) Informatique & Multimédia, Université Sesame',
  ar: 'الإجازة (السنة الثالثة) في الإعلامية والملتيميديا، جامعة سيزام',
};
---

<section id="about" class="section wrap" aria-labelledby="about-title" data-tone="light" data-chapter-name={tr(ui.nav.about, lang)}>
  <div class="album" data-reveal-brush>
    <div class="album__leaf album__leaf--gold">
      <Portrait lang={lang} />
      <p class="album__motto">{tr(motto, lang)}</p>
    </div>

    <div class="album__leaf album__leaf--paper">
      <p class="kicker" data-reveal>{tr(ui.about.kicker, lang)}</p>
      <h2 id="about-title" class="display about__title" data-lines>{tr(heading, lang)}</h2>
      <div class="about__body">
        {profile.about.map((para, i) => <p data-reveal style={`--i:${i}`}>{tr(para, lang)}</p>)}
      </div>

      <dl class="slips">
        <div data-reveal>
          <dt class="label">{tr(ui.about.now, lang)}</dt>
          <dd>{tr(now, lang)}</dd>
        </div>
        <div data-reveal style="--i:1">
          <dt class="label">{tr(ui.about.languages, lang)}</dt>
          <dd>
            <ul class="tongues">
              {profile.languages.map((l, k) => <li><span class="cut" style={`--r:${[-0.6, 0.5, -0.3][k % 3]}deg`}>{tr(l.name, lang)}</span><span class="label">{tr(l.level, lang)}</span></li>)}
            </ul>
          </dd>
        </div>
        <div data-reveal style="--i:2">
          <dt class="label">{tr(ui.about.outside, lang)}</dt>
          <dd>{profile.interests.map((x) => tr(x, lang)).join(' · ')}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  /* ---- the album ---- */
  .album { position: relative; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  .album::after {
    /* its shadow on the table */
    content: '';
    position: absolute;
    z-index: -1;
    inset-inline: 2%;
    inset-block-start: calc(100% - 0.3rem);
    block-size: 2.2rem;
    background: radial-gradient(50% 100% at 50% 0%, rgb(40 32 18 / 0.34), rgb(40 32 18 / 0));
  }
  .album__leaf {
    position: relative;
    padding: clamp(2rem, 1rem + 3.4vw, 4.2rem) clamp(1.4rem, 0.6rem + 2.8vw, 3.6rem);
    /* black lacquer, then a line of brocade, round each leaf */
    box-shadow: inset 0 0 0 3px #17130e, inset 0 0 0 5px rgb(120 90 34 / 0.9);
  }
  .album__leaf--gold {
    display: grid;
    align-content: center;
    gap: clamp(1.4rem, 3vw, 2.4rem);
    color: #1b150c;
    background: #d8b25e url('/art/screen.webp') 12% 8% / 250% auto;
  }
  .album__leaf--gold::after {
    /* the leaf turns down into the spine */
    content: '';
    position: absolute;
    inset-block: 5px;
    inset-inline-end: 5px;
    inline-size: 2.4rem;
    background: linear-gradient(90deg, rgb(52 34 6 / 0), rgb(52 34 6 / 0.3));
    pointer-events: none;
  }
  :global([dir='rtl']) .album__leaf--gold::after { scale: -1 1; }
  .album__leaf--paper {
    background: var(--paper-grain), linear-gradient(90deg, #ece3cd, #f9f4e6 8%, #f6f0e1);
  }
  :global([dir='rtl']) .album__leaf--paper { background: var(--paper-grain), linear-gradient(-90deg, #ece3cd, #f9f4e6 8%, #f6f0e1); }

  /* the motto, written on the gold under the portrait: ink on a cloud of brighter gold */
  .album__motto {
    justify-self: center;
    max-inline-size: 24rem;
    padding: 0.9rem 1.2rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.32;
    text-align: center;
    background: radial-gradient(closest-side, rgb(240 214 146 / 0.95), rgb(236 206 134 / 0.9) 70%, rgb(236 206 134 / 0));
  }
  :lang(ar) .album__motto { font-style: normal; line-height: 1.8; }

  .about__title { font-size: var(--step-5); margin-block: 1.1rem 1.8rem; }
  .about__body { display: grid; gap: 1.05rem; font-size: var(--step-1); line-height: 1.6; color: var(--ink-2); max-inline-size: 40rem; }
  :lang(ar) .about__body { line-height: 1.95; }

  /* ---- three slips along the foot ---- */
  .slips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-block-start: 2.6rem; }
  .slips > div {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 0.9rem 0.95rem 1rem;
    background: rgb(255 252 242 / 0.7);
    border-block-start: 3px solid var(--seal);
    box-shadow: 0 10px 20px -14px rgb(40 30 10 / 0.5), 0 0 0 1px rgb(31 29 26 / 0.07);
  }
  .slips dd { font-size: 0.95rem; line-height: 1.45; }
  .tongues { display: grid; gap: 0.5rem; }
  .tongues li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.6rem; }
  /* a seal cut in outline: the letters and the frame take the ink, the ground stays paper */
  .cut { padding: 0.28em 0.6em 0.22em; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.03em; line-height: 1.15; color: var(--seal); border: 1.6px solid var(--seal); border-radius: 3px 4px 3px 5px; rotate: var(--r); }
  :lang(ar) .cut { letter-spacing: 0; font-size: 0.9rem; }

  /* ---- arriving: the album opens from its spine ---- */
  .album__leaf--gold { transform-origin: 100% 50%; }
  .album__leaf--paper { transform-origin: 0 50%; }
  :global([dir='rtl']) .album__leaf--gold { transform-origin: 0 50%; }
  :global([dir='rtl']) .album__leaf--paper { transform-origin: 100% 50%; }
  :global(.js) .album:not(:global(.is-in)) .album__leaf { transform: scaleX(0.04); opacity: 0; }
  :global(.js) .album:global(.is-in) .album__leaf { transition: transform 1.2s cubic-bezier(0.65, 0, 0.2, 1), opacity 0.35s linear; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .album:not(:global(.is-in)) .album__leaf { transform: none; opacity: 1; }
  }
  :global(.motion-off) .album .album__leaf.album__leaf { transform: none; opacity: 1; transition: none; }

  @media (max-width: 1100px) {
    .slips { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 900px) {
    .album { grid-template-columns: minmax(0, 1fr); }
    .album__leaf--gold, .album__leaf--paper { transform-origin: 50% 0; }
    .album__leaf--gold::after { display: none; }
  }
</style>
