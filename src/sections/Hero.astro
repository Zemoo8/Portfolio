---
// The name is the hero. The photograph is the "o" in Baghouli (in Arabic, which has no o, it
// stands before the surname) — the circle comes from the picture itself, and the head breaks
// out of it. Scrolling lifts the o out of the word and carries it into the introduction scene
// (scripts/travel.ts). Everything else is quiet: one sentence, one way in, a lot of paper.
import { asset, tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { profile } from '../content/profile';

interface Props { lang: Locale }
const { lang } = Astro.props;
const first = tr(profile.firstName, lang);
const last = tr(profile.lastName, lang);
const oAt = last.indexOf('o');
const [before, after] = oAt > -1 ? [last.slice(0, oAt), last.slice(oAt + 1)] : ['', last];
// one sentence: the statement up to its dash
const sentence = tr(profile.statement, lang).split(/\s[—–-]\s/)[0].replace(/[.،]?$/, lang === 'ar' ? '.' : '.');
---

<section class="hero" aria-labelledby="hero-name" data-tone="light" data-chapter-name="">
  <h1 id="hero-name" class="hero__name">
    <span class="hero__first line-mask" data-onload><span>{first}</span></span>
    <span class="hero__last line-mask" data-onload style="--i:1">
      <span>
        {before}<span class="hero__o" data-o>
          <span class="hero__disc"><img src={asset('art/gate.webp')} alt="" width="900" height="900" fetchpriority="high" /></span>
          <span class="hero__pop">
            <img class="hero__ink" src={asset('media/profile/portrait-ink.webp')} srcset={`${asset('media/profile/portrait-ink.webp')} 432w, ${asset('media/profile/portrait-ink@2x.webp')} 864w`} sizes="18vw" alt="" width="432" height="577" fetchpriority="high" />
            <img class="hero__color" src={asset('media/profile/portrait-color.webp')} srcset={`${asset('media/profile/portrait-color.webp')} 432w, ${asset('media/profile/portrait-color@2x.webp')} 864w`} sizes="18vw" alt="" width="432" height="577" loading="lazy" />
          </span>
          {oAt > -1 && <span class="sr-only">o</span>}
        </span>{after}
      </span>
    </span>
  </h1>

  <div class="hero__foot">
    <p class="hero__role">{tr(profile.role, lang)}<br />{tr(ui.hero.based, lang)}</p>
    <div class="hero__say">
      <p class="hero__statement">{sentence}</p>
      <a class="hero__onote" href="#intro">{tr(ui.hero.oNote, lang)}</a>
    </div>
    <a class="arrow-link" href="#work">{tr(ui.hero.see, lang)} <i aria-hidden="true"></i></a>
  </div>
  <img class="hero__horizon" src={asset('art/near-1000.webp')} srcset={`${asset('art/near-1000.webp')} 1000w, ${asset('art/near.webp')} 2000w`} sizes="100vw" alt="" width="2000" height="1250" aria-hidden="true" />
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-block-size: 100svh;
    padding: 6rem var(--gutter) 2.4rem;
    overflow: clip;
    background: radial-gradient(120% 80% at 70% 15%, #fbf8ef, var(--paper) 55%, #ebe4d2);
  }
  .hero__name {
    position: relative;
    z-index: 2;
    isolation: isolate;
    align-self: center;
    font-family: 'Cormorant Garamond', var(--font-display);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.035em;
  }
  .hero__name .line-mask { overflow: visible; padding: 0; margin: 0; }
  .hero__first { display: block; font-size: clamp(3.4rem, 9.5vw, 11rem); font-weight: 600; letter-spacing: -0.02em; padding-inline-start: 0.06em; }
  .hero__last { display: block; font-size: clamp(5.5rem, 25vw, 29rem); font-style: italic; margin-inline-start: -0.05em; white-space: nowrap; }
  :lang(ar) .hero__name { font-family: var(--font-arabic-display); line-height: 1.15; letter-spacing: 0; }
  :lang(ar) .hero__first { font-size: clamp(3.2rem, 9vw, 9rem); }
  :lang(ar) .hero__last { font-size: clamp(4.5rem, 17vw, 17rem); font-style: normal; }

  /* the o: a circle of painting with the portrait standing in it, head above the rim */
  .hero__o {
    position: relative;
    display: inline-block;
    inline-size: 0.66em;
    block-size: 0.66em;
    margin-inline: 0.01em 0.02em;
    vertical-align: -0.05em;
    cursor: pointer;
    transition: scale 0.8s var(--ease-out);
  }
  :lang(ar) .hero__o { inline-size: 0.8em; block-size: 0.8em; margin-inline: 0 0.12em; vertical-align: -0.12em; }
  .hero__o:hover { scale: 1.04; }
  .hero__disc { position: absolute; inset: 0; border-radius: 50%; overflow: hidden; background: #e9e4d6; }
  .hero__disc img { inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 50% 62%; opacity: 0.85; }
  .hero__pop { position: absolute; inset: 0; clip-path: url(#pop); }
  .hero__pop img { position: absolute; inset-inline-start: -2%; inline-size: 104%; max-inline-size: none; bottom: -16%; block-size: auto; }
  .hero__color { opacity: 0; transition: opacity 1s var(--ease-out); }
  .hero__o:hover .hero__color { opacity: 1; }
  :global(.o-travelling) .hero__o { visibility: hidden; }

  .hero__foot { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr) auto; gap: 2rem 3vw; align-items: end; }
  .hero__role { font-size: 0.74rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; line-height: 1.9; color: var(--muted); }
  :lang(ar) .hero__role { letter-spacing: 0; text-transform: none; font-size: 0.9rem; }
  .hero__say { display: grid; gap: 0.7rem; }
  .hero__statement { font-family: var(--font-display); font-size: clamp(1.25rem, 1rem + 0.8vw, 1.7rem); line-height: 1.25; max-inline-size: 30rem; color: var(--ink); }
  :lang(ar) .hero__statement { line-height: 1.7; font-size: 1.2rem; }
  .hero__onote { justify-self: start; font-family: var(--font-display); font-style: italic; font-size: 1rem; color: var(--rust); }
  .hero__onote::before { content: '↳ '; font-style: normal; }
  [dir='rtl'] .hero__onote::before { content: '↲ '; }
  .hero__horizon { position: absolute; inset-inline: 0; inset-block-end: -10vh; inline-size: 100%; block-size: auto; opacity: 0.32; pointer-events: none; z-index: 0; }

  @media (max-width: 760px) {
    .hero { padding-block: 5rem 2rem; }
    .hero__first { font-size: 16vw; }
    .hero__last { font-size: 27vw; }
    :lang(ar) .hero__last { font-size: 22vw; }
    .hero__foot { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { initTravel } from '../scripts/travel';
  initTravel();
</script>
