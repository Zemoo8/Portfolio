---
import IntroFilm from '../components/IntroFilm.astro';
import Brush from '../components/Brush.astro';
import { tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { profile } from '../content/profile';

interface Props { lang: Locale }
const { lang } = Astro.props;
---

<section class="hero wrap" aria-labelledby="hero-name" data-tone="dark" data-chapter-name="">
  {/* the page opens on a hanging scroll of the same night as the Path and the last chapter:
      black silk between two rollers, gold for everything on it, the far country along its foot */}
  <div class="hero__silk" aria-hidden="true">
    <span class="hero__rod"></span>
    <span class="hero__land hero__land--peaks"></span>
    <span class="hero__land hero__land--rocks"></span>
    <span class="hero__land hero__land--pine"></span>
    <span class="hero__rod hero__rod--foot"></span>
  </div>
  <div class="hero__text">
    <p class="kicker">{tr(profile.role, lang)}</p>

    <h1 id="hero-name" class="hero__name display">
      <span class="line-mask" data-onload><span>{tr(profile.firstName, lang)}</span></span>
      <span class="line-mask hero__last" data-onload style="--i:1">
        <span><em>{tr(profile.lastName, lang)}</em></span>
      </span>
    </h1>

    <Brush seed={11} length={520} class="hero__stroke" color="var(--gold)" />

    <p class="hero__statement">{tr(profile.statement, lang)}</p>

    <div class="hero__cta">
      <a class="btn" href="#work">{tr(ui.hero.enter, lang)} <span aria-hidden="true">↓</span></a>
      <a class="btn btn--ghost" href="#contact">{tr(ui.hero.contact, lang)}</a>
    </div>
    <p class="label hero__loc">{tr(ui.hero.based, lang)}</p>
  </div>

  <div class="hero__gate">
    <IntroFilm lang={lang} />
  </div>

  <a class="hero__scroll label" href="#work" aria-hidden="true" tabindex="-1">
    <span>{tr(ui.hero.scroll, lang)}</span>
    <i></i>
  </a>
</section>

<style>
  .hero {
    /* the night's palette, for everything on the scroll */
    --gold: #f0d7a1;
    --ink: #f3eee2;
    --ink-2: #d6d3c8;
    --muted: #a5a399;
    --rust: var(--gold);
    --seal: var(--gold);
    --line: rgb(240 215 161 / 0.2);
    --line-strong: rgb(240 215 161 / 0.42);
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: calc(var(--gutter) * 1.5);
    min-block-size: 100svh;
    padding-block: clamp(4.75rem, 9.5vh, 7.5rem) 4.6rem;
    /* (--end: the room the page leaves at its far edge — on wide screens, for the chapter scroll
       that hangs there: see .wrap in global.css. The silk stops short of it, as every chapter does) */
    --end: var(--gutter);
    --over: calc(var(--gutter) * 0.6); /* how far past the text the silk reaches on that side */
    padding-inline: calc(var(--gutter) + clamp(0.6rem, 2.4vw, 3rem)) calc(var(--end) + clamp(0.6rem, 2.4vw, 3rem));
    color: var(--ink);
    overflow-x: clip; /* the rollers stand proud of the silk: on a phone, not past the screen's edge */
  }
  .hero__silk {
    position: absolute;
    z-index: -1;
    inset-block: 0.8rem 1.5rem;
    inset-inline: calc(var(--gutter) * 0.4) calc(var(--end) - var(--over));
    background: radial-gradient(80% 70% at 72% 40%, #26221b, #121110 72%);
    box-shadow: inset 0 0 0 1px rgb(240 215 161 / 0.13), 0 34px 60px -40px rgb(20 18 14 / 0.8);
  }
  .hero__silk::before {
    /* the mounting: a hairline of gold silk a little inside the edge */
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid rgb(240 215 161 / 0.2);
  }
  .hero__rod {
    position: absolute;
    inset-inline: -0.7rem;
    inset-block-start: -0.5rem;
    block-size: 1rem;
    background: #24211c;
    -webkit-mask: url('/ink/roller.png') center / 100% 100% no-repeat;
    mask: url('/ink/roller.png') center / 100% 100% no-repeat;
  }
  .hero__rod--foot { inset-block-start: auto; inset-block-end: -0.55rem; block-size: 1.1rem; inset-inline: -0.9rem; }
  /* the far country, in the gold of the road (scripts/art/road-marks.mjs), faint along the foot */
  .hero__land { position: absolute; inset-block-end: 9px; background: center bottom / contain no-repeat; opacity: 0.2; }
  .hero__land--peaks { inset-inline-start: 3%; inline-size: clamp(7rem, 13vw, 13rem); aspect-ratio: 400 / 424; background-image: url('/art/road-peaks.png'); }
  .hero__land--rocks { inset-inline-end: 4%; inline-size: clamp(9rem, 17vw, 17rem); aspect-ratio: 400 / 424; background-image: url('/art/road-rocks.png'); }
  .hero__land--pine { inset-inline-end: 21%; inline-size: clamp(5rem, 9vw, 9rem); aspect-ratio: 400 / 420; background-image: url('/art/road-pine.png'); }
  .hero__text { position: relative; display: grid; gap: 1.4rem; justify-items: start; }
  /* on the dark silk the buttons are strokes of gold, lettered in ink */
  .hero :global(.btn) { --btn-ink: var(--gold); color: #1a150d; }
  .hero :global(.btn:hover), .hero :global(.btn:focus-visible) { --btn-ink: #fff1cc; }
  .hero :global(.btn--ghost) { color: var(--ink); }
  .hero :global(.btn--ghost:hover), .hero :global(.btn--ghost:focus-visible) { color: var(--gold); }
  .hero__name {
    font-size: clamp(4rem, min(1.4rem + 9.6vw, 1rem + 19.5vh), 12.5rem);
    font-weight: 600;
    line-height: 0.86;
    letter-spacing: -0.03em;
    margin-inline-start: -0.04em;
  }
  :lang(ar) .hero__name { font-size: clamp(3.6rem, 1.4rem + 8vw, 10rem); line-height: 1.2; letter-spacing: 0; }
  .hero__name .line-mask > span { display: block; }
  .hero__last > span { display: flex !important; align-items: center; gap: 0.18em; padding-inline-start: 0.55em; }
  .hero__last em { font-weight: 500; color: var(--gold); }
  :lang(ar) .hero__last em { color: var(--gold); font-weight: 500; }
  .hero :global(.hero__stroke) { inline-size: min(100%, 30rem); block-size: 22px; margin-block: -0.4rem 0.2rem; }
  .hero__statement { font-size: var(--step-1); line-height: 1.55; max-inline-size: 34rem; color: var(--ink-2); }
  :lang(ar) .hero__statement { line-height: 1.95; }
  .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem 2rem; margin-block-start: 0.6rem; }
  .hero__loc { margin-block-start: 0.2rem; }

  .hero__scroll {
    position: absolute;
    inset-block-end: 1.6rem;
    inset-inline-start: 50%;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
  }
  [dir='rtl'] .hero__scroll { translate: 50% 0; }
  .hero__scroll i { position: relative; inline-size: 1.5px; block-size: 2.6rem; background: var(--line-strong); overflow: hidden; border-radius: 2px; }
  .hero__scroll i::after { content: ''; position: absolute; inset-inline: 0; block-size: 45%; background: var(--ink); animation: drip 2.4s var(--ease-in-out) infinite; }
  @keyframes drip { from { transform: translateY(-100%); } to { transform: translateY(240%); } }

  @media (min-width: 1100px) and (min-height: 620px) {
    /* (beside the chapter scroll the silk reaches only a little past the text) */
    .hero { --end: max(var(--gutter), calc(var(--rod-w) + 2.2rem - (100vw - var(--max)) / 2)); --over: 0.5rem; }
  }
  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; padding-block: 6rem 4.4rem; min-block-size: auto; }
    .hero__land--pine { display: none; }
    .hero__gate { order: 2; }
    .hero__last > span { padding-inline-start: 0.35em; }
    .hero__scroll { display: none; }
  }
</style>
