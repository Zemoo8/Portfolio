---
// The storm chapter: projects orbiting the air element. Real media on every card.
import Emblem from '../components/Emblem.astro';
import { path, tr, asset, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { projects } from '../content/projects';
import { film, still } from '../lib/media';

interface Props { lang: Locale }
const { lang } = Astro.props;

const cards = projects.map((p) => {
  const f = film(p.film?.desktop);
  const s = still(p.cover.src);
  // cards are small: use the half-size poster / still
  const poster = f?.poster ? f.poster.replace('-poster.webp', '-poster-sm.webp') : s.src.replace(/\.webp$/, '-sm.webp');
  return {
    p,
    href: path(lang, `work/${p.slug}`),
    poster,
    contain: p.cover.kind === 'figure' && !f,
    // the orbit plays the small version; cards are ≤ 480 CSS px wide
    film: f ? JSON.stringify({ mp4: f.card ?? f.mp4 }) : undefined,
  };
});
---

<section id="work" class="storm" aria-labelledby="work-title" data-storm>
  <div class="storm__bg" aria-hidden="true">
    <canvas class="storm__canvas" data-vortex></canvas>
  </div>

  <header class="storm__head wrap">
    <p class="kicker">{tr(ui.work.kicker, lang)}</p>
    <h2 id="work-title" class="display" data-lines>{tr(ui.work.title, lang)}</h2>
  </header>

  <div class="orbit" data-orbit>
    <div class="orbit__stage" data-orbit-stage>
      <div class="orbit__ring">
        <div class="orbit__core" aria-hidden="true"><Emblem spin /></div>
        {cards.map(({ p, href, poster, contain, film: fl }) => (
          <a
            class="orbit__card"
            href={href}
            data-orbit-card
            data-index={p.index}
            data-title={p.title}
            data-category={tr(p.category, lang)}
            data-year={p.year}
            data-tagline={tr(p.tagline, lang)}
            data-tone={p.tone}
            data-orbit-film={fl}
            style={`--tone:${p.tone}`}
          >
            <span class="orbit__mat">
              <span class:list={['orbit__media', contain && 'orbit__media--figure']}>
                <img src={poster} alt="" loading="lazy" decoding="async" draggable="false" />
              </span>
            </span>
            <span class="orbit__label"><span class="orbit__num">{p.index}</span> {p.title}<span class="sr-only"> — {tr(p.tagline, lang)}</span></span>
          </a>
        ))}
      </div>
    </div>

    <div class="orbit__below wrap">
      <div class="orbit__caption" data-orbit-caption data-orbit-live aria-live="off">
        <span class="orbit__big" data-cap="index" aria-hidden="true"></span>
        <p class="orbit__meta"><span data-cap="category"></span><span data-cap="year"></span></p>
        <p class="orbit__title display" data-cap="title"></p>
        <p class="orbit__tagline" data-cap="tagline"></p>
        <a class="btn btn--cloud" data-cap="link" data-label={tr(ui.work.open, lang)} href={cards[0].href}>{tr(ui.work.open, lang)} <span class="arrow" aria-hidden="true">→</span></a>
      </div>

      <div class="orbit__controls">
        <div class="orbit__steer">
          <button class="ibtn ibtn--prev" type="button" data-orbit-prev aria-label={tr(ui.work.prev, lang)}></button>
          <p class="orbit__count" aria-hidden="true"><span data-cap="index"></span><span class="orbit__of">/ {String(cards.length).padStart(2, '0')}</span></p>
          <button class="ibtn ibtn--next" type="button" data-orbit-next aria-label={tr(ui.work.next, lang)}></button>
        </div>
        <ol class="orbit__index">
          {cards.map(({ p }, i) => (
            <li>
              <button type="button" data-orbit-dot aria-current={i === 0 ? 'true' : 'false'}>
                <span class="orbit__station-num">{p.index}</span>
                <span class="orbit__station-name">{p.title}</span>
              </button>
            </li>
          ))}
        </ol>
        <div class="orbit__foot">
          <button class="orbit__pause" type="button" data-orbit-pause aria-pressed="false">{tr(ui.work.orbitPause, lang)}</button>
          <p class="orbit__hint">{tr(ui.work.drag, lang)}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .storm {
    position: relative;
    margin-block-start: clamp(3rem, 8vh, 6rem);
    padding-block: clamp(6rem, 13vh, 9rem) clamp(6rem, 14vh, 10rem);
    color: var(--cloud);
    background-color: var(--storm); /* solid ink ground: text contrast never depends on the canvas */
    isolation: isolate;
    overflow-x: clip; /* 3D cards near the edges must not widen the page */
  }
  /* soft transitions from the painted daylight into the storm and back */
  .storm::before, .storm::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    block-size: clamp(90px, 16vh, 180px);
    pointer-events: none;
  }
  .storm::before { inset-block-end: 100%; background: linear-gradient(180deg, rgb(18 20 19 / 0), rgb(18 20 19 / 0.55) 60%, var(--storm)); }
  .storm::after { inset-block-start: 100%; background: linear-gradient(0deg, rgb(18 20 19 / 0), rgb(18 20 19 / 0.55) 60%, var(--storm)); }
  .storm__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(60% 55% at 50% 50%, var(--storm-2), var(--storm) 70%);
  }
  .storm__canvas { opacity: 0; transition: opacity 1.2s var(--ease-out); }
  .storm__canvas:global(.is-ready) { opacity: 1; }
  .storm__canvas { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; }
  .storm__head { display: grid; gap: 1rem; justify-items: center; text-align: center; }
  .storm__head .kicker { color: #e9a86a; }
  .storm__head h2 { font-size: var(--step-4); max-inline-size: 22ch; }

  /* ---- stage ---- */
  .orbit__stage {
    position: relative;
    block-size: clamp(420px, 60vh, 680px);
    perspective: 1800px;
    perspective-origin: 50% 30%;
    touch-action: pan-y;
    user-select: none;
    cursor: grab;
  }
  .orbit__stage:active { cursor: grabbing; }
  .orbit__ring { position: absolute; inset: 0; transform-style: preserve-3d; }
  .orbit__core {
    position: absolute;
    top: 50%;
    left: 50%;
    inline-size: clamp(110px, 13vw, 190px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%) translateZ(0);
    color: #f3f5f2;
    filter: drop-shadow(0 0 22px rgb(236 244 240 / 0.45));
    pointer-events: none;
  }
  .orbit__core :global(.emblem) { inline-size: 100%; block-size: 100%; }

  .orbit__card {
    --card-w: clamp(170px, 19vw, 320px);
    position: absolute;
    top: 50%;
    left: 50%;
    inline-size: var(--card-w);
    display: grid;
    gap: 0.55rem;
    justify-items: center;
    will-change: transform;
    -webkit-tap-highlight-color: transparent;
  }
  .orbit__mat {
    position: relative;
    display: block;
    inline-size: 100%;
    padding: 0.45rem;
    border-radius: 12px;
    background: var(--paper-grain), #f7f2e5;
    box-shadow: 0 30px 50px -24px rgb(0 0 0 / 0.75), 0 0 0 1px rgb(255 255 255 / 0.2) inset;
  }
  .orbit__mat::after {
    /* recedes into ink toward the back of the orbit */
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #0f1110;
    opacity: calc((1 - var(--f, 1)) * 0.62);
    pointer-events: none;
    transition: opacity 0.2s;
  }
  .orbit__media { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 7px; background: #1b1d1c; }
  .orbit__media img, .orbit__media :global(video) { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }
  .orbit__media--figure { background: #fbfaf6; }
  .orbit__media--figure img { object-fit: contain; }
  .orbit__media :global(video) { opacity: 0; transition: opacity 0.6s var(--ease-out); }
  .orbit__media :global(video.is-playing) { opacity: 1; }
  .orbit__label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.8rem + 0.6vw, 1.35rem);
    font-weight: 600;
    color: var(--cloud);
    opacity: calc(0.25 + var(--f, 1) * 0.75);
    white-space: nowrap;
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.6);
  }
  .orbit__num { font-family: var(--font-sans); font-size: 0.7em; font-weight: 600; color: #e9a86a; letter-spacing: 0.08em; }
  .orbit__card[data-active] .orbit__mat { box-shadow: 0 0 0 2px #e9a86a, 0 34px 60px -24px rgb(0 0 0 / 0.8); }
  .orbit__card:focus-visible { outline: none; }
  .orbit__card:focus-visible .orbit__mat { outline: 2px solid var(--amber); outline-offset: 4px; }

  /* ---- below ---- */
  .orbit__below { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: calc(var(--gutter) * 1.5); align-items: end; margin-block-start: clamp(1rem, 3vh, 2.5rem); }

  /* caption: a chapter plate — the project number stands behind the title in outline */
  .orbit__caption { position: relative; isolation: isolate; display: grid; gap: 0.8rem; justify-items: start; padding-block-start: clamp(2.5rem, 6vw, 5rem); opacity: 0; transform: translateY(8px); transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out); }
  .orbit__caption.is-shown { opacity: 1; transform: none; }
  .orbit__big {
    position: absolute;
    inset-block-start: -0.42em;
    inset-inline-start: -0.08em;
    z-index: -1;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(8rem, 5rem + 12vw, 17rem);
    font-weight: 500;
    font-style: italic;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px rgb(233 168 106 / 0.32);
    pointer-events: none;
    user-select: none;
  }
  .orbit__meta { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: #b9c2bf; }
  :lang(ar) .orbit__meta { letter-spacing: 0; text-transform: none; font-size: 0.9rem; }
  .orbit__meta span + span::before { content: ''; display: inline-block; inline-size: 1.4em; block-size: 0.45em; margin-inline-end: 0.9rem; background: #e9a86a; -webkit-mask: url('/ink/dash.png') center / 100% 100% no-repeat; mask: url('/ink/dash.png') center / 100% 100% no-repeat; }
  .orbit__title { font-size: var(--step-4); line-height: 0.95; }
  .orbit__tagline { font-family: var(--font-display); font-style: italic; font-size: var(--step-2); color: #d3dad7; max-inline-size: 30rem; line-height: 1.25; }
  :lang(ar) .orbit__tagline { font-style: normal; font-size: var(--step-1); line-height: 1.7; }
  /* on the storm the swash is a stroke of cloud-white */
  :global(.btn--cloud) { --btn-ink: var(--cloud); color: var(--ink); margin-block-start: 0.6rem; }
  :global(.btn--cloud:hover), :global(.btn--cloud:focus-visible) { --btn-ink: #e9a86a; }

  /* steering: brush arrows around a counter */
  .orbit__controls { display: grid; gap: 1.6rem; justify-items: end; }
  .orbit__steer { display: flex; align-items: center; gap: 0.8rem; color: var(--cloud); }
  .orbit__steer .ibtn:hover { color: #e9a86a; }
  .orbit__count { display: flex; align-items: baseline; gap: 0.35rem; font-family: 'Cormorant Garamond', serif; font-size: 2.2rem; line-height: 1; color: var(--cloud); direction: ltr; }
  .orbit__of { font-size: 1.05rem; font-style: italic; color: #8e9894; }

  /* stations: the ring's six projects as an index; the one in front gets the brush */
  .orbit__index { display: grid; gap: 0.15rem; min-inline-size: min(100%, 19rem); }
  .orbit__index button { position: relative; display: flex; align-items: baseline; gap: 0.9rem; inline-size: 100%; padding: 0.42rem 0.1rem; color: #aab3b0; text-align: start; transition: color var(--dur-2); }
  .orbit__station-num { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.05rem; color: #b98f63; min-inline-size: 1.6rem; }
  .orbit__station-name { position: relative; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; }
  :lang(ar) .orbit__station-name { letter-spacing: 0; text-transform: none; font-size: 0.92rem; }
  .orbit__station-name::after {
    content: '';
    position: absolute;
    inset-inline: -0.3em -0.5em;
    inset-block-end: -0.62em;
    block-size: 0.5rem;
    background: #e9a86a;
    -webkit-mask: url('/ink/under.png') center / 100% 100% no-repeat;
    mask: url('/ink/under.png') center / 100% 100% no-repeat;
    clip-path: inset(-50% 100% -50% 0);
    transition: clip-path 0.7s var(--ease-out);
  }
  [dir='rtl'] .orbit__station-name::after { clip-path: inset(-50% 0 -50% 100%); }
  .orbit__index button:hover { color: var(--cloud); }
  .orbit__index button[aria-current='true'] { color: var(--cloud); }
  .orbit__index button[aria-current='true'] .orbit__station-num { color: #e9a86a; }
  .orbit__index button[aria-current='true'] .orbit__station-name::after { clip-path: inset(-50% 0 -50% 0); }
  .orbit__index button:hover .orbit__station-name::after { clip-path: inset(-50% 0 -50% 0); opacity: 0.45; }
  .orbit__index button[aria-current='true']:hover .orbit__station-name::after { opacity: 1; }

  .orbit__foot { display: flex; align-items: baseline; gap: 1.4rem; flex-wrap: wrap; justify-content: flex-end; }
  .orbit__pause { position: relative; padding-block: 0.3rem; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #c3cbc8; transition: color var(--dur-2); }
  :lang(ar) .orbit__pause { letter-spacing: 0; text-transform: none; font-size: 0.88rem; }
  .orbit__pause::before { content: ''; display: inline-block; inline-size: 0.5em; block-size: 0.7em; margin-inline-end: 0.6em; border-inline: 2px solid currentColor; vertical-align: -0.05em; }
  .orbit__pause[aria-pressed='true']::before { inline-size: 0; block-size: 0; border-inline: 0; border-block: 0.38em solid transparent; border-inline-start: 0.62em solid currentColor; }
  .orbit__pause:hover, .orbit__pause[aria-pressed='true'] { color: #e9a86a; }
  .orbit__hint { font-family: var(--font-display); font-style: italic; font-size: 1rem; color: #8e9894; }
  :lang(ar) .orbit__hint { font-style: normal; font-size: 0.9rem; }

  @media (max-width: 900px) {
    .orbit__below { grid-template-columns: 1fr; }
    .orbit__controls { justify-items: start; }
    .orbit__index { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.2rem; inline-size: 100%; }
    .orbit__foot { justify-content: flex-start; }
    .orbit__card { --card-w: clamp(118px, 33vw, 210px); }
    .orbit__stage { block-size: clamp(340px, 52vh, 500px); }
    .orbit__label { font-size: 0.95rem; }
  }
</style>

<script>
  import { initOrbit } from '../scripts/orbit';
  import { mountVortex } from '../scripts/vortex';
  // Nothing heavy runs until the storm chapter approaches the viewport.
  const section = document.querySelector<HTMLElement>('[data-storm]');
  if (section) {
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const root = section.querySelector<HTMLElement>('[data-orbit]');
      if (root) initOrbit(root);
      const canvas = section.querySelector<HTMLCanvasElement>('[data-vortex]');
      if (canvas) {
        const idle = (window as any).requestIdleCallback ?? ((f: () => void) => setTimeout(f, 60));
        idle(() => mountVortex(canvas, section.querySelector<HTMLElement>('.orbit__core')).catch(() => { /* no WebGL: the CSS ink gradient remains */ }));
      }
    }, { rootMargin: '0px 0px 150px 0px' });
    io.observe(section);
  }
</script>
