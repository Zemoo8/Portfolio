---
import Brush from '../components/Brush.astro';
import { formatMonth, tr, asset, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { experience, education, competitions, type Entry } from '../content/path';
import { competitionCertificate } from '../content/credentials';

interface Props { lang: Locale }
const { lang } = Astro.props;
const when = (e: Entry) => {
  const s = formatMonth(e.start, lang);
  if (!e.end) return s;
  return `${s} — ${e.end === 'present' ? tr(ui.path.present, lang) : formatMonth(e.end, lang)}`;
};
const groups = [
  { title: ui.path.experience, items: experience },
  { title: ui.path.education, items: education },
];
---

<section id="path" class="section wrap" aria-labelledby="path-title">
  <div class="scroll path" data-unroll>
    <header class="section-head">
      <p class="kicker" data-reveal>{tr(ui.path.kicker, lang)}</p>
      <h2 id="path-title" class="sr-only">{tr(ui.path.kicker, lang)}</h2>
    </header>

    {groups.map((g, gi) => (
      <div class="path__group">
        <h3 class="path__label display" data-reveal>{tr(g.title, lang)}</h3>
        <ol class="path__list">
          {g.items.map((e, i) => (
            <li class="entry" data-reveal style={`--i:${i}`}>
              <p class="entry__when label"><time>{when(e)}</time></p>
              <div class="entry__main">
                <h4 class="entry__org">{e.org}</h4>
                <p class="entry__role">{tr(e.role, lang)}</p>
                <p class="entry__place label">{tr(e.place, lang)}</p>
              </div>
              <div class="entry__body">
                {e.body.map((b) => <p>{tr(b, lang)}</p>)}
                {(e.tags || e.link) && (
                  <p class="entry__tags">
                    {e.tags?.map((t) => <span class="pill">{t}</span>)}
                    {e.link && <a class="pill link-u" href={e.link.href} target="_blank" rel="noopener">{e.link.text} <span class="arrow" aria-hidden="true">↗</span></a>}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
        <Brush seed={40 + gi} length={1100} width={4} class="path__stroke" />
      </div>
    ))}

    <div class="path__group">
      <h3 class="path__label display" data-reveal>{tr(ui.path.competitions, lang)}</h3>
      <ol class="path__list">
        {competitions.map((c, i) => (
          <li class="entry" data-reveal style={`--i:${i}`}>
            <p class="entry__when label">{tr(c.result, lang)}</p>
            <div class="entry__main"><h4 class="entry__org">{c.name}</h4></div>
            <div class="entry__body">
              <p>{tr(c.detail, lang)}</p>
              {c.name === 'Code It Up 5.0' && (
                <button
                  class="entry__cert"
                  type="button"
                  data-lightbox
                  data-group="competition"
                  data-src={asset(`media/certificates/${competitionCertificate.image}.webp`)}
                  data-title={competitionCertificate.title}
                  data-meta={competitionCertificate.issuer}
                  aria-label={`${tr(ui.credentials.view, lang)}: ${competitionCertificate.title}`}
                >
                  <img src={asset(`media/certificates/${competitionCertificate.image}-sm.webp`)} width="304" height="214" alt="" loading="lazy" decoding="async" />
                </button>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .path__group { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 1rem var(--gutter); padding-block: 1.6rem 0; }
  .path__label { font-size: var(--step-3); }
  .path__list { display: grid; }
  .path :global(.path__stroke) { grid-column: 1 / -1; inline-size: 100%; block-size: 16px; opacity: 0.55; margin-block: 1.2rem 0.6rem; }
  .entry { display: grid; grid-template-columns: 10rem minmax(0, 4fr) minmax(0, 6fr); gap: 1rem var(--gutter); padding-block: 0 2rem; }
  .entry + .entry { padding-block-start: 2rem; border-block-start: 1px solid var(--line); }
  .entry__org { font-family: var(--font-display); font-size: var(--step-2); font-weight: 600; line-height: 1.05; }
  .entry__role { color: var(--ink-2); margin-block-start: 0.3rem; font-weight: 500; }
  .entry__place { margin-block-start: 0.3rem; }
  .entry__body { display: grid; gap: 0.8rem; color: var(--ink-2); }
  .entry__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .entry__cert {
    justify-self: start;
    padding: 0.35rem;
    border-radius: 4px;
    background: #fff;
    box-shadow: 0 14px 30px -18px rgb(40 36 30 / 0.55), 0 0 0 1px var(--line);
    transform: rotate(-1.2deg);
    transition: transform 0.5s var(--ease-out);
  }
  .entry__cert:hover, .entry__cert:focus-visible { transform: rotate(0) translateY(-4px); }
  .entry__cert img { inline-size: clamp(180px, 22vw, 260px); block-size: auto; }
  @media (max-width: 960px) {
    .path__group { grid-template-columns: 1fr; }
    .entry { grid-template-columns: 1fr; }
  }
</style>
