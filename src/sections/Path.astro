---
// The path, as a road: one pale-gold stroke of a loaded brush winding down a night-dark hanging
// scroll (lib/road.ts) — a hair in the far distance at the top, where the way leads next, and
// broad at the foot, where the brush runs dry. The road makes a bend for every step, and the step
// is written in the hollow of its bend, facing a landmark that stands outside it: a pavilion, karst rocks, a
// pine, each on its own rise of ground that runs into the road's edge (scripts/art/road-marks.mjs).
// A walker and two riders are on the road. The steps keep their three groups (work, competitions,
// studies), newest first.
// On a wide screen the scroll unrolls as you read: its lower roller keeps its place near the foot
// of the screen and the silk comes out from under it.
import { formatMonth, tr, asset, type Locale, type L } from '../i18n/config';
import { ui } from '../i18n/ui';
import { experience, education, competitions, type Entry } from '../content/path';
import { competitionCertificate, internshipCertificate } from '../content/credentials';
import { profile } from '../content/profile';
import { road, swing, slope } from '../lib/road';

interface Props { lang: Locale }
const { lang } = Astro.props;
const when = (e: Entry) => {
  const s = formatMonth(e.start, lang);
  if (!e.end) return s;
  return `${s} — ${e.end === 'present' ? tr(ui.path.present, lang) : formatMonth(e.end, lang)}`;
};

type Cert = { src: string; thumb: string; title: string; meta: string; group: string; w: number; h: number };
type Step = { group?: L; mark: string; org: string; role?: string; place?: string; body: string[]; tags?: string[]; link?: Entry['link']; cert?: Cert; next?: boolean };
const cert = (image: string, title: string, meta: string, group: string, w: number, h: number): Cert => ({
  src: asset(`media/certificates/${image}.webp`), thumb: asset(`media/certificates/${image}-sm.webp`), title, meta, group, w, h,
});
const fromEntry = (e: Entry, group?: L): Step => ({
  group, mark: when(e), org: e.org, role: tr(e.role, lang), place: tr(e.place, lang), body: e.body.map((b) => tr(b, lang)), tags: e.tags, link: e.link,
  cert: e.org === 'Sotetel' ? cert(internshipCertificate.image, tr(internshipCertificate.title, lang), tr(internshipCertificate.meta, lang), 'internship', 334, 490) : undefined,
});
const steps: Step[] = [
  // where the road leads, in Ahmed's own words (About): the far end, still only a hair of ink
  { next: true, mark: tr(ui.path.next, lang), org: '', body: [tr(profile.about[2], lang)] },
  ...experience.map((e, i) => fromEntry(e, i === 0 ? ui.path.experience : undefined)),
  ...competitions.map((c, i): Step => ({
    group: i === 0 ? ui.path.competitions : undefined, mark: tr(c.result, lang), org: c.name, body: [tr(c.detail, lang)],
    cert: c.name === 'Code It Up 5.0' ? cert(competitionCertificate.image, competitionCertificate.title, competitionCertificate.issuer, 'competition', 304, 214) : undefined,
  })),
  ...education.map((e, i) => fromEntry(e, i === 0 ? ui.path.education : undefined)),
];
const bends = road(steps.length);
// what stands outside each bend, and how large (a share of the scroll's width): small far off
const landmarks: [string, number][] = [['peaks', 9], ['pavilion', 14], ['pine', 15], ['rocks', 18], ['pine', 18], ['pavilion', 20], ['rocks', 22]];
// who is on the road: which bend, how far down it, how wide beside the road's own width
const folk = [{ bend: 4, t: 0.9, who: 'riders', span: 1.5 }, { bend: 5, t: 0.36, who: 'walker', span: 0.44 }];

// ---- the road is painted as the page is scrolled (wide screens; the rules are in the stylesheet below)
// The brush's tip keeps to one level of the screen, so the stroke has to be drawn out faster where
// the road runs across the page than where it runs down it (`slope`: how many times faster, where
// it crosses the middle — measured in the road's own box, as the hairs' lengths are).
const STEPS = 8;
const drawn = [0];
for (let k = 1; k <= STEPS; k++) {
  let sum = 0;
  for (let q = 0; q < 40; q++) sum += Math.hypot(1, slope * Math.cos((Math.PI * (k - 1 + (q + 0.5) / 40)) / STEPS));
  drawn.push(drawn[k - 1] + sum / 40 / STEPS);
}
// a hair is one dash, 3 long, on a line never longer than 2.3: offset by 3 it is all still to paint
const paint = (name: string, end: number) =>
  `@keyframes ${name}{${drawn.map((d, k) => `${((k / STEPS) * 100).toFixed(1)}%{stroke-dashoffset:calc(${(3 - (k === STEPS ? end : d / drawn[STEPS] - 0.04)).toFixed(4)} - var(--lead))}`).join('')}}`;
// the brush itself: from the middle out to a bend and back is a sine — eased out, then in
const half = steps.length * 2;
const brushX = Array.from({ length: half + 1 }, (_, k) =>
  `${((k / half) * 100).toFixed(3)}%{transform:translateX(${k % 2 ? (bends[(k - 1) / 2].side * swing).toFixed(1) : 0}%);animation-timing-function:${k % 2 ? 'cubic-bezier(0.12,0,0.39,0)' : 'cubic-bezier(0.61,1,0.88,1)'}}`).join('');
// it leans the way the road is going (LEAN: the same slope as it is on the screen, at the
// proportions the chapter usually has), and bears down harder (comes closer) as the road widens
const LEAN = 1.75;
const turns = steps.length * 8;
const brushLean = Array.from({ length: turns + 1 }, (_, k) => {
  const bend = Math.min(steps.length - 1, Math.floor(k / 8));
  const lean = (-bends[bend].side * Math.atan(LEAN * Math.cos(Math.PI * (k / 8 - bend))) * 180) / Math.PI;
  return `${((k / turns) * 100).toFixed(3)}%{rotate:${lean.toFixed(1)}deg;scale:${(0.5 + 0.7 * (k / turns)).toFixed(3)}}`;
}).join('');
const paintCss = `${paint('road-paint', 1.08)}${paint('road-paint-out', 2.4)}@keyframes road-brush-x{${brushX}}@keyframes road-brush-lean{${brushLean}}`;
---

<section id="path" class="section wrap" aria-labelledby="path-title" data-tone="light" data-chapter-name={tr(ui.nav.path, lang)}>
  <div class="night">
    <span class="night__rod" aria-hidden="true"></span>
    <div class="night__window">
      <div class="night__sheet">
        <header class="section-head">
          <p class="kicker" data-reveal>{tr(ui.path.kicker, lang)}</p>
          <h2 id="path-title" class="sr-only">{tr(ui.path.kicker, lang)}</h2>
        </header>

        <div class="way">
          <ol class="road">
            {steps.map((s, i) => {
              const b = bends[i];
              const [mark, size] = landmarks[i % landmarks.length];
              const apex = b.at(0.5);
              // the landmark stands outside the bend, and the rise of ground under it runs into the
              // road's edge (the far peaks stand off on their own)
              const markX = apex.x + b.side * (b.width(0.5) / 2 + size / 2 + (s.next ? 2.5 : -2.2));
              const here = folk.filter((p) => p.bend === i);
              return (
                <li class:list={['bend', b.side < 0 ? 'bend--out' : 'bend--back', s.next && 'bend--next']}>
                  <div class="bend__road" aria-hidden="true" data-reveal-brush>
                    <svg class="lane lane--wide" viewBox="0 0 1000 300" preserveAspectRatio="none">
                      {/* the far end is not travelled yet: it comes out of the dark */}
                      {s.next && <linearGradient id="road-far-wide" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="300"><stop offset="0" stop-color="#37312a" /><stop offset="1" stop-color="#f0d7a1" /></linearGradient>}
                      {/* the bend's finished shape: what it is at rest, and what trims the hairs while it is painted */}
                      <clipPath id={`road-shape-${i}`}><path d={b.wide.body} />{b.wide.tail.map((d) => <path d={d} />)}</clipPath>
                      <g class="lane__whole" style={s.next ? 'fill:url(#road-far-wide)' : undefined}>
                        <path d={b.wide.body} />
                        {b.wide.tail.map((d) => <path d={d} />)}
                      </g>
                      <g class:list={['lane__hairs', i === steps.length - 1 && 'lane__hairs--out']} stroke-width={b.strands.thick} clip-path={`url(#road-shape-${i})`} style={s.next ? 'stroke:url(#road-far-wide)' : undefined}>
                        {b.strands.hairs.map((h) => <path d={h.d} pathLength={h.length.toFixed(4)} style={`--lead:${h.lead}`} />)}
                      </g>
                      {b.wide.dry.map((d) => <path class="lane__dry" d={d} />)}
                    </svg>
                    <svg class="lane lane--narrow" viewBox="0 0 64 300" preserveAspectRatio="none">
                      {s.next && <linearGradient id="road-far-narrow" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#37312a" /><stop offset="1" stop-color="#f0d7a1" /></linearGradient>}
                      <path class="lane__ink" d={b.narrow.body} style={s.next ? 'fill:url(#road-far-narrow)' : undefined} />
                      {b.narrow.tail.map((d) => <path class="lane__ink" d={d} />)}
                    </svg>
                    <span class:list={['mark', `mark--${mark}`]} style={`--x:${markX.toFixed(1)}%; --w:${size}%`}></span>
                    {here.map((p) => {
                      const at = b.at(p.t);
                      // they travel up the road, toward what comes next
                      const faces = p.t < 0.5 ? -b.side : b.side;
                      return <span class:list={['folk', `folk--${p.who}`, faces < 0 && 'folk--turned']} style={`--x:${at.x.toFixed(1)}%; --y:${at.y.toFixed(1)}%; --w:${(b.width(p.t) * p.span).toFixed(2)}%`}></span>;
                    })}
                  </div>
  
                  <div class="bend__text" data-reveal>
                    {s.group && <p class="bend__group kicker">{tr(s.group, lang)}</p>}
                    <p class="bend__when display">{s.next ? s.mark : <time>{s.mark}</time>}</p>
                    {s.org && <h3 class="bend__org">{s.org}</h3>}
                    {s.role && <p class="bend__role">{s.role}</p>}
                    {s.place && <p class="bend__place label">{s.place}</p>}
                    {s.body.length > 0 && <div class="bend__body">{s.body.map((p) => <p>{p}</p>)}</div>}
                    {(s.tags || s.link) && (
                      <p class="bend__tags">
                        {s.tags?.map((t) => <span class="pill">{t}</span>)}
                        {s.link && <a class="link-u entry__link" href={s.link.href} target="_blank" rel="noopener">{s.link.text} <span class="arrow" aria-hidden="true">↗</span></a>}
                      </p>
                    )}
                    {s.cert && (
                      <button class="bend__cert" type="button" data-lightbox data-group={s.cert.group} data-src={s.cert.src} data-title={s.cert.title} data-meta={s.cert.meta} aria-label={`${tr(ui.credentials.view, lang)}: ${s.cert.title}`}>
                        <img src={s.cert.thumb} width={s.cert.w} height={s.cert.h} alt="" loading="lazy" decoding="async" />
                      </button>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
          <div class="painter" aria-hidden="true">
            <div class="painter__x">
              <svg class="painter__tool" viewBox="0 0 64 300">
                <linearGradient id="road-brush-hair" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f0d7a1" /><stop offset="0.42" stop-color="#8d7440" /><stop offset="1" stop-color="#211c14" /></linearGradient>
                <path d="M32 0C22 22 13 44 15 72H49C51 44 42 22 32 0Z" fill="url(#road-brush-hair)" />
                <path d="M32 6C29 28 25 48 24 70M32 6C35 28 39 48 40 70M32 4V70" fill="none" stroke="#14110c" stroke-opacity="0.45" stroke-width="1.2" />
                <path d="M13 70H51V86H13Z" fill="#b08a3c" stroke="#2a1f10" stroke-width="2" />
                <path d="M19 86H45L42 292Q32 300 22 292Z" fill="#d2b47a" stroke="#2a1f10" stroke-width="2" stroke-linejoin="round" />
                <path d="M20 140H44M21 198H43M22 252H42" fill="none" stroke="#2a1f10" stroke-opacity="0.7" stroke-width="2" />
                <path d="M26 92V286" fill="none" stroke="#fff6d8" stroke-opacity="0.45" stroke-width="3" />
              </svg>
            </div>
          </div>
        </div>
        <style is:inline set:html={paintCss}></style>
      </div>
    </div>
    <div class="night__foot" aria-hidden="true"><span class="night__rod night__rod--foot"></span></div>
  </div>
</section>

<style>
  /* ---- the night scroll: ink-dark silk between two rollers, with its own palette for all on it */
  .night {
    --gold: #f0d7a1;
    --ink: #f3eee2;
    --ink-2: #d6d3c8;
    --muted: #a5a399;
    --rust: var(--gold);
    --line: rgb(240 215 161 / 0.2);
    position: relative;
    color: var(--ink);
  }
  .night__sheet {
    position: relative;
    padding: clamp(2.4rem, 1rem + 4vw, 5rem) clamp(1.25rem, 0.5rem + 4vw, 5rem) clamp(3.4rem, 1rem + 11vw, 13rem);
    background: radial-gradient(130% 70% at 50% 0%, #1e1c18, #121110 62%);
    box-shadow: inset 0 0 0 1px rgb(240 215 161 / 0.12);
  }
  .night__sheet::before {
    /* the mounting: a hairline of gold silk just inside each long edge */
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline: 7px;
    border-inline: 1px solid rgb(240 215 161 / 0.2);
    pointer-events: none;
  }
  .night__rod {
    position: absolute;
    z-index: 2;
    inset-inline: -0.7rem;
    inset-block-start: -0.5rem;
    block-size: 1rem;
    background: #24211c;
    -webkit-mask: url('/ink/roller.png') center / 100% 100% no-repeat;
    mask: url('/ink/roller.png') center / 100% 100% no-repeat;
  }
  .night__foot { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .night__foot::after {
    /* the roller's shadow on the wall */
    content: '';
    position: absolute;
    inset-inline: 1%;
    inset-block-start: calc(100% + 0.35rem);
    block-size: 1.6rem;
    background: radial-gradient(50% 100% at 50% 0%, rgb(30 26 20 / 0.34), rgb(30 26 20 / 0));
  }
  .night__rod--foot { inset-block-start: auto; inset-block-end: -0.55rem; block-size: 1.1rem; inset-inline: -0.9rem; }

  /* ---- the road ---- */
  .way { position: relative; }
  /* the brush that paints it (only where the road is painted as you scroll, below): a sheet as large
     as the road whose foot is at the brush's tip, a slide for the tip to run sideways on, the brush */
  .painter { position: absolute; inset: 0; z-index: 2; pointer-events: none; display: none; }
  :global([dir='rtl']) .painter { scale: -1 1; }
  .painter__x { position: absolute; inset-inline: 0; inset-block-end: 0; block-size: 0; }
  .painter__tool { position: absolute; left: 50%; top: -2px; inline-size: 3.4rem; block-size: auto; max-inline-size: none; translate: -50% 0; transform-origin: 50% 0; overflow: visible; }
  /* every bend is as tall as the tallest step: stretched alike, the pieces of the road run into
     one another without a kink, and the bends keep one rhythm */
  .road { position: relative; display: grid; grid-auto-rows: 1fr; margin-block-start: 1rem; }
  .bend { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; min-block-size: clamp(19rem, 29vw, 25rem); }
  .bend__road { position: absolute; inset: 0; pointer-events: none; }
  /* (a pixel over: the pieces of the road must meet without a seam) */
  .lane { position: absolute; inset-block-start: 0; inset-inline-start: 0; inline-size: 100%; block-size: calc(100% + 1px); max-inline-size: none; overflow: visible; }
  .lane--narrow { display: none; }
  .lane__ink { fill: var(--gold); }
  /* the wide road at rest: its one finished shape; and again as a few broad hairs (lib/road.ts)
     for painting it, each hair a dash far longer than its line (so it is whole) */
  .lane__whole { fill: var(--gold); }
  .lane__hairs { display: none; fill: none; stroke: var(--gold); stroke-linecap: round; stroke-linejoin: round; }
  .lane__hairs path { stroke-dasharray: 3; --lead: 0; }
  /* where the brush ran dry the silk shows through between its hairs */
  .lane__dry { fill: none; stroke: #15130f; stroke-opacity: 0.8; stroke-width: 1.4; vector-effect: non-scaling-stroke; }
  /* in Arabic the road is the mirror of itself, as the page is */
  :global([dir='rtl']) .bend__road { scale: -1 1; }

  /* where the scroll does not unroll, each bend is painted from its far end as it arrives */
  :global(.js) .bend__road .lane { clip-path: inset(0 -40% 100% -40%); }
  :global(.js) .bend__road:global(.is-in) .lane { clip-path: inset(0 -40% -60% -40%); transition: clip-path 1.2s cubic-bezier(0.55, 0.05, 0.25, 1); }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .bend__road .lane { clip-path: none; }
  }
  :global(.motion-off) .bend__road .lane { clip-path: none; transition: none; }

  /* ---- what stands by the road, cut in gold (placed from the left: the road's box is what is
     mirrored in Arabic, and these with it) ---- */
  .mark {
    position: absolute;
    left: var(--x);
    inset-block-start: 62%;
    inline-size: var(--w);
    translate: -50% -100%;
    background: center bottom / contain no-repeat;
  }
  .mark--pavilion { background-image: url('/art/road-pavilion.png'); aspect-ratio: 400 / 372; }
  .mark--rocks { background-image: url('/art/road-rocks.png'); aspect-ratio: 400 / 424; }
  .mark--peaks { background-image: url('/art/road-peaks.png'); aspect-ratio: 400 / 424; opacity: 0.42; }
  .mark--pine { background-image: url('/art/road-pine.png'); aspect-ratio: 400 / 420; }
  /* ---- and who is on it, in ink against the pale road ---- */
  .folk {
    position: absolute;
    left: var(--x);
    inset-block-start: var(--y);
    inline-size: var(--w);
    translate: -50% -64%;
    background: center / contain no-repeat;
  }
  .folk--walker { background-image: url('/art/road-walker.png'); aspect-ratio: 120 / 200; }
  .folk--riders { background-image: url('/art/road-riders.png'); aspect-ratio: 340 / 190; }
  .folk--turned { scale: -1 1; }

  /* ---- a step, written in the hollow of its bend ---- */
  .bend__text { position: relative; z-index: 1; padding-block: 2.6rem; max-inline-size: 34rem; }
  .bend--out .bend__text { grid-column: 2; justify-self: start; padding-inline-start: 18%; }
  .bend--back .bend__text { grid-column: 1; justify-self: end; padding-inline-end: 18%; }
  .bend__group { margin-block-end: 0.8rem; }
  .bend__when { font-size: var(--step-2); font-style: italic; font-weight: 500; line-height: 1.1; color: var(--gold); }
  :lang(ar) .bend__when { font-style: normal; line-height: 1.5; }
  .bend--next .bend__when { color: var(--muted); }
  .bend__org { margin-block-start: 0.35rem; font-family: var(--font-display); font-size: var(--step-3); font-weight: 600; line-height: 1; }
  .bend__role { color: var(--ink-2); margin-block-start: 0.5rem; font-weight: 500; }
  .bend__place { margin-block-start: 0.3rem; }
  .bend__body { display: grid; gap: 0.6rem; margin-block-start: 0.8rem; color: var(--ink-2); font-size: 0.95rem; line-height: 1.55; }
  .bend--next .bend__body { font-family: var(--font-display); font-style: italic; font-size: var(--step-1); line-height: 1.4; color: var(--ink); }
  :lang(ar) .bend--next .bend__body { font-style: normal; line-height: 1.8; }
  .bend__tags { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1.4rem; margin-block-start: 0.9rem; }
  .bend__tags :global(.entry__link) { font-size: 0.86rem; font-weight: 600; color: var(--ink); }
  .bend__cert {
    margin-block-start: 1.1rem;
    padding: 0.35rem;
    border-radius: 4px;
    background: #fff;
    box-shadow: 0 16px 34px -18px rgb(0 0 0 / 0.8);
    transform: rotate(-1.2deg);
    transition: transform 0.5s var(--ease-out);
  }
  .bend--back .bend__cert { transform: rotate(1.1deg); }
  .bend__cert:hover, .bend__cert:focus-visible { transform: rotate(0) translateY(-4px); }
  .bend__cert img { inline-size: clamp(140px, 12vw, 176px); block-size: auto; }
  .bend__cert img[height='490'] { inline-size: clamp(78px, 6.4vw, 94px); } /* a portrait-format attestation */

  /* ---- the scroll unrolls as you read. The lower roller keeps its place, a little above the foot
     of the screen, and the silk comes out from under it: tied to where the page is, never to how
     fast it moves.
     Only `transform` moves, so the compositor does all of it and it keeps step with the page even
     when the main thread is busy: a window slides down over the silk while the silk slides up
     inside it by as much — the silk stays where it is on the page and is seen only through the
     window — and the roller rides on the window's lower edge. (Cutting the silk off with clip-path
     would be repainted on every frame.) The window lets clicks through: while rolled up it lies
     over the chapters above.
     Wide screens only, as every unrolling panel is (global.css); the timeline stays in its own
     rule (minifiers fold it into the shorthand). ---- */
  @keyframes night-window { from { transform: translateY(-100%); } to { transform: none; } }
  @keyframes night-silk { from { transform: translateY(100%); } to { transform: none; } }
  @supports (animation-timeline: view()) {
    @media (min-width: 1000px) and (prefers-reduced-motion: no-preference) {
      /* (measured against the whole screen: by default a view timeline leaves out the page's scroll-padding,
         and the roller would creep down by that much) */
      :global(html.js) .night { view-timeline: --night block; view-timeline-inset: 0px; }
      :global(html.js) .night__window { overflow: clip; pointer-events: none; animation: night-window linear both; }
      :global(html.js) .night__foot { animation: night-window linear both; }
      :global(html.js) .night__sheet { pointer-events: auto; animation: night-silk linear both; }
      :global(html.js) .night .night__window, :global(html.js) .night .night__foot, :global(html.js) .night .night__sheet { animation-timeline: --night; animation-range: cover 12vh cover calc(100% - 88vh); }
      /* the roller uncovers the silk; a little above it a brush paints the road onto it, as far as
         the page has been scrolled. Its tip keeps to one level of the screen (62 % down).
         The brush is moved by transform (the compositor). The hairs are drawn out by
         stroke-dashoffset, which is painted on the main thread — so only the one bend the brush
         is in is ever animated (the script below says which: the bends above it are their
         finished shape, those below are bare). */
      :global(html.js) .night .bend__road .lane { clip-path: none; transition: none; }
      :global(html.js:not(.motion-off)) .night .bend { view-timeline: --bend block; view-timeline-inset: 0px; }
      :global(html.js:not(.motion-off)) .night .bend:global(.is-bare) .lane--wide { visibility: hidden; }
      /* (every bend keeps a layer of its own, so that taking up the brush or setting it down in a
         bend makes and unmakes nothing: only that bend is drawn again) */
      :global(html.js:not(.motion-off)) .night .lane--wide { will-change: transform; }
      :global(html.js:not(.motion-off)) .night .bend:global(.is-painting) .lane__whole { display: none; }
      :global(html.js:not(.motion-off)) .night .bend:global(.is-painting) .lane__hairs { display: inline; }
      :global(html.js:not(.motion-off)) .night .bend:global(.is-painting) .lane__hairs path { animation: road-paint linear both; }
      :global(html.js:not(.motion-off)) .night .bend:global(.is-painting) .lane__hairs--out path { animation-name: road-paint-out; }
      :global(html.js:not(.motion-off)) .night .road .bend:global(.is-painting) .lane__hairs path { animation-timeline: --bend; animation-range: cover 38vh cover calc(100% - 62vh); }
      :global(html.js:not(.motion-off)) .night .way { view-timeline: --way block; view-timeline-inset: 0px; }
      :global(html.js:not(.motion-off)) .night .painter { display: block; animation: road-brush-y linear both; }
      :global(html.js:not(.motion-off)) .night .painter__x { animation: road-brush-x linear both; }
      :global(html.js:not(.motion-off)) .night .painter__tool { animation: road-brush-lean linear both; }
      :global(html.js:not(.motion-off)) .night .way :is(.painter, .painter__x, .painter__tool) { animation-timeline: --way; animation-range: cover 38vh cover calc(100% - 62vh); }
      /* what stands by the road, and who is on it, appear as the brush comes level with them */
      :global(html.js:not(.motion-off)) .night .bend:global(.is-bare) :is(.mark, .folk) { opacity: 0; }
      :global(html.js:not(.motion-off)) .night .bend:global(.is-painting) :is(.mark, .folk) { animation: road-arrive linear both; }
      :global(html.js:not(.motion-off)) .night .road .bend:global(.is-painting) :is(.mark, .folk) { animation-timeline: view(); animation-range: cover 34vh cover 46vh; }
      /* what the keyboard reaches must come out from under the roller */
      :global(html.js) .night :is(a, button) { scroll-margin-block-end: 18vh; }
    }
  }
  :global(html.motion-off) .night :is(.night__window, .night__foot, .night__sheet) { animation: none; }
  :global(html.motion-off) .night .night__window { overflow: visible; }
  @keyframes road-arrive { from { opacity: 0; } }
  /* (lifted off the silk at the end of the stroke) */
  @keyframes road-brush-y { from { transform: translateY(-100%); } 97% { opacity: 1; } to { transform: none; opacity: 0; } }

  /* ---- narrow screens: the road keeps to the margin, every step beside it, as tall as its own text ---- */
  @media (max-width: 999px) {
    .road { grid-auto-rows: auto; }
    .bend__body { font-size: inherit; line-height: inherit; }
    .bend { grid-template-columns: 64px minmax(0, 1fr); min-block-size: 0; }
    .bend__road { inset-inline-end: auto; inline-size: 64px; }
    .lane--wide, .mark, .folk { display: none; }
    .lane--narrow { display: block; }
    .bend--out .bend__text, .bend--back .bend__text { grid-column: 2; justify-self: start; padding-inline: 0.9rem 0; padding-block: 0.9rem 2.4rem; max-inline-size: none; }
  }
</style>

<script>
  // Which bend is the brush in? Its tip is 62 % down the screen: the bend that level falls in is
  // being painted, the bends below it are still bare silk, those above are done. Worked out from
  // where the road is (never from what was seen on the way: the page can be thrown from one end to
  // the other in a single step), once a frame, and only while the road is near the screen.
  const road = document.querySelector<HTMLElement>('.road');
  if (road && 'IntersectionObserver' in window && CSS.supports('animation-timeline: view()')) {
    const bends = [...road.querySelectorAll('.bend')];
    let queued = 0;
    const place = () => {
      queued = 0;
      const box = road.getBoundingClientRect();
      const at = Math.floor(((innerHeight * 0.62 - box.top) / box.height) * bends.length);
      bends.forEach((b, i) => { b.classList.toggle('is-painting', i === at); b.classList.toggle('is-bare', i > at); });
    };
    const soon = () => { queued ||= requestAnimationFrame(place); };
    new IntersectionObserver(([e]) => {
      place();
      if (e.isIntersecting) addEventListener('scroll', soon, { passive: true });
      else removeEventListener('scroll', soon);
    }, { rootMargin: '100% 0px' }).observe(road);
    addEventListener('resize', soon);
  }
</script>
