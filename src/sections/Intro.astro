---
import IntroFilm from '../components/IntroFilm.astro';
import { tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props { lang: Locale }
const { lang } = Astro.props;
---

<section id="intro" class="intro wrap" aria-label={tr(ui.intro.title, lang)} data-tone="light" data-chapter-name={tr(ui.intro.title, lang)}>
  <IntroFilm lang={lang} />
</section>

<style>
  .intro { min-block-size: 100svh; display: grid; align-items: center; padding-block: 4rem; }
</style>
