---
// Contact, as the place the road was going: night, a full moon rising behind a pavilion on its
// rise of ground, the road coming up to its steps out of the foreground with the riders and the
// walker of the Path chapter on it (the same gold and ink, the same pieces: scripts/art/
// road-marks.mjs). The words stand beside the picture: the invitation, the address, the links.
// The moon climbs a little as the chapter comes up the screen (tied to scroll position; transform).
// And the finale: sky lanterns are lit at the pavilion and climb past the moon, a whole flight of
// them once the night fills the screen (scripts/lanterns.ts).
import Brush from '../components/Brush.astro';
import { asset, tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { profile } from '../content/profile';
import { exists } from '../lib/media';

interface Props { lang: Locale }
const { lang } = Astro.props;
// the public CV (scripts/media/build-cv.py — Ahmed's PDF without his phone number), if it is there
const cv = exists('cv/ahmed-baghouli-cv.pdf') ? 'cv/ahmed-baghouli-cv.pdf' : null;
---

<section id="contact" class="section contact wrap" aria-labelledby="contact-title" data-tone="light" data-chapter-name={tr(ui.nav.contact, lang)}>
  <div class="dusk">
    <div class="dusk__scene" aria-hidden="true">
      <span class="dusk__moon"></span>
      <svg class="dusk__clouds" viewBox="0 0 500 620" preserveAspectRatio="none">
        <path d="M150 232q60 -10 120 0t120 0t110 0M210 258q50 -8 100 0t100 0t90 2M120 282q40 -7 80 0t80 0" />
      </svg>
      <span class="dusk__far"></span>
      <svg class="dusk__road" viewBox="0 0 500 620" preserveAspectRatio="none">
        <path d="M-20 640C40 560 170 512 326 462L372 470C318 520 250 566 196 640Z" />
      </svg>
      <span class="dusk__pine"></span>
      <span class="dusk__hall"></span>
      <span class="dusk__riders"></span>
      <span class="dusk__walker"></span>
    </div>
    <canvas class="dusk__sky" data-lanterns aria-hidden="true" hidden></canvas>
    <span class="dusk__end" data-lanterns-end aria-hidden="true"></span>

    <div class="dusk__words">
      <p class="kicker" data-reveal>{tr(ui.contact.kicker, lang)}</p>
      <h2 id="contact-title" class="display contact__title" data-lines>{tr(ui.contact.title, lang)}</h2>
      <Brush seed={63} length={700} class="contact__stroke" color="var(--gold)" />
      <p class="contact__body" data-reveal>{tr(ui.contact.body, lang)}</p>

      <div class="contact__mail" data-reveal>
        <img class="contact__avatar" src={asset('media/profile/portrait-ink.webp')} width="432" height="577" alt="" loading="lazy" decoding="async" />
        <a class="contact__address display" href={`mailto:${profile.email}`} dir="ltr">{profile.email}</a>
        <button class="btn btn--ghost contact__copy" type="button" data-copy={profile.email} data-copied={tr(ui.contact.copied, lang)}>
          <span data-copy-label>{tr(ui.contact.copy, lang)}</span>
        </button>
      </div>

      <ul class="contact__links" data-reveal>
        {cv && (
          <li>
            <a class="btn" href={asset(cv)} download="Ahmed-Baghouli-CV.pdf" type="application/pdf" hreflang="en" data-astro-prefetch="false">
              {tr(ui.contact.cv, lang)} <span class="contact__cv-note">{tr(ui.contact.cvNote, lang)}</span> <span aria-hidden="true">↓</span>
            </a>
          </li>
        )}
        <li><a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener me">LinkedIn <span class="arrow" aria-hidden="true">↗</span></a></li>
        <li><a class="btn" href={profile.links.github} target="_blank" rel="noopener me">GitHub <span class="arrow" aria-hidden="true">↗</span></a></li>
      </ul>
      <p class="sr-only" aria-live="polite" data-copy-status></p>
      <p class="dusk__hint label">{tr(ui.contact.lantern, lang)}</p>
    </div>
  </div>
</section>

<style>
  /* ---- the night: the Path scroll's silk and palette, as one wide picture ---- */
  .dusk {
    --gold: #f0d7a1;
    --ink: #f3eee2;
    --ink-2: #d6d3c8;
    --muted: #a5a399;
    --rust: #fff1cc;
    --line: rgb(240 215 161 / 0.2);
    --line-strong: rgb(240 215 161 / 0.4);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    overflow: clip;
    padding: clamp(2.6rem, 1rem + 5vw, 5.5rem) clamp(1.4rem, 0.5rem + 4vw, 5rem);
    color: var(--ink);
    background: radial-gradient(90% 80% at 76% 30%, #26221b, #121110 70%);
    box-shadow: inset 0 0 0 1px rgb(240 215 161 / 0.14), 0 34px 60px -40px rgb(20 18 14 / 0.8);
  }
  .dusk::before {
    /* the mounting: a hairline of gold silk a little inside the edge */
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid rgb(240 215 161 / 0.2);
    pointer-events: none;
  }
  .dusk__words { position: relative; z-index: 1; display: grid; gap: 1.6rem; justify-items: start; }
  .contact__title { font-size: calc(var(--step-5) * 0.86); font-weight: 600; max-inline-size: 15ch; }
  :lang(ar) .contact__title { max-inline-size: 14ch; }
  .contact :global(.contact__stroke) { inline-size: min(100%, 26rem); block-size: 22px; margin-block: -0.6rem 0; }
  .contact__body { color: var(--ink-2); max-inline-size: 36rem; font-size: var(--step-1); }
  .contact__mail { display: flex; align-items: center; gap: 1.1rem; flex-wrap: wrap; margin-block-start: 0.6rem; }
  .contact__avatar { inline-size: 3.8rem; block-size: 3.8rem; border-radius: 50%; object-fit: cover; object-position: 50% 18%; background: #e4e6de; box-shadow: 0 0 0 1px var(--line-strong); }
  .contact__address { font-size: clamp(1.5rem, 0.8rem + 2.6vw, 3.2rem); font-family: 'Cormorant Garamond', serif; font-weight: 600; overflow-wrap: anywhere; color: var(--gold); }
  .contact__address:hover { color: var(--rust); }
  .contact__links { display: flex; gap: 1rem 1.6rem; flex-wrap: wrap; }
  .contact__cv-note { font-weight: 500; opacity: 0.72; }
  /* on the dark silk the buttons are strokes of gold, lettered in ink */
  .dusk :global(.btn) { --btn-ink: var(--gold); color: #1a150d; }
  .dusk :global(.btn--ghost) { color: var(--ink); }
  /* the second stroke is painted the other way up, so the pair never looks stamped */
  .contact__links li:nth-child(2) :global(.btn)::before { scale: 1 -1; }

  /* ---- the picture ---- */
  /* (a picture of fixed proportions, standing on the lower edge of the silk: the road runs off it) */
  .dusk__scene { position: relative; order: 2; align-self: end; aspect-ratio: 5 / 6; margin-block-end: calc(clamp(2.6rem, 1rem + 5vw, 5.5rem) * -1); }
  :global([dir='rtl']) .dusk__scene { scale: -1 1; }
  .dusk__scene > * { position: absolute; }
  .dusk__scene > span { background: center bottom / contain no-repeat; }
  .dusk__moon {
    inset-inline-start: 14%;
    inset-block-start: 3%;
    inline-size: 58%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 34%, #f8e9c0, #f0d7a1 52%, #dfc186) !important;
    box-shadow: 0 0 0 1px rgb(240 215 161 / 0.35), 0 0 90px 26px rgb(240 215 161 / 0.13);
  }
  .dusk__clouds, .dusk__road { inset: 0; inline-size: 100%; block-size: 100%; max-inline-size: none; overflow: visible; }
  /* bands of cloud drawn across the moon in the colour of the night */
  .dusk__clouds path { fill: none; stroke: #17140f; stroke-width: 5; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .dusk__far { inset-inline-start: 0; inset-block-end: 30%; inline-size: 40%; aspect-ratio: 400 / 424; background-image: url('/art/road-peaks.png') !important; opacity: 0.4; }
  .dusk__road path { fill: var(--gold); }
  .dusk__hall { inset-inline-start: 46%; inset-block-end: 23%; inline-size: 44%; aspect-ratio: 400 / 372; background-image: url('/art/road-pavilion.png') !important; }
  .dusk__pine { inset-inline-start: 22%; inset-block-end: 23.5%; inline-size: 30%; aspect-ratio: 400 / 420; background-image: url('/art/road-pine.png') !important; }
  .dusk__riders { inset-inline-start: 12%; inset-block-end: 5%; inline-size: 30%; aspect-ratio: 340 / 190; background-image: url('/art/road-riders.png') !important; }
  .dusk__walker { inset-inline-start: 50%; inset-block-end: 19%; inline-size: 6.4%; aspect-ratio: 120 / 200; background-image: url('/art/road-walker.png') !important; }

  /* the lanterns: a canvas over the whole picture, under the words; a mark near its foot tells the
     page the night now fills the screen (the flight goes up then); a line says the night can be
     touched (only once lit) */
  .dusk__sky { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; pointer-events: none; }
  .dusk__end { position: absolute; inset-block-start: 56%; inset-inline-start: 0; inline-size: 1px; block-size: 1px; }
  .dusk__hint { display: none; margin-block-start: 0.4rem; color: var(--muted); }
  .dusk:global(.has-lanterns) .dusk__hint { display: block; }
  :global(html.motion-off) .dusk .dusk__hint { display: none; }

  /* the moon climbs as the chapter comes up the screen */
  @keyframes moon-rise { from { transform: translateY(34%); } to { transform: none; } }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(html.js:not(.motion-off)) .dusk__moon { animation: moon-rise linear both; }
      :global(html.js:not(.motion-off)) .dusk .dusk__moon { animation-timeline: view(); animation-range: entry 10% cover 52%; }
    }
  }

  @media (max-width: 900px) {
    .dusk { grid-template-columns: minmax(0, 1fr); }
    .dusk__scene { order: 0; inline-size: min(100%, 24rem); margin: -0.6rem auto 0; }
  }
</style>

<script>
  // the lanterns are fetched only when the night is about to come on to the screen
  const night = document.querySelector<HTMLElement>('.dusk');
  if (night && 'IntersectionObserver' in window) {
    const near = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      near.disconnect();
      import('../scripts/lanterns').then((m) => m.initLanterns(night));
    }, { rootMargin: '120% 0px' });
    near.observe(night);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      const label = b.querySelector<HTMLElement>('[data-copy-label]')!;
      const before = label.textContent;
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        label.textContent = b.dataset.copied!;
        document.querySelector('[data-copy-status]')!.textContent = b.dataset.copied!;
        setTimeout(() => (label.textContent = before), 1800);
      } catch { /* clipboard unavailable: the mailto link still works */ }
    }),
  );
</script>
