---
// The last scene: dark, nearly empty. One line of why, the address as large as the screen allows,
// and two small ways out. The address is the button.
import { tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { profile } from '../content/profile';

interface Props { lang: Locale }
const { lang } = Astro.props;
const [user, domain] = profile.email.split('@');
---

<section id="contact" class="contact" aria-labelledby="contact-title" data-tone="dark" data-chapter-name={tr(ui.nav.contact, lang)}>
  <h2 id="contact-title" class="contact__lead">{tr(ui.contact.body, lang)}</h2>
  <a class="contact__address" href={`mailto:${profile.email}`} dir="ltr"><span>{user}</span><span class="contact__at">@{domain}</span></a>
  <div class="contact__foot">
    <button class="contact__copy" type="button" data-copy={profile.email} data-copied={tr(ui.contact.copied, lang)}><span data-copy-label>{tr(ui.contact.copy, lang)}</span></button>
    <a class="arrow-link" href={profile.links.linkedin} target="_blank" rel="noopener me">LinkedIn <i aria-hidden="true"></i></a>
    <a class="arrow-link" href={profile.links.github} target="_blank" rel="noopener me">GitHub <i aria-hidden="true"></i></a>
  </div>
  <p class="sr-only" aria-live="polite" data-copy-status></p>
</section>

<style>
  .contact {
    display: grid;
    align-content: center;
    gap: 3rem;
    min-block-size: 100svh;
    padding: 8rem var(--gutter) 4rem;
    background: #141311;
    color: #efe9dc;
  }
  .contact__lead { max-inline-size: 30rem; font-family: var(--font-display); font-style: italic; font-weight: 500; font-size: clamp(1.3rem, 1rem + 0.9vw, 1.9rem); line-height: 1.3; color: #cfc6b4; }
  :lang(ar) .contact__lead { font-style: normal; line-height: 1.8; }
  .contact__address {
    display: grid;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3rem, 1rem + 10.5vw, 13rem);
    font-weight: 500;
    line-height: 0.86;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
    transition: color 0.4s var(--ease-out);
  }
  .contact__at { font-style: italic; color: #8f887b; transition: color 0.4s var(--ease-out); padding-inline-start: 0.6em; }
  .contact__address:hover, .contact__address:focus-visible { color: #fff; }
  .contact__address:hover .contact__at { color: var(--amber); }
  .contact__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem 3rem; }
  .contact__copy { font-size: 0.76rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; text-decoration: underline; text-underline-offset: 0.45em; color: #efe9dc; }
  :lang(ar) .contact__copy { letter-spacing: 0; text-transform: none; font-size: 0.95rem; }
  .contact__copy:hover { color: var(--amber); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      const label = b.querySelector<HTMLElement>('[data-copy-label]')!;
      const before = label.textContent;
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        label.textContent = b.dataset.copied!;
        document.querySelector('[data-copy-status]')!.textContent = b.dataset.copied!;
        setTimeout(() => (label.textContent = before), 1800);
      } catch { /* clipboard unavailable: the mailto link still works */ }
    }),
  );
</script>
