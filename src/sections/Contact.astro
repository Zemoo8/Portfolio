---
import { asset, tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { profile } from '../content/profile';

interface Props { lang: Locale }
const { lang } = Astro.props;
---

<section id="contact" class="section contact wrap" aria-labelledby="contact-title">
  <div class="contact__inner">
    <p class="kicker" data-reveal>{tr(ui.contact.kicker, lang)}</p>
    <h2 id="contact-title" class="display contact__title" data-lines>{tr(ui.contact.title, lang)}</h2>
    <p class="contact__body" data-reveal>{tr(ui.contact.body, lang)}</p>

    <div class="contact__mail" data-reveal>
      <img class="contact__avatar" src={asset('media/profile/portrait.webp')} width="432" height="577" alt="" loading="lazy" decoding="async" />
      <a class="contact__address display" href={`mailto:${profile.email}`} dir="ltr">{profile.email}</a>
      <button class="btn contact__copy" type="button" data-copy={profile.email} data-copied={tr(ui.contact.copied, lang)}>
        <span data-copy-label>{tr(ui.contact.copy, lang)}</span>
      </button>
    </div>

    <ul class="contact__links" data-reveal>
      <li><a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener me">LinkedIn <span class="arrow" aria-hidden="true">↗</span></a></li>
      <li><a class="btn" href={profile.links.github} target="_blank" rel="noopener me">GitHub <span class="arrow" aria-hidden="true">↗</span></a></li>
    </ul>
    <p class="sr-only" aria-live="polite" data-copy-status></p>
  </div>
</section>

<style>
  .contact__inner { display: grid; gap: 1.8rem; justify-items: start; padding-block-start: 4rem; border-block-start: 1px solid var(--line); }
  .contact__title { font-size: var(--step-5); max-inline-size: 16ch; }
  :lang(ar) .contact__title { max-inline-size: 14ch; }
  .contact__body { color: var(--paper-2); max-inline-size: 36rem; font-size: var(--step-1); }
  .contact__mail { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; margin-block-start: 1rem; }
  .contact__avatar { inline-size: 3.6rem; block-size: 3.6rem; border-radius: 50%; object-fit: cover; object-position: 50% 18%; background: var(--ink-3); box-shadow: 0 0 0 1px var(--line-strong); }
  .contact__address { font-size: clamp(1.7rem, 0.9rem + 4vw, 4.6rem); font-family: 'Instrument Serif', serif; letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .contact__address:hover { color: var(--signal); }
  .contact__links { display: flex; gap: 0.6rem; flex-wrap: wrap; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      const label = b.querySelector<HTMLElement>('[data-copy-label]')!;
      const before = label.textContent;
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        label.textContent = b.dataset.copied!;
        document.querySelector('[data-copy-status]')!.textContent = b.dataset.copied!;
        setTimeout(() => (label.textContent = before), 1800);
      } catch { /* clipboard unavailable: the mailto link still works */ }
    }),
  );
</script>
