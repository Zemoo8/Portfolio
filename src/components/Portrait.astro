---
// Editorial ink portrait: the photo lives inside the moon gate itself — a round window framed by
// the painted ensō, with the same ink landscape behind (the supplied photo is a cutout, so the
// peaks and mist sit behind the shoulders). Ink-wash duotone; the colour original warms in on
// hover. The window opens like an iris when it arrives. Decorative layers are aria-hidden.
import Brush from './Brush.astro';
import { asset, tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props { lang: Locale }
const { lang } = Astro.props;
---

<figure class="portrait" data-portrait data-reveal>
  <div class="portrait__disc">
    <img class="portrait__land" src={asset('art/gate.webp')} width="900" height="900" alt="" aria-hidden="true" loading="lazy" decoding="async" />
    <img class="portrait__ink" src={asset('media/profile/portrait-ink.webp')} width="432" height="577" alt={tr(ui.about.portraitAlt, lang)} loading="lazy" decoding="async" />
    <img class="portrait__color" src={asset('media/profile/portrait-color.webp')} width="432" height="577" alt="" aria-hidden="true" loading="lazy" decoding="async" />
  </div>
  <div class="portrait__enso" aria-hidden="true"><Brush kind="circle" seed={19} /></div>
</figure>

<style>
  .portrait {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: min(100%, 30rem);
    aspect-ratio: 1;
    margin-inline: auto;
  }
  .portrait__enso { position: absolute; inset: 0; pointer-events: none; }
  .portrait__enso :global(svg) { inline-size: 100%; block-size: 100%; }

  /* the round window, sitting just inside the brush ring */
  .portrait__disc {
    position: relative;
    inline-size: 76%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--mist);
    box-shadow: inset 0 0 0 1px rgb(31 29 26 / 0.1), inset 0 24px 60px -34px rgb(31 29 26 / 0.5);
    isolation: isolate;
  }
  .portrait__land { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 50% 60%; opacity: 0.9; }
  .portrait__ink, .portrait__color {
    position: absolute;
    inset-inline-start: 10%;
    inset-block-start: 13%;
    inline-size: 80%;
    block-size: auto;
    transition: opacity 1.4s var(--ease-out), scale 1.6s var(--ease-out);
  }
  .portrait__color { opacity: 0; }
  .portrait:hover .portrait__color { opacity: 0.92; }
  .portrait:hover .portrait__ink, .portrait:hover .portrait__color { scale: 1.02; }

  /* iris: the window opens from the centre when the portrait arrives */
  .js .portrait__disc { clip-path: circle(0% at 50% 50%); }
  .js .portrait.is-in .portrait__disc { clip-path: circle(50% at 50% 50%); transition: clip-path 1.6s cubic-bezier(0.7, 0, 0.2, 1) 0.25s; }

  @media (prefers-reduced-motion: reduce) { .js .portrait__disc { clip-path: none; } }
</style>
