---
// Editorial ink portrait. The only supplied photo (432×577) is shown as an ink-wash duotone
// inside an arched window, framed by a painted ensō; the colour original warms in on hover.
// A vermilion seal and coordinates caption complete the "painting". Decorative layers aria-hidden.
import Brush from './Brush.astro';
import Seal from './Seal.astro';
import { asset, tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props { lang: Locale }
const { lang } = Astro.props;
---

<figure class="portrait" data-portrait data-reveal>
  <div class="portrait__enso" data-depth="-10" aria-hidden="true"><Brush kind="circle" seed={19} /></div>
  <div class="portrait__frame" data-depth="8">
    <img class="portrait__ink" src={asset('media/profile/portrait-ink.webp')} width="432" height="577" alt={tr(ui.about.portraitAlt, lang)} loading="lazy" decoding="async" />
    <img class="portrait__color" src={asset('media/profile/portrait-color.webp')} width="432" height="577" alt="" aria-hidden="true" loading="lazy" decoding="async" />
  </div>
  <span class="portrait__seal" aria-hidden="true"><Seal size="3.1rem" /></span>
  <figcaption class="portrait__cap label" aria-hidden="true">
    <span>36.81° N · 10.18° E</span>
    <span>Tunis — 2026</span>
  </figcaption>
</figure>

<style>
  .portrait {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: min(100%, 30rem);
    aspect-ratio: 1;
    margin-inline: auto;
  }
  .portrait__enso { position: absolute; inset: 0; }
  .portrait__enso :global(svg) { inline-size: 100%; block-size: 100%; }
  .portrait__frame {
    position: relative;
    inline-size: 60%;
    aspect-ratio: 432 / 577;
    border-radius: 999px 999px 16px 16px;
    overflow: hidden;
    background: radial-gradient(90% 70% at 50% 30%, #eef0e9, #dcded5);
    box-shadow: 0 0 0 1px var(--line), 0 30px 60px -30px rgb(40 36 30 / 0.5);
  }
  .portrait__frame img { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 50% 20%; }
  .portrait__color { opacity: 0; transition: opacity 1.4s var(--ease-out); }
  .portrait:hover .portrait__color { opacity: 0.9; }
  .portrait__seal { position: absolute; inset-block-end: 16%; inset-inline-end: 16%; }

  /* aperture opening when the portrait arrives */
  .js .portrait__frame { clip-path: inset(100% 0 0 0 round 999px 999px 16px 16px); }
  .js .portrait.is-in .portrait__frame { clip-path: inset(0 0 0 0 round 999px 999px 16px 16px); transition: clip-path 1.6s cubic-bezier(0.7, 0, 0.2, 1) 0.2s; }

  .portrait__cap { position: absolute; inset-block-end: 1%; inset-inline: 8%; display: flex; justify-content: space-between; direction: ltr; font-size: 0.72rem; }
  [data-depth] { transition: transform 0.9s var(--ease-out); }
  @media (prefers-reduced-motion: reduce) { .js .portrait__frame { clip-path: none; } }
</style>

<script>
  const fig = document.querySelector<HTMLElement>('[data-portrait]');
  if (fig && matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const layers = [...fig.querySelectorAll<HTMLElement>('[data-depth]')];
    fig.addEventListener('pointermove', (e) => {
      if (document.documentElement.classList.contains('motion-off')) return;
      const r = fig.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      layers.forEach((l) => { const d = Number(l.dataset.depth); l.style.transform = `translate3d(${x * d}px, ${y * d}px, 0)`; });
    });
    fig.addEventListener('pointerleave', () => layers.forEach((l) => (l.style.transform = '')));
  }
</script>
