---
// The photograph makes its own circle: a round window of warm light with the portrait standing
// in it, the head rising above the rim (#pop clip, defined once in EmblemSymbol). No frame, no
// ring, no caption. Ink duotone by default; the colour original warms in on hover.
import { asset, tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props { lang: Locale; tone?: 'warm' | 'paper' }
const { lang, tone = 'warm' } = Astro.props;
---

<figure class:list={['portrait', `portrait--${tone}`]} data-portrait data-reveal>
  <span class="portrait__disc" aria-hidden="true"></span>
  <span class="portrait__pop">
    <img class="portrait__ink" src={asset('media/profile/portrait-ink@2x.webp')} srcset={`${asset('media/profile/portrait-ink.webp')} 432w, ${asset('media/profile/portrait-ink@2x.webp')} 864w`} sizes="(max-width: 900px) 90vw, 40rem" width="864" height="1154" alt={tr(ui.about.portraitAlt, lang)} loading="lazy" decoding="async" />
    <img class="portrait__color" src={asset('media/profile/portrait-color@2x.webp')} srcset={`${asset('media/profile/portrait-color.webp')} 432w, ${asset('media/profile/portrait-color@2x.webp')} 864w`} sizes="(max-width: 900px) 90vw, 40rem" width="864" height="1154" alt="" aria-hidden="true" loading="lazy" decoding="async" />
  </span>
</figure>

<style>
  .portrait { position: relative; inline-size: min(100%, 36rem); aspect-ratio: 1; margin: 0; }
  .portrait__disc { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at 42% 38%, #f3c27d, #e0741f 58%, #b8561a); }
  .portrait--paper .portrait__disc { background: radial-gradient(circle at 42% 38%, #fbf7ec, #e8e0cc 70%); }
  .portrait__pop { position: absolute; inset: 0; clip-path: url(#pop); }
  .portrait__pop img { position: absolute; inset-inline-start: 2%; inline-size: 96%; max-inline-size: none; block-size: auto; bottom: -14%; transition: opacity 1.2s var(--ease-out), scale 1.6s var(--ease-out); transform-origin: 50% 100%; }
  .portrait__color { opacity: 0; }
  .portrait:hover .portrait__color { opacity: 1; }
  .portrait:hover .portrait__pop img { scale: 1.025; }
  /* arrival: the photograph rises into its circle */
  .js .portrait[data-reveal] { opacity: 1; transform: none; }
  .js .portrait .portrait__pop img { translate: 0 18%; transition: translate 1.4s var(--ease-out), opacity 1.2s var(--ease-out), scale 1.6s var(--ease-out); }
  .js .portrait.is-in .portrait__pop img { translate: 0 0; }
  .js .portrait .portrait__disc { scale: 0.86; transition: scale 1.4s var(--ease-out); }
  .js .portrait.is-in .portrait__disc { scale: 1; }
  @media (prefers-reduced-motion: reduce) { .js .portrait .portrait__pop img, .js .portrait .portrait__disc { translate: none; scale: none; } }
</style>
