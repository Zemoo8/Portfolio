---
// The foot of the last scene: on the same dark ground as Contact, small and final.
import { locales, localeMeta, path, tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props { lang: Locale; route: string }
const { lang, route } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="foot" data-tone="dark">
  <p>© {year} · {tr(ui.footer.rights, lang)}</p>
  <ul class="foot__langs" aria-label={tr(ui.nav.language, lang)}>
    {locales.map((l) => (
      <li><a href={path(l, route)} hreflang={l} lang={l} data-lang-link={l} aria-current={l === lang ? 'true' : undefined}>{localeMeta[l].name}</a></li>
    ))}
  </ul>
  <a class="foot__top" href="#main">{tr(ui.footer.top, lang)} <span aria-hidden="true">↑</span></a>
</footer>

<style>
  .foot { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem 2rem; padding: 1.6rem var(--gutter) 2rem; background: #141311; color: #8f887b; font-size: 0.82rem; border-block-start: 1px solid rgb(239 233 220 / 0.1); }
  .foot__langs { display: flex; gap: 1.2rem; }
  .foot__langs a[aria-current='true'] { color: #efe9dc; }
  .foot a:hover { color: #efe9dc; }
</style>
