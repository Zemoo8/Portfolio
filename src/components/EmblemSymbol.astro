---
import { emblemPath } from '../lib/emblem';
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <symbol id="air-emblem" viewBox="-100 -100 200 200"><path d={emblemPath()} /></symbol>
  <!-- the lower half of a circle plus everything above its centre: a head can rise out of a round photograph -->
  <clipPath id="pop" clipPathUnits="objectBoundingBox"><path d="M0 0.5 L0 -1 L1 -1 L1 0.5 A0.5 0.5 0 0 1 0 0.5 Z" /></clipPath>
</svg>
