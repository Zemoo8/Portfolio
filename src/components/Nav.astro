---
// Navigation without a bar. Two corners: the name (home), and the chapter you are in — which is
// itself the button that opens a full-screen index, each chapter with a preview of what is
// there. The corners take the colour of the scene beneath them (light or dark), so they read
// on paper, on the storm and inside the project worlds.
import { locales, localeMeta, path, asset, tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { profile } from '../content/profile';

interface Props { lang: Locale; route: string }
const { lang, route } = Astro.props;
const home = path(lang);
const items = [
  { id: 'work', label: ui.nav.work, preview: 'media/projects/aieyes/ad-film-poster-sm.webp' },
  { id: 'about', label: ui.nav.about, preview: 'media/profile/portrait-color.webp' },
  { id: 'path', label: ui.nav.path, preview: 'media/projects/cheezy/hero-sm.webp' },
  { id: 'credentials', label: ui.nav.credentials, preview: 'media/certificates/nvidia-deep-learning-sm.webp' },
  { id: 'contact', label: ui.nav.contact, preview: 'media/profile/portrait-ink.webp' },
];
---

<header class="corners" data-nav>
  <a class="corners__name" href={home} aria-label={tr(ui.nav.home, lang)}>{tr(profile.name, lang)}</a>
  <div class="corners__right">
    <div class="corners__langs" role="group" aria-label={tr(ui.nav.language, lang)}>
      {locales.map((l) => (
        <a href={path(l, route)} hreflang={l} lang={l} data-lang-link={l} aria-current={l === lang ? 'true' : undefined} title={localeMeta[l].name}>
          <span aria-hidden="true">{localeMeta[l].label}</span><span class="sr-only">{localeMeta[l].name}</span>
        </a>
      ))}
    </div>
    <button class="corners__now" type="button" aria-haspopup="dialog" aria-controls="index" data-index-open>
      <span class="corners__chapter" data-chapter-label data-default={tr(ui.nav.index, lang)}>{tr(ui.nav.index, lang)}</span>
      <span class="corners__lines" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<dialog class="index" id="index" aria-label={tr(ui.nav.index, lang)} data-index>
  <div class="index__inner">
    <nav class="index__list" aria-label="Primary">
      {items.map((it) => (
        <a href={`${home}#${it.id}`} data-index-link data-preview={asset(it.preview)}>{tr(it.label, lang)}</a>
      ))}
    </nav>
    <figure class="index__preview" aria-hidden="true"><img src={asset(items[0].preview)} alt="" loading="lazy" data-index-img /></figure>
    <div class="index__foot">
      <a class="link-u" href={`mailto:${profile.email}`}>{profile.email}</a>
      <a class="link-u" href={profile.links.linkedin} target="_blank" rel="noopener me">LinkedIn</a>
      <a class="link-u" href={profile.links.github} target="_blank" rel="noopener me">GitHub</a>
      <span class="index__langs">
        {locales.map((l) => (
          <a href={path(l, route)} hreflang={l} lang={l} data-lang-link={l} aria-current={l === lang ? 'true' : undefined}>{localeMeta[l].name}</a>
        ))}
      </span>
      <button class="index__motion" type="button" data-motion-toggle aria-pressed="true">{tr(ui.nav.motion, lang)}</button>
    </div>
    <button class="index__close" type="button" data-index-close>{tr(ui.nav.close, lang)}</button>
  </div>
</dialog>

<style>
  .corners {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1.3rem var(--gutter);
    pointer-events: none;
    color: var(--ink);
    transition: color 0.5s var(--ease-out);
  }
  :global(html[data-nav-tone='dark']) .corners { color: var(--cloud); }
  .corners > * { pointer-events: auto; }
  .corners__name { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; letter-spacing: -0.005em; white-space: nowrap; }
  .corners__right { display: flex; align-items: baseline; gap: 1.6rem; }
  .corners__langs { display: flex; gap: 0.8rem; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; }
  .corners__langs a { opacity: 0.72; transition: opacity var(--dur-2); }
  .corners__langs a[lang='ar'] { font-family: var(--font-arabic-display); font-size: 0.95rem; letter-spacing: 0; }
  .corners__langs a:hover, .corners__langs a[aria-current='true'] { opacity: 1; }
  .corners__now { display: inline-flex; align-items: baseline; gap: 0.8rem; font-family: var(--font-display); font-style: italic; font-size: 1.3rem; }
  :lang(ar) .corners__now { font-style: normal; }
  .corners__chapter { transition: opacity 0.35s var(--ease-out), translate 0.35s var(--ease-out); }
  .corners__chapter.is-changing { opacity: 0; translate: 0 -0.3em; }
  .corners__lines { position: relative; inline-size: 1.6rem; block-size: 0.55rem; align-self: center; }
  .corners__lines i { position: absolute; inset-inline: 0; block-size: 1.5px; background: currentColor; transition: inset-inline-start 0.5s var(--ease-out); }
  .corners__lines i:first-child { inset-block-start: 0; }
  .corners__lines i:last-child { inset-block-end: 0; inset-inline-start: 0.5rem; }
  .corners__now:hover .corners__lines i:last-child { inset-inline-start: 0; }

  .index {
    inline-size: 100vw;
    max-inline-size: none;
    block-size: 100dvh;
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper-grain), var(--paper);
    color: var(--ink);
  }
  .index[open] { animation: index-in 0.6s var(--ease-out); }
  @keyframes index-in { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } }
  .index::backdrop { background: transparent; }
  .index__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    gap: 2rem var(--gutter);
    block-size: 100%;
    padding: 5.5rem var(--gutter) 2rem;
  }
  .index__list { display: grid; align-content: center; }
  .index__list a {
    font-family: var(--font-display);
    font-size: clamp(3rem, 1rem + 8vw, 8.5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: var(--ink);
    opacity: 0.35;
    transition: opacity 0.35s var(--ease-out), translate 0.5s var(--ease-out);
    inline-size: fit-content;
  }
  .index__list a:hover, .index__list a:focus-visible { opacity: 1; translate: 0.08em 0; }
  [dir='rtl'] .index__list a:hover, [dir='rtl'] .index__list a:focus-visible { translate: -0.08em 0; }
  .index__list a:nth-child(odd) { font-style: italic; }
  :lang(ar) .index__list a { font-style: normal; font-size: clamp(2.6rem, 1rem + 6vw, 6.5rem); line-height: 1.3; }
  .index__preview { align-self: center; justify-self: center; inline-size: min(100%, 26rem); aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: var(--paper-3); }
  .index__preview img { inline-size: 100%; block-size: 100%; object-fit: cover; transition: opacity 0.3s; }
  .index__foot { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.8rem 2rem; font-size: 0.9rem; color: var(--ink-2); }
  .index__langs { display: flex; gap: 1rem; margin-inline-start: auto; }
  .index__langs a { color: var(--muted); }
  .index__langs a[aria-current='true'] { color: var(--ink); font-weight: 600; }
  .index__motion { font-size: 0.85rem; color: var(--muted); text-decoration: underline; text-underline-offset: 0.3em; }
  .index__close { position: absolute; inset-block-start: 1.3rem; inset-inline-end: var(--gutter); font-family: var(--font-display); font-style: italic; font-size: 1.3rem; }
  @media (max-width: 760px) {
    .index__inner { grid-template-columns: 1fr; }
    .index__preview { display: none; }
    .corners__langs { display: none; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const dialog = document.querySelector<HTMLDialogElement>('[data-index]')!;
  const openBtn = nav.querySelector<HTMLButtonElement>('[data-index-open]')!;
  const label = nav.querySelector<HTMLElement>('[data-chapter-label]')!;
  const img = dialog.querySelector<HTMLImageElement>('[data-index-img]')!;

  openBtn.addEventListener('click', () => { dialog.showModal(); openBtn.setAttribute('aria-expanded', 'true'); });
  dialog.querySelector('[data-index-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => { openBtn.setAttribute('aria-expanded', 'false'); openBtn.focus(); });
  dialog.querySelectorAll<HTMLAnchorElement>('[data-index-link]').forEach((a) => {
    const show = () => { if (img.src !== a.dataset.preview) img.src = a.dataset.preview!; };
    a.addEventListener('pointerenter', show);
    a.addEventListener('focus', show);
    a.addEventListener('click', () => dialog.close());
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((a) =>
    a.addEventListener('click', () => {
      try { localStorage.setItem('lang', a.dataset.langLink!); } catch {}
      if (location.hash) a.href = a.href.split('#')[0] + location.hash;
    }),
  );

  // The scene under the corners decides their colour and the chapter shown.
  const root = document.documentElement;
  let current = '';
  const setChapter = (name: string) => {
    const text = name || label.dataset.default!;
    if (text === current) return;
    current = text;
    label.classList.add('is-changing');
    setTimeout(() => { label.textContent = text; label.classList.remove('is-changing'); }, 220);
  };
  const scenes = [...document.querySelectorAll<HTMLElement>('[data-tone]')];
  if (scenes.length) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const el = e.target as HTMLElement;
        root.dataset.navTone = el.dataset.tone!;
        setChapter(el.dataset.chapterName ?? '');
      }
    }, { rootMargin: '-3% 0px -96% 0px' });
    scenes.forEach((s) => io.observe(s));
  }
</script>
