---
// The header, as a painted masthead rather than a floating pill:
//  · a typographic wordmark — no logo
//  · chapter links numbered like a table of contents; hover paints a brush stroke under the
//    word, and the chapter you are reading keeps its stroke (scroll-spy → aria-current)
//  · the active language sits inside a small brushed ensō
//  · once you scroll, a clean sheet of paper slides in behind it (a soft shadow, no edge line)
import { locales, localeMeta, path, tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { profile } from '../content/profile';

interface Props { lang: Locale; route: string }
const { lang, route } = Astro.props;
const home = path(lang);
const items = [
  { id: 'work', label: ui.nav.work },
  { id: 'about', label: ui.nav.about },
  { id: 'path', label: ui.nav.path },
  { id: 'credentials', label: ui.nav.credentials },
  { id: 'contact', label: ui.nav.contact },
];
---

<header class="nav" data-nav>
  <div class="nav__band" aria-hidden="true"></div>

  <div class="nav__bar">
    <a class="nav__brand" href={home} aria-label={tr(ui.nav.home, lang)}>
      <span class="nav__first">{tr(profile.firstName, lang)}</span>
      <em class="nav__last">{tr(profile.lastName, lang)}</em>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ol>
        {items.map((it, i) => (
          <li>
            <a href={`${home}#${it.id}`} data-spy={it.id}>
              <span class="nav__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="nav__word">{tr(it.label, lang)}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="nav__tools">
      <div class="nav__langs" role="group" aria-label={tr(ui.nav.language, lang)}>
        {locales.map((l) => (
          <a href={path(l, route)} hreflang={l} lang={l} data-lang-link={l} aria-current={l === lang ? 'true' : undefined} title={localeMeta[l].name}>
            <span aria-hidden="true">{localeMeta[l].label}</span>
            <span class="sr-only">{localeMeta[l].name}</span>
          </a>
        ))}
      </div>
      <button class="nav__motion" type="button" data-motion-toggle aria-pressed="true" title={tr(ui.nav.motion, lang)}>
        <span class="sr-only">{tr(ui.nav.motion, lang)}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9h11a3 3 0 1 0-3-3M3 15h15a3 3 0 1 1-3 3M3 12h8" /></svg>
      </button>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="nav__toggle-label" data-open={tr(ui.nav.menu, lang)} data-close={tr(ui.nav.close, lang)}>{tr(ui.nav.menu, lang)}</span>
        <span class="nav__burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="menu" id="mobile-menu" hidden data-menu>
    <nav class="menu__inner" aria-label="Mobile">
      <ol>
        {items.map((it, i) => (
          <li style={`--i:${i}`}>
            <a href={`${home}#${it.id}`} data-menu-link>
              <span class="menu__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="display">{tr(it.label, lang)}</span>
            </a>
          </li>
        ))}
      </ol>
      <div class="menu__foot">
        <div class="menu__langs">
          {locales.map((l) => (
            <a href={path(l, route)} hreflang={l} lang={l} data-lang-link={l} aria-current={l === lang ? 'true' : undefined}>{localeMeta[l].name}</a>
          ))}
        </div>
        <a class="link-u" href={`mailto:${profile.email}`}>{profile.email}</a>
        <button class="menu__motion" type="button" data-motion-toggle aria-pressed="true">{tr(ui.nav.motion, lang)}</button>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 50;
    transition: transform 0.6s var(--ease-out);
  }
  .nav.is-hidden:not(.is-open) { transform: translateY(-120%); }

  /* the paper band that arrives once the page moves */
  .nav__band {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--paper-grain), linear-gradient(180deg, #f8f3e4, var(--paper));
    box-shadow: 0 10px 30px -18px rgb(40 36 30 / 0.35);
    opacity: 0;
    transform: translateY(-105%);
    transition: transform 0.7s var(--ease-out), opacity 0.4s var(--ease-out);
  }
  .nav.is-scrolled .nav__band, .nav.is-open .nav__band { opacity: 1; transform: none; }

  .nav__bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    max-inline-size: var(--max);
    margin-inline: auto;
    padding: 1.15rem var(--gutter) 1rem;
  }

  /* wordmark */
  .nav__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.28em;
    margin-inline-end: auto;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .nav__last { font-style: italic; font-weight: 500; transition: color var(--dur-2); }
  :lang(ar) .nav__last { font-style: normal; color: var(--ink-2); }
  .nav__brand:hover .nav__last { color: var(--rust); }

  /* chapters */
  .nav__links ol { display: flex; gap: clamp(0.9rem, 2.2vw, 2.1rem); }
  .nav__links a { position: relative; display: inline-flex; align-items: baseline; gap: 0.45em; padding-block: 0.5rem; color: var(--ink-2); transition: color var(--dur-2); }
  .nav__num { font-family: var(--font-display); font-style: italic; font-size: 0.88rem; color: var(--rust); }
  .nav__word { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; }
  :lang(ar) .nav__word { font-size: 0.95rem; letter-spacing: 0; text-transform: none; font-weight: 500; }
  .nav__links a::after {
    content: '';
    position: absolute;
    inset-inline: 0 -0.2em;
    inset-block-end: 0.05rem;
    block-size: 0.5rem;
    background: currentColor;
    -webkit-mask: url('/ink/under.png') center / 100% 100% no-repeat;
    mask: url('/ink/under.png') center / 100% 100% no-repeat;
    clip-path: inset(-50% 100% -50% 0);
    transition: clip-path 0.7s var(--ease-out);
  }
  [dir='rtl'] .nav__links a::after { clip-path: inset(-50% 0 -50% 100%); }
  .nav__links a:hover, .nav__links a[aria-current] { color: var(--ink); }
  .nav__links a:hover::after, .nav__links a[aria-current]::after { clip-path: inset(-50% 0 -50% 0); }

  .nav__tools { display: flex; align-items: center; gap: 0.6rem; }

  /* languages: the current one inside a brushed ensō */
  .nav__langs { display: flex; gap: 0.2rem; }
  .nav__langs a {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 2.3rem;
    block-size: 2.3rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
    transition: color var(--dur-2);
  }
  .nav__langs a[lang='ar'] { font-family: var(--font-arabic-display); font-size: 1rem; letter-spacing: 0; }
  .nav__langs a::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--rust);
    -webkit-mask: url('/ink/ring.png') center / contain no-repeat;
    mask: url('/ink/ring.png') center / contain no-repeat;
    opacity: 0;
    transform: rotate(-40deg) scale(0.8);
    transition: opacity 0.5s var(--ease-out), transform 0.8s var(--ease-out);
  }
  .nav__langs a:hover, .nav__langs a[aria-current='true'] { color: var(--ink); }
  .nav__langs a[aria-current='true']::before { opacity: 1; transform: none; }
  .nav__langs a:hover:not([aria-current])::before { opacity: 0.35; transform: none; }

  .nav__motion { display: grid; place-items: center; inline-size: 2.3rem; block-size: 2.3rem; color: var(--ink-2); transition: color var(--dur-1); }
  .nav__motion:hover { color: var(--rust); }
  .nav__motion svg { inline-size: 1.15rem; block-size: 1.15rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .nav__motion[aria-pressed='false'] { color: var(--muted); }
  .nav__motion[aria-pressed='false'] svg { opacity: 0.45; }

  /* phone: the word "Menu" over two brush strokes */
  .nav__toggle { display: none; align-items: center; gap: 0.7rem; padding: 0.4rem 0.2rem; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; }
  :lang(ar) .nav__toggle { letter-spacing: 0; font-size: 0.95rem; }
  .nav__burger { position: relative; inline-size: 1.7rem; block-size: 0.75rem; }
  .nav__burger i {
    position: absolute;
    inset-inline: 0;
    block-size: 0.42rem;
    background: currentColor;
    -webkit-mask: url('/ink/under.png') center / 100% 100% no-repeat;
    mask: url('/ink/under.png') center / 100% 100% no-repeat;
    transition: transform var(--dur-2) var(--ease-out), inset var(--dur-2) var(--ease-out);
  }
  .nav__burger i:first-child { inset-block-start: -0.15rem; }
  .nav__burger i:last-child { inset-block-start: 0.5rem; inset-inline-start: 0.35rem; }
  .is-open .nav__burger i:first-child { inset-block-start: 0.16rem; transform: rotate(35deg); }
  .is-open .nav__burger i:last-child { inset-block-start: 0.16rem; inset-inline-start: 0; transform: rotate(-35deg); }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: var(--paper-grain), var(--paper);
    padding: 6.5rem var(--gutter) 2rem;
    overflow-y: auto;
  }
  .menu__inner { display: flex; flex-direction: column; justify-content: space-between; min-block-size: 100%; gap: 3rem; }
  .menu ol { display: grid; gap: 0.4rem; }
  .menu ol a { display: flex; align-items: baseline; gap: 1rem; padding-block: 0.25rem; }
  .menu__num { font-family: var(--font-display); font-style: italic; font-size: 1.2rem; color: var(--rust); }
  .menu ol .display { font-size: clamp(2.6rem, 12vw, 4.2rem); }
  .menu li { opacity: 0; transform: translateY(16px); }
  .is-open .menu li { opacity: 1; transform: none; transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out); transition-delay: calc(80ms + var(--i) * 55ms); }
  .menu__foot { display: grid; gap: 1.2rem; color: var(--ink-2); }
  .menu__langs { display: flex; gap: 1.2rem; color: var(--muted); }
  .menu__langs a[aria-current='true'] { color: var(--ink); font-weight: 600; }
  .menu__motion { justify-self: start; padding-block: 0.4rem; font-size: 0.85rem; text-decoration: underline; text-underline-offset: 0.3em; text-decoration-color: var(--line-strong); }
  .menu__motion[aria-pressed='false'] { color: var(--muted); }

  @media (max-width: 1100px) { .nav__num { display: none; } }
  @media (max-width: 1020px) {
    .nav__links, .nav__langs { display: none; }
    .nav__toggle { display: inline-flex; }
  }
  @media (max-width: 420px) { .nav__brand { font-size: 1.25rem; } .nav__motion { display: none; } }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const toggle = nav.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = nav.querySelector<HTMLElement>('[data-menu]')!;
  const label = toggle.querySelector<HTMLElement>('.nav__toggle-label')!;

  const setOpen = (open: boolean) => {
    nav.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? label.dataset.close! : label.dataset.open!;
    document.documentElement.style.overflow = open ? 'hidden' : '';
    menu.hidden = !open;
    if (open) menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
  };
  toggle.addEventListener('click', () => setOpen(!nav.classList.contains('is-open')));
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav.classList.contains('is-open')) { setOpen(false); toggle.focus(); }
  });
  matchMedia('(min-width: 1021px)').addEventListener('change', (e) => e.matches && setOpen(false));

  document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((a) =>
    a.addEventListener('click', () => {
      try { localStorage.setItem('lang', a.dataset.langLink!); } catch {}
      if (location.hash) a.href = a.href.split('#')[0] + location.hash;
    }),
  );

  // paper band once the page moves; hide on the way down, return on the way up
  let last = scrollY;
  const onScroll = () => {
    const y = scrollY;
    nav.classList.toggle('is-scrolled', y > 40);
    nav.classList.toggle('is-hidden', y > 500 && y > last + 2);
    last = y;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // scroll-spy: the chapter in view keeps its brush stroke
  const links = new Map([...nav.querySelectorAll<HTMLAnchorElement>('[data-spy]')].map((a) => [a.dataset.spy!, a]));
  const sections = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (sections.length) {
    const spy = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a, id) => (id === e.target.id ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
      }
    }, { rootMargin: '-45% 0px -50% 0px' });
    sections.forEach((s) => spy.observe(s));
  }
</script>
