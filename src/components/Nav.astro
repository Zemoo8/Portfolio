---
// Navigation as a hanging scroll. On wide screens a slim paper scroll hangs down the edge of the
// page (the right edge; the left in Arabic) with the chapters written across it, one under another. An ink line runs
// down the rod as you read and reaches each chapter's name exactly when that chapter begins; the
// chapter you are in is inked with a brush swash. Each stretch of the line is a CSS scroll-driven
// animation whose range is the scroll distance of its chapter — measured on load and on resize,
// nothing runs per frame. The languages sit at the foot of the scroll.
// On narrower screens the scroll rolls up into its title slip in the corner (the chapter you are
// in; it opens the full-screen index) and the ink line runs down the very edge of the screen.
// The name, top-left, is always home.
import { locales, localeMeta, path, asset, tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { profile } from '../content/profile';

interface Props { lang: Locale; route: string }
const { lang, route } = Astro.props;
const home = path(lang);
const chapters = [
  { id: 'work', label: ui.nav.work, preview: 'media/projects/aieyes/ad-film-poster-sm.webp' },
  { id: 'about', label: ui.nav.about, preview: 'media/profile/portrait-color.webp' },
  { id: 'path', label: ui.nav.path, preview: 'media/projects/cheezy/hero-sm.webp' },
  { id: 'credentials', label: ui.nav.credentials, preview: 'media/certificates/nvidia-deep-learning-sm.webp' },
  { id: 'contact', label: ui.nav.contact, preview: 'media/profile/portrait-ink.webp' },
];
// a case study is read inside the Work chapter
const within = route.startsWith('work/') ? 'work' : undefined;
---

<header class="masthead" data-nav data-within={within}>
  <a class="masthead__name" href={home} aria-label={tr(ui.nav.home, lang)}>{tr(profile.name, lang)}</a>

  <nav class="rod" aria-label={tr(ui.nav.chapters, lang)}>
    <span class="rod__roller" aria-hidden="true"></span>
    <span class="rod__seg" aria-hidden="true" data-seg><i></i></span>
    {chapters.map((c) => (
      <Fragment>
        <a class="rod__ch" href={`${home}#${c.id}`} data-rod-link={c.id} data-state="future">{tr(c.label, lang)}</a>
        <span class="rod__seg" aria-hidden="true" data-seg><i></i></span>
      </Fragment>
    ))}
    <ul class="rod__langs" aria-label={tr(ui.nav.language, lang)}>
      {locales.map((l) => (
        <li>
          <a href={path(l, route)} hreflang={l} lang={l} data-lang-link={l} aria-current={l === lang ? 'true' : undefined}>
            <span aria-hidden="true">{localeMeta[l].label}</span><span class="sr-only">{localeMeta[l].name}</span>
          </a>
        </li>
      ))}
    </ul>
    <span class="rod__roller rod__roller--foot" aria-hidden="true"></span>
  </nav>

  <button class="slip" type="button" aria-haspopup="dialog" aria-controls="index" data-index-open>
    <span class="slip__roller" aria-hidden="true"></span>
    <span class="slip__label" data-chapter-label data-default={tr(ui.nav.index, lang)}>{tr(ui.nav.index, lang)}</span>
  </button>
  <span class="edge" aria-hidden="true"><span class="rod__seg" data-edge><i></i></span></span>
</header>

<dialog class="index" id="index" aria-label={tr(ui.nav.index, lang)} data-index>
  <div class="index__inner">
    <nav class="index__list" aria-label="Primary">
      {chapters.map((it) => (
        <a href={`${home}#${it.id}`} data-index-link data-preview={asset(it.preview)}>{tr(it.label, lang)}</a>
      ))}
    </nav>
    <figure class="index__preview" aria-hidden="true"><img src={asset(chapters[0].preview)} alt="" loading="lazy" data-index-img /></figure>
    <div class="index__foot">
      <a class="link-u" href={`mailto:${profile.email}`}>{profile.email}</a>
      <a class="link-u" href={profile.links.linkedin} target="_blank" rel="noopener me">LinkedIn</a>
      <a class="link-u" href={profile.links.github} target="_blank" rel="noopener me">GitHub</a>
      <span class="index__langs">
        {locales.map((l) => (
          <a href={path(l, route)} hreflang={l} lang={l} data-lang-link={l} aria-current={l === lang ? 'true' : undefined}>{localeMeta[l].name}</a>
        ))}
      </span>
      <button class="index__motion" type="button" data-motion-toggle aria-pressed="true">{tr(ui.nav.motion, lang)}</button>
    </div>
    <button class="index__close" type="button" data-index-close>{tr(ui.nav.close, lang)}</button>
  </div>
</dialog>

<style>
  .masthead__name {
    position: fixed;
    z-index: 50;
    inset-block-start: 1.3rem;
    inset-inline-start: var(--gutter);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    white-space: nowrap;
    color: var(--ink);
    transition: color 0.5s var(--ease-out);
  }
  :global(html[data-nav-tone='dark']) .masthead__name { color: var(--cloud); }

  /* ---- the ink line: a dry brush stroke, inked from the top as its stretch is read ---------- */
  .rod__seg {
    position: relative;
    display: block;
    background: rgb(110 106 98 / 0.3);
    -webkit-mask: url('/ink/rod.png') center / 100% 100% no-repeat;
    mask: url('/ink/rod.png') center / 100% 100% no-repeat;
  }
  .rod__seg i { position: absolute; inset: 0; background: var(--ink); transform-origin: 50% 0; scale: 1 0; }
  @supports (animation-timeline: scroll()) {
    .rod__seg i { animation: rod-fill linear both; }
    /* the timeline in its own, more specific rule — minifiers fold it into the shorthand otherwise */
    .masthead .rod__seg > i { animation-timeline: scroll(root block); }
    .masthead .rod__seg[data-full] > i { animation: none; scale: 1 1; }
  }
  @supports not (animation-timeline: scroll()) {
    .rod__seg i { transition: scale 0.8s var(--ease-out); }
    .rod__seg[data-past] i { scale: 1 1; }
  }
  @keyframes rod-fill { from { scale: 1 0; } to { scale: 1 1; } }

  /* ---- wide screens: the hanging scroll ---------------------------------------------------- */
  .rod, .slip, .edge { display: none; }
  @media (min-width: 1100px) and (min-height: 620px) {
    .rod {
      position: fixed;
      z-index: 50;
      inset-block: 1rem;
      inset-inline-end: 0.8rem;
      inline-size: var(--rod-w);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-block: 0.9rem 1rem;
      background: var(--paper-grain), linear-gradient(90deg, #ece3cd, #f8f3e5 12%, #f7f1e3 88%, #e9dfc7);
      box-shadow: 0 22px 44px -26px rgb(40 36 30 / 0.6), 0 2px 6px -3px rgb(40 36 30 / 0.25);
    }
    /* the mounting: a hairline of saffron silk just inside each long edge */
    .rod::before {
      content: '';
      position: absolute;
      inset-block: 0;
      inset-inline: 3px;
      border-inline: 1px solid transparent;
      border-image: linear-gradient(180deg, var(--saffron), var(--amber) 60%, var(--rust)) 1;
      opacity: 0.4;
      pointer-events: none;
    }
    .rod__roller {
      position: absolute;
      inset-block-start: -0.3rem;
      inset-inline: -0.45rem;
      block-size: 0.62rem;
      background: var(--ink);
      -webkit-mask: url('/ink/roller.png') center / 100% 100% no-repeat;
      mask: url('/ink/roller.png') center / 100% 100% no-repeat;
    }
    .rod__roller--foot { inset-block: auto -0.34rem; inset-inline: -0.55rem; block-size: 0.7rem; }

    .rod > .rod__seg { flex: 1 1 0; min-block-size: 0.8rem; inline-size: 5px; margin-block: 0.55rem; }
    .rod__roller + .rod__seg { margin-block-start: 0.2rem; }
  }

  /* a chapter, written across the scroll; the one you are in sits on a swash of ink */
  .rod__ch {
    position: relative;
    isolation: isolate;
    flex: none;
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--muted);
    transition: color 0.5s var(--ease-out);
  }
  :lang(ar) .rod__ch { font-size: 1.08rem; line-height: 1.5; letter-spacing: 0; }
  .rod__ch[data-state='past'] { color: var(--ink-2); }
  .rod__ch::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -0.5em -0.72em;
    background: var(--ink);
    opacity: 0;
    /* the swash, revealed by a soft-edged wash that travels along the stroke: it paints itself */
    -webkit-mask: url('/ink/swash.png') center / 100% 100% no-repeat, linear-gradient(90deg, #000 40%, transparent 60%) 100% 0 / 260% 100% no-repeat;
    -webkit-mask-composite: source-in;
    mask: url('/ink/swash.png') center / 100% 100% no-repeat, linear-gradient(90deg, #000 40%, transparent 60%) 100% 0 / 260% 100% no-repeat;
    mask-composite: intersect;
    transition: opacity 0.45s var(--ease-out), -webkit-mask-position 0.9s var(--ease-out), mask-position 0.9s var(--ease-out);
  }
  /* in Arabic the brush travels right to left */
  [dir='rtl'] .rod__ch::before { scale: -1 1; }
  .rod__ch:hover { color: var(--ink); }
  .rod__ch:hover::before { opacity: 0.13; -webkit-mask-position: center, 0 0; mask-position: center, 0 0; }
  .rod__ch[aria-current] { color: var(--paper); font-style: italic; }
  :lang(ar) .rod__ch[aria-current] { font-style: normal; }
  .rod__ch[aria-current]::before { opacity: 1; -webkit-mask-position: center, 0 0; mask-position: center, 0 0; }

  .rod__langs { display: flex; gap: 0.1rem; justify-content: center; margin-block-start: 0.1rem; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.08em; }
  .rod__langs a { position: relative; display: grid; place-items: center; inline-size: 1.85rem; block-size: 1.85rem; color: var(--muted); transition: color var(--dur-2); }
  .rod__langs a[lang='ar'] { font-family: var(--font-arabic-display); font-size: 0.95rem; letter-spacing: 0; }
  .rod__langs a:hover { color: var(--ink); }
  .rod__langs a[aria-current='true'] { color: var(--ink); }
  .rod__langs a[aria-current='true']::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--rust);
    -webkit-mask: url('/ink/ring.png') center / contain no-repeat;
    mask: url('/ink/ring.png') center / contain no-repeat;
  }

  /* ---- narrower screens: the scroll rolled up to its title slip ---------------------------- */
  @media (max-width: 1099.98px), (max-height: 619.98px) {
    .slip {
      position: fixed;
      z-index: 50;
      inset-block-start: 0.9rem;
      inset-inline-end: 0.75rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0.6rem 0.85rem 0.5rem;
      background: var(--paper-grain), linear-gradient(90deg, #ece3cd, #f8f3e5 14%, #f7f1e3 86%, #e9dfc7);
      box-shadow: 0 16px 30px -18px rgb(40 36 30 / 0.6), 0 2px 5px -3px rgb(40 36 30 / 0.25);
      color: var(--ink);
    }
    .slip__roller {
      position: absolute;
      inset-block-start: -0.28rem;
      inset-inline: -0.35rem;
      block-size: 0.56rem;
      background: var(--ink);
      -webkit-mask: url('/ink/roller.png') center / 100% 100% no-repeat;
      mask: url('/ink/roller.png') center / 100% 100% no-repeat;
    }
    .slip__label {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 600;
      font-style: italic;
      line-height: 1.25;
      white-space: nowrap;
      transition: opacity 0.35s var(--ease-out), translate 0.35s var(--ease-out);
    }
    :lang(ar) .slip__label { font-style: normal; line-height: 1.5; }
    .slip__label.is-changing { opacity: 0; translate: 0 -0.3em; }

    .edge { display: block; position: fixed; z-index: 49; inset-block: 0; inset-inline-end: 0.18rem; inline-size: 4px; pointer-events: none; }
    .edge .rod__seg { block-size: 100%; }
    :global(html[data-nav-tone='dark']) .edge .rod__seg { background: rgb(238 240 236 / 0.22); }
    :global(html[data-nav-tone='dark']) .edge .rod__seg i { background: var(--cloud); }
  }

  /* ---- the full-screen index (narrow screens) ----------------------------------------------- */
  .index {
    inline-size: 100vw;
    max-inline-size: none;
    block-size: 100dvh;
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper-grain), var(--paper);
    color: var(--ink);
  }
  .index[open] { animation: index-in 0.6s var(--ease-out); }
  @keyframes index-in { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } }
  .index::backdrop { background: transparent; }
  .index__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    gap: 2rem var(--gutter);
    block-size: 100%;
    padding: 5.5rem var(--gutter) 2rem;
  }
  .index__list { display: grid; align-content: center; }
  .index__list a {
    font-family: var(--font-display);
    font-size: clamp(3rem, 1rem + 8vw, 8.5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: var(--ink);
    opacity: 0.35;
    transition: opacity 0.35s var(--ease-out), translate 0.5s var(--ease-out);
    inline-size: fit-content;
  }
  .index__list a:hover, .index__list a:focus-visible { opacity: 1; translate: 0.08em 0; }
  [dir='rtl'] .index__list a:hover, [dir='rtl'] .index__list a:focus-visible { translate: -0.08em 0; }
  .index__list a:nth-child(odd) { font-style: italic; }
  :lang(ar) .index__list a { font-style: normal; font-size: clamp(2.6rem, 1rem + 6vw, 6.5rem); line-height: 1.3; }
  .index__preview { align-self: center; justify-self: center; inline-size: min(100%, 26rem); aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: var(--paper-3); }
  .index__preview img { inline-size: 100%; block-size: 100%; object-fit: cover; transition: opacity 0.3s; }
  .index__foot { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.8rem 2rem; font-size: 0.9rem; color: var(--ink-2); }
  .index__langs { display: flex; gap: 1rem; margin-inline-start: auto; }
  .index__langs a { color: var(--muted); }
  .index__langs a[aria-current='true'] { color: var(--ink); font-weight: 600; }
  .index__motion { font-size: 0.85rem; color: var(--muted); text-decoration: underline; text-underline-offset: 0.3em; }
  .index__close { position: absolute; inset-block-start: 1.3rem; inset-inline-end: var(--gutter); font-family: var(--font-display); font-style: italic; font-size: 1.3rem; }
  @media (max-width: 760px) {
    .index__inner { grid-template-columns: 1fr; }
    .index__preview { display: none; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const dialog = document.querySelector<HTMLDialogElement>('[data-index]')!;
  const openBtn = nav.querySelector<HTMLButtonElement>('[data-index-open]')!;
  const label = nav.querySelector<HTMLElement>('[data-chapter-label]')!;
  const img = dialog.querySelector<HTMLImageElement>('[data-index-img]')!;

  openBtn.addEventListener('click', () => { dialog.showModal(); openBtn.setAttribute('aria-expanded', 'true'); });
  dialog.querySelector('[data-index-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => { openBtn.setAttribute('aria-expanded', 'false'); openBtn.focus(); });
  dialog.querySelectorAll<HTMLAnchorElement>('[data-index-link]').forEach((a) => {
    const show = () => { if (img.src !== a.dataset.preview) img.src = a.dataset.preview!; };
    a.addEventListener('pointerenter', show);
    a.addEventListener('focus', show);
    a.addEventListener('click', () => dialog.close());
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((a) =>
    a.addEventListener('click', () => {
      try { localStorage.setItem('lang', a.dataset.langLink!); } catch {}
      if (location.hash) a.href = a.href.split('#')[0] + location.hash;
    }),
  );

  // ---- where you are ------------------------------------------------------------------------
  const root = document.documentElement;
  const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-rod-link]')];
  const ids = links.map((a) => a.dataset.rodLink!);
  const segs = [...nav.querySelectorAll<HTMLElement>('[data-seg]')];
  const within = nav.dataset.within ?? '';

  let current = -2;
  const setCurrent = (i: number) => {
    if (i === current) return;
    current = i;
    links.forEach((a, k) => {
      if (k === i) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
      a.dataset.state = k < i ? 'past' : k === i ? 'current' : 'future';
    });
    segs.forEach((s, k) => s.toggleAttribute('data-past', k <= i));
    const text = i >= 0 ? links[i].textContent!.trim() : label.dataset.default!;
    if (label.textContent === text) return;
    label.classList.add('is-changing');
    setTimeout(() => { label.textContent = text; label.classList.remove('is-changing'); }, 220);
  };

  // Every scene belongs to the last chapter that began before it (the hero to none; the
  // capabilities and GitHub scenes to Credentials; a case study to Work).
  const scenes = [...document.querySelectorAll<HTMLElement>('[data-tone]')];
  const owner = new Map<Element, number>();
  let last = ids.indexOf(within);
  for (const s of scenes) {
    if (ids.includes(s.id)) last = ids.indexOf(s.id);
    owner.set(s, last);
  }
  let atBand: HTMLElement | undefined;
  let atEnd = false;
  const apply = () => {
    if (atEnd && scenes.length) {
      setCurrent(owner.get(scenes[scenes.length - 1])!);
      return;
    }
    if (!atBand) return;
    root.dataset.navTone = atBand.dataset.tone!;
    setCurrent(owner.get(atBand)!);
  };
  if (scenes.length) {
    const band = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) atBand = e.target as HTMLElement;
      apply();
    }, { rootMargin: '-3% 0px -96% 0px' });
    scenes.forEach((s) => band.observe(s));
    // a last chapter shorter than the screen never reaches the top: the foot of the page counts
    const end = document.createElement('div');
    end.setAttribute('aria-hidden', 'true');
    end.style.cssText = 'block-size:1px;margin-block-start:-1px';
    document.body.append(end);
    new IntersectionObserver(([e]) => { atEnd = e.isIntersecting && scrollY > 0; apply(); }, { rootMargin: '0px 0px 48px 0px' }).observe(end);
  }

  // ---- the ink line: each stretch is inked over its own chapter's scroll distance ------------
  const layout = () => {
    const max = Math.max(1, root.scrollHeight - innerHeight);
    const lead = innerHeight * 0.04; // the chapter begins as it reaches the band near the top
    const starts = ids.map((id, k) => {
      if (within) return k <= ids.indexOf(within) ? 0 : max;
      const el = document.getElementById(id);
      return el ? Math.min(max, Math.max(0, el.getBoundingClientRect().top + scrollY - lead)) : max;
    });
    const stops = [0, ...starts, max];
    segs.forEach((s, k) => {
      const a = stops[k];
      const b = Math.max(stops[k + 1], a + 1);
      s.toggleAttribute('data-full', stops[k + 1] <= 0);
      (s.firstElementChild as HTMLElement).style.setProperty('animation-range', `${Math.round(a)}px ${Math.round(b)}px`);
    });
  };
  let queued = 0;
  const relayout = () => { cancelAnimationFrame(queued); queued = requestAnimationFrame(layout); };
  relayout();
  new ResizeObserver(relayout).observe(document.body);
  addEventListener('load', relayout, { once: true });
  document.fonts?.ready.then(relayout);
</script>
