---
// The introduction scene: one large circle — the same painting that sits inside the "o" of the
// name, which travels here as you scroll (scripts/travel.ts) — and around it only a sentence and
// the choice of language. The three personal films play inside the circle once they exist:
//   public/media/intros/intro-<lang>.mp4   (+ optional .vtt; poster: intro-<lang>-poster.webp)
// Detected at build time; missing films are never requested. See docs/README.md → "Intro films".
import { locales, localeMeta, asset, tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { exists } from '../lib/media';

interface Props { lang: Locale }
const { lang } = Astro.props;
const base = asset('media/intros');
const files = Object.fromEntries(
  locales.map((l) => [l, { mp4: exists(`media/intros/intro-${l}.mp4`), webm: false, vtt: exists(`media/intros/intro-${l}.vtt`), poster: exists(`media/intros/intro-${l}-poster.webp`) }]),
);
---

<figure class="gate" data-intro data-base={base} data-lang={lang} data-files={JSON.stringify(files)}>
  <div class="gate__window" data-intro-window>
    <img class="gate__view" src={asset('art/gate.webp')} alt="" width="900" height="900" loading="lazy" />
    <video class="gate__video" muted playsinline loop preload="none" hidden data-intro-video></video>
    <div class="gate__controls" hidden data-intro-controls>
      <button type="button" data-intro-sound data-on={tr(ui.intro.sound, lang)} data-off={tr(ui.intro.mute, lang)}>{tr(ui.intro.sound, lang)}</button>
      <button type="button" data-intro-cc aria-pressed="false" hidden>{tr(ui.intro.captions, lang)}</button>
      <button type="button" data-intro-replay>{tr(ui.intro.replay, lang)}</button>
    </div>
  </div>

  <figcaption class="gate__caption">
    <p class="gate__note">{tr(ui.intro.pendingNote, lang)}</p>
    <p class="gate__state" data-intro-placeholder>{tr(ui.intro.pending, lang)}</p>
    <div class="gate__tabs" role="tablist" aria-label={tr(ui.intro.choose, lang)}>
      {locales.map((l) => (
        <button type="button" role="tab" lang={l} aria-selected={l === lang ? 'true' : 'false'} data-intro-tab={l}>{localeMeta[l].name}</button>
      ))}
    </div>
  </figcaption>
</figure>

<style>
  .gate {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: end;
    gap: 2rem 4vw;
    inline-size: 100%;
  }
  .gate__window {
    grid-column: 2;
    position: relative;
    inline-size: min(74vh, 86vw);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: #e9e4d6;
    isolation: isolate;
  }
  :global(.o-travelling) .gate__window { visibility: hidden; }
  .gate__view, .gate__video { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }
  .gate__view { object-position: 50% 62%; opacity: 0.85; }
  .gate__video { z-index: 2; }
  .gate__controls { position: absolute; inset-block-end: 9%; inset-inline: 0; z-index: 3; display: flex; justify-content: center; gap: 1.2rem; }
  .gate__controls[hidden] { display: none; }
  .gate__controls button { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--paper); text-shadow: 0 1px 8px rgb(0 0 0 / 0.6); text-decoration: underline; text-underline-offset: 0.4em; }
  .gate__controls button[aria-pressed='true'] { color: var(--amber); }

  .gate__caption { grid-column: 1; grid-row: 1; align-self: end; display: grid; gap: 1.2rem; justify-items: start; padding-block-end: 8%; }
  .gate__note { font-family: var(--font-display); font-style: italic; font-size: clamp(1.3rem, 1rem + 0.9vw, 1.9rem); line-height: 1.2; max-inline-size: 18rem; }
  :lang(ar) .gate__note { font-style: normal; line-height: 1.7; font-size: 1.2rem; }
  .gate__state { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--rust); }
  :lang(ar) .gate__state { letter-spacing: 0; font-size: 0.9rem; }
  .gate__state[hidden] { display: none; }
  .gate__tabs { display: flex; flex-direction: column; gap: 0.3rem; }
  .gate__tabs button { position: relative; padding-block: 0.15rem; font-family: var(--font-display); font-size: 1.25rem; color: var(--muted); text-align: start; transition: color var(--dur-2), translate var(--dur-2) var(--ease-out); }
  .gate__tabs button[lang='ar'] { font-family: var(--font-arabic-display); }
  .gate__tabs button:hover { color: var(--ink); }
  .gate__tabs button[aria-selected='true'] { color: var(--ink); translate: 0.4em 0; }
  [dir='rtl'] .gate__tabs button[aria-selected='true'] { translate: -0.4em 0; }
  .gate__tabs button[aria-selected='true']::before { content: '—'; position: absolute; inset-inline-end: 100%; margin-inline-end: 0.3em; color: var(--rust); }

  @media (max-width: 860px) {
    .gate { grid-template-columns: 1fr; justify-items: center; }
    .gate__window { grid-column: 1; }
    .gate__caption { grid-column: 1; grid-row: 2; justify-items: center; text-align: center; padding: 0; }
    .gate__tabs { flex-direction: row; gap: 1.4rem; }
    .gate__tabs button[aria-selected='true'] { translate: none; text-decoration: underline; text-underline-offset: 0.3em; }
    .gate__tabs button[aria-selected='true']::before { content: none; }
  }
</style>

<script>
  import { initIntro } from '../scripts/intro';
  document.querySelectorAll<HTMLElement>('[data-intro]').forEach(initIntro);
</script>
