---
// The moon gate: a painted ensō around a round window in which the air emblem turns over the
// misty temple. The gate is a button: it opens the intro film in a gust of wind (scripts/gust.ts)
// — the storm tears out of the gate, fills the screen, and the film's screen is blown in.
// The three personal intro films (EN / FR / AR) are detected at build time:
//   public/media/intros/intro-<lang>.mp4   (+ optional .webm, .vtt; poster: intro-<lang>-poster.webp)
// Until a film exists, the stage says it is in production; missing films are never requested.
// Adding a file and rebuilding/redeploying is all it takes. See docs/README.md → "Intro films".
import Brush from './Brush.astro';
import Emblem from './Emblem.astro';
import { locales, localeMeta, asset, tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { exists } from '../lib/media';

interface Props { lang: Locale }
const { lang } = Astro.props;
const base = asset('media/intros');
const files = Object.fromEntries(
  locales.map((l) => [l, { mp4: exists(`media/intros/intro-${l}.mp4`), webm: exists(`media/intros/intro-${l}.webm`), vtt: exists(`media/intros/intro-${l}.vtt`), poster: exists(`media/intros/intro-${l}-poster.webp`) }]),
);
// Once a film exists, the gate says so: a brushed arrow and a play seal invite the click.
const hasFilm = files[lang].mp4 || files[lang].webm;
---

<figure class="gate" data-intro data-base={base} data-lang={lang} data-files={JSON.stringify(files)} data-has-film={hasFilm ? '' : undefined}>
  <div class="gate__frame">
    {hasFilm && (
      <p class="gate__hint" aria-hidden="true">
        <span class="gate__hint-text">{tr(ui.intro.hint, lang)} <em>· {tr(ui.intro.length, lang)}</em></span>
        <svg class="gate__hint-arrow" viewBox="0 0 120 96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <filter id="gate-hint-ink" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.06 0.3" numOctaves="2" seed="4" /><feDisplacementMap in="SourceGraphic" scale="2.2" xChannelSelector="R" yChannelSelector="G" /></filter>
          <g filter="url(#gate-hint-ink)">
            <path class="gate__hint-stroke" d="M10 10 C 44 8, 86 20, 98 70" stroke-width="3.2" pathLength="1" />
            <path class="gate__hint-head" d="M84 60 L 99 76 L 108 55" stroke-width="3" pathLength="1" />
          </g>
        </svg>
      </p>
    )}
    {hasFilm && <span class="gate__pulse" aria-hidden="true"></span>}
    <Brush kind="circle" seed={7} class="gate__enso" />
    <button class="gate__window" type="button" aria-haspopup="dialog" aria-controls="gust" aria-expanded="false" aria-label={tr(ui.intro.open, lang)} data-gust-open>
      <img class="gate__view" src={asset('art/gate.webp')} alt="" width="900" height="900" fetchpriority="high" loading="eager" />
      <span class="gate__mist" aria-hidden="true"></span>
      <span class="gate__air" aria-hidden="true"><Emblem class="gate__emblem" spin /></span>
      {hasFilm && (
        <span class="gate__seal" aria-hidden="true">
          <svg viewBox="0 0 16 16"><path d="M5 3.2 L 13 8 L 5 12.8 Z" fill="currentColor" /></svg>
          {tr(ui.intro.play, lang)}
        </span>
      )}
    </button>
  </div>

  <figcaption class="gate__caption">
    <p class="gate__tag-line" data-intro-placeholder>{tr(ui.intro.label, lang)} <span>· {tr(ui.intro.pending, lang)}</span></p>
    <p class="gate__note">{tr(ui.intro.pendingNote, lang)}</p>
    <div class="gate__tabs" role="tablist" aria-label={tr(ui.intro.choose, lang)}>
      {locales.map((l) => (
        <button type="button" role="tab" lang={l} aria-selected={l === lang ? 'true' : 'false'} data-intro-tab={l}>{localeMeta[l].name}</button>
      ))}
    </div>
  </figcaption>

  <dialog class="gust" id="gust" aria-label={tr(ui.intro.label, lang)} data-gust>
    <canvas class="gust__air" aria-hidden="true" data-gust-air></canvas>
    <div class="gust__stage">
      <div class="gust__language">
        <span>{tr(ui.intro.choose, lang)}</span>
        <div class="gate__tabs" role="tablist" aria-label={tr(ui.intro.choose, lang)}>
          {locales.map((l) => (
            <button type="button" role="tab" lang={l} aria-selected={l === lang ? 'true' : 'false'} data-intro-tab={l}>{localeMeta[l].name}</button>
          ))}
        </div>
      </div>
      <div class="gust__screen">
        <video class="gust__video" playsinline preload="none" hidden data-intro-video></video>
        <p class="gust__cc" hidden data-intro-cc-text><span></span></p>
        <div class="gust__soon" data-intro-placeholder>
          <Emblem class="gust__emblem" spin />
          <p class="gust__kicker">{tr(ui.intro.label, lang)}</p>
          <p class="gust__title">{tr(ui.intro.soon, lang)}</p>
          <p class="gust__note">{tr(ui.intro.pendingNote, lang)} <span>{tr(ui.intro.pending, lang)}.</span></p>
        </div>
      </div>
      <div class="gust__controls" hidden data-intro-controls>
        <button type="button" data-intro-pause data-pause={tr(ui.intro.pause, lang)} data-resume={tr(ui.intro.resume, lang)}>{tr(ui.intro.pause, lang)}</button>
        <button type="button" data-intro-sound data-on={tr(ui.intro.sound, lang)} data-off={tr(ui.intro.mute, lang)}>{tr(ui.intro.mute, lang)}</button>
        <button type="button" data-intro-cc aria-pressed="false" hidden>{tr(ui.intro.captions, lang)}</button>
        <button type="button" data-intro-replay>{tr(ui.intro.replay, lang)}</button>
      </div>
    </div>
    <button class="ibtn ibtn--close gust__close" type="button" aria-label={tr(ui.nav.close, lang)} data-gust-close></button>
  </dialog>
</figure>

<style>
  .gate { display: grid; justify-items: center; gap: 1.6rem; }
  .gate__frame { position: relative; inline-size: min(100%, 34rem); aspect-ratio: 1; display: grid; place-items: center; }
  .gate__frame :global(.gate__enso) { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; z-index: 2; pointer-events: none; transition: rotate 1.4s var(--ease-out); }
  .gate__window {
    position: relative;
    display: block;
    inline-size: 84%;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 50%;
    overflow: hidden;
    background: var(--mist);
    box-shadow: inset 0 0 0 1px rgb(31 29 26 / 0.12), inset 0 20px 60px -30px rgb(31 29 26 / 0.45);
    isolation: isolate;
    cursor: pointer;
  }
  .gate__window:focus-visible { outline-offset: 6px; }
  .gate__view { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; opacity: 0.38; }
  .gate__view { transform-origin: 50% 40%; animation: gate-breathe 28s ease-in-out infinite alternate; }
  @keyframes gate-breathe { from { transform: scale(1.04) translate3d(-1.5%, 0, 0); } to { transform: scale(1.12) translate3d(1.5%, -1%, 0); } }
  .gate__mist {
    position: absolute;
    inset: 45% -30% -10%;
    background: radial-gradient(closest-side, rgb(247 242 230 / 0.9), rgb(247 242 230 / 0));
    animation: gate-mist 22s ease-in-out infinite alternate;
  }
  @keyframes gate-mist { from { translate: -10% 0; } to { translate: 10% -4%; } }

  /* the air emblem, painted in ink in the middle of the gate; a hover stirs it */
  .gate__air {
    position: absolute;
    inset: 24%;
    display: grid;
    color: var(--ink);
    opacity: 0.9;
    transition: rotate 1.2s var(--ease-out), scale 1.2s var(--ease-out);
  }
  .gate__air :global(.gate__emblem) { inline-size: 100%; block-size: 100%; filter: drop-shadow(0 6px 14px rgb(31 29 26 / 0.18)); }
  .gate__window:hover .gate__air, .gate__window:focus-visible .gate__air { rotate: -100deg; scale: 1.05; }
  .gate__frame:has(.gate__window:hover) :global(.gate__enso) { rotate: 8deg; }
  /* on opening, the gust spins it up */
  .gate__window:global(.is-stirring) .gate__air { animation: stir 1.1s cubic-bezier(0.5, 0, 0.75, 0) forwards; }
  @keyframes stir { to { rotate: -900deg; scale: 1.14; } }
  :global(.motion-off) .gate__air, :global(.reduced) .gate__air { transition: none; animation: none !important; }

  /* ---- the invitation: a brushed arrow, a play seal and a slow breath around the gate ------ */
  .gate__hint {
    position: absolute;
    z-index: 3;
    inset-block-start: 1%;
    inset-inline-end: 84%;
    display: grid;
    justify-items: end;
    inline-size: max-content;
    pointer-events: none;
    color: var(--rust);
  }
  .gate__hint-text { font-family: var(--font-display); font-style: italic; font-size: clamp(1.15rem, 0.9rem + 0.7vw, 1.55rem); line-height: 1.1; color: var(--ink); white-space: nowrap; }
  .gate__hint-text em { font-size: 0.72em; color: var(--rust); }
  :lang(ar) .gate__hint-text { font-family: var(--font-arabic-display); font-style: normal; font-size: clamp(1.05rem, 0.85rem + 0.6vw, 1.35rem); line-height: 1.6; }
  :lang(ar) .gate__hint-text em { font-style: normal; }
  .gate__hint-arrow { inline-size: clamp(4.2rem, 3rem + 3vw, 6rem); margin-block-start: 0.2rem; margin-inline-end: -2.2rem; overflow: visible; }
  [dir='rtl'] .gate__hint-arrow { scale: -1 1; }
  .gate__hint-stroke, .gate__hint-head { stroke-dasharray: 1; stroke-dashoffset: 1; animation: hint-draw 0.9s var(--ease-out) forwards; }
  .gate__hint-stroke { animation-delay: 1.4s; }
  .gate__hint-head { animation-delay: 2.1s; animation-duration: 0.35s; }
  @keyframes hint-draw { to { stroke-dashoffset: 0; } }
  .gate__hint-text { animation: hint-in 0.9s 1.1s var(--ease-out) both; }
  @keyframes hint-in { from { opacity: 0; translate: 0 6px; } }
  .gate__hint-arrow { animation: hint-nudge 2.6s 3s ease-in-out infinite; }
  @keyframes hint-nudge { 50% { translate: 4px 5px; } }
  [dir='rtl'] .gate__hint-arrow { animation-name: hint-nudge-rtl; }
  @keyframes hint-nudge-rtl { 50% { translate: -4px 5px; } }

  /* on narrow screens the gate is centred, so the invitation sits above it and points down */
  @media (max-width: 900px) {
    .gate__hint { inset-block-start: auto; inset-block-end: 97%; inset-inline: 0; justify-items: center; inline-size: auto; }
    .gate__hint-arrow { inline-size: 3.2rem; margin: 0; rotate: 28deg; }
    [dir='rtl'] .gate__hint-arrow { rotate: -28deg; }
    .gate { padding-block-start: 4.2rem; }
  }

  .gate__seal {
    position: absolute;
    z-index: 2;
    inset-block-end: 13%;
    inset-inline: 0;
    margin-inline: auto;
    inline-size: max-content;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.15rem 0.55rem 0.95rem;
    isolation: isolate;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cloud);
    transition: scale 0.5s var(--ease-out);
  }
  .gate__seal::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--rust); -webkit-mask: url('/ink/swash.png') center / 100% 100% no-repeat; mask: url('/ink/swash.png') center / 100% 100% no-repeat; }
  .gate__seal svg { inline-size: 0.85rem; block-size: 0.85rem; }
  :lang(ar) .gate__seal { letter-spacing: 0; text-transform: none; font-size: 0.85rem; }
  .gate__window:hover .gate__seal, .gate__window:focus-visible .gate__seal { scale: 1.08; }

  .gate__pulse {
    position: absolute;
    inset: 8%;
    z-index: 0;
    border-radius: 50%;
    pointer-events: none;
    animation: gate-pulse 3.2s var(--ease-out) 2.4s infinite;
  }
  @keyframes gate-pulse {
    from { box-shadow: 0 0 0 0 color-mix(in srgb, var(--rust) 42%, transparent); }
    to { box-shadow: 0 0 0 1.6rem color-mix(in srgb, var(--rust) 0%, transparent); }
  }
  /* once the film has been opened, the gate stops calling */
  .gate:global(.is-seen) .gate__pulse { animation: none; }
  :global(.motion-off) .gate__pulse, :global(.reduced) .gate__pulse { animation: none; }
  :global(.motion-off) :is(.gate__hint-stroke, .gate__hint-head, .gate__hint-text, .gate__hint-arrow),
  :global(.reduced) :is(.gate__hint-stroke, .gate__hint-head, .gate__hint-text, .gate__hint-arrow) { animation: none; stroke-dashoffset: 0; }

  /* Arabic and phones: the "in production" line leads the caption */
  .gate__tag-line { display: none; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink-2); }
  .gate__tag-line span { font-family: var(--font-display); font-style: italic; font-size: 1rem; letter-spacing: 0.02em; text-transform: none; color: var(--rust); }
  :lang(ar) .gate__tag-line { letter-spacing: 0; text-transform: none; font-size: 0.9rem; }
  :lang(ar) .gate__tag-line span { font-style: normal; font-size: inherit; }
  :lang(ar) .gate__tag-line:not([hidden]) { display: block; }
  @media (max-width: 560px) {
    .gate__tag-line:not([hidden]) { display: block; }
  }

  .gate__caption { display: grid; justify-items: center; gap: 0.9rem; text-align: center; }
  .gate__note { font-size: var(--step--1); color: var(--muted); max-inline-size: 22rem; }
  /* film languages: words; the chosen one is underlined with the brush */
  .gate__tabs { display: flex; gap: 1.6rem; }
  .gate__tabs button { position: relative; padding: 0.35rem 0.1rem; font-family: var(--font-display); font-size: 1.15rem; font-style: italic; color: var(--muted); transition: color var(--dur-2); }
  .gate__tabs button[lang='ar'] { font-family: var(--font-arabic-display); font-style: normal; font-size: 1.05rem; }
  .gate__tabs button::after {
    content: '';
    position: absolute;
    inset-inline: -0.2em;
    inset-block-end: -0.1rem;
    block-size: 0.45rem;
    background: var(--rust);
    -webkit-mask: url('/ink/under.png') center / 100% 100% no-repeat;
    mask: url('/ink/under.png') center / 100% 100% no-repeat;
    clip-path: inset(-50% 100% -50% 0);
    transition: clip-path 0.7s var(--ease-out);
  }
  [dir='rtl'] .gate__tabs button::after { clip-path: inset(-50% 0 -50% 100%); }
  .gate__tabs button:hover { color: var(--ink); }
  .gate__tabs button[aria-selected='true'] { color: var(--ink); }
  .gate__tabs button[aria-selected='true']::after { clip-path: inset(-50% 0 -50% 0); }

  /* ---- the stage the gust opens --------------------------------------------------------- */
  .gust {
    position: fixed;
    inset: 0;
    inline-size: 100vw;
    max-inline-size: none;
    block-size: 100dvh;
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--cloud);
    overflow: hidden;
  }
  .gust::backdrop { background: transparent; }
  .gust__air { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; }
  /* without the storm (no WebGL, reduced motion, motion off) the stage fades in on ink */
  .gust:global(.is-still) { background: radial-gradient(60% 60% at 50% 50%, var(--storm-2), var(--storm) 75%); animation: gust-fade 0.35s var(--ease-out); }
  @keyframes gust-fade { from { opacity: 0; } }

  .gust__stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.2rem;
    padding: 4.5rem var(--gutter) 2rem;
    pointer-events: none;
    opacity: 0;
  }
  .gust__stage > * { pointer-events: auto; }
  /* the screen is blown in by the wind: it arrives turning, out of a blur, and settles */
  .gust:global(.is-in) .gust__stage { opacity: 1; animation: blow-in 0.95s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes blow-in {
    from { opacity: 0; scale: 0.82; rotate: -7deg; filter: blur(16px); translate: 0 3vh; }
    60% { opacity: 1; }
    to { opacity: 1; scale: 1; rotate: 0deg; filter: blur(0); translate: 0 0; }
  }
  .gust:global(.is-still.is-in) .gust__stage { animation: gust-fade 0.35s var(--ease-out) both; }
  /* closing: the wind takes the screen away first */
  .gust:global(.is-out) .gust__stage { animation: blow-out 0.3s cubic-bezier(0.7, 0, 0.84, 0) both; }
  @keyframes blow-out { from { opacity: 1; } to { opacity: 0; scale: 1.08; rotate: 5deg; filter: blur(12px); } }

  .gust__screen {
    position: relative;
    inline-size: min(88vw, 1100px, calc((100dvh - 12rem) * 16 / 9));
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    background: radial-gradient(70% 90% at 50% 40%, rgb(29 38 40 / 0.5), rgb(10 12 11 / 0.66));
    box-shadow: 0 0 0 1px rgb(238 240 236 / 0.16), 0 40px 90px -30px rgb(0 0 0 / 0.8);
  }
  .gust__video { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: contain; background: #000; cursor: pointer; }
  /* captions are drawn here rather than by the browser, so they always sit inside the film,
     clear of the controls, at most two lines at a time */
  .gust__screen { container-type: inline-size; }
  .gust__cc {
    position: absolute;
    inset-inline: 7%;
    inset-block-end: 6%;
    margin: 0;
    text-align: center;
    pointer-events: none;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(0.8rem, 2.4cqi, 1.45rem);
    line-height: 1.5;
    white-space: pre-line;
    color: var(--cloud);
  }
  .gust__cc[hidden] { display: none; }
  .gust__cc span { padding: 0.14em 0.6em; border-radius: 4px; background: rgb(12 14 13 / 0.68); -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .gust__cc[lang='ar'] { font-family: var(--font-arabic); font-size: clamp(0.9rem, 2.6cqi, 1.6rem); line-height: 1.75; }
  .gust__soon { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 0.7rem; padding: 2rem; text-align: center; }
  .gust__soon[hidden] { display: none; }
  .gust__soon :global(.gust__emblem) { inline-size: clamp(4rem, 12vw, 7.5rem); block-size: auto; aspect-ratio: 1; color: var(--cloud); margin-block-end: 0.6rem; opacity: 0.92; }
  .gust__kicker { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: #e9a86a; }
  :lang(ar) .gust__kicker { letter-spacing: 0; text-transform: none; font-size: 0.95rem; }
  .gust__title { font-family: var(--font-display); font-style: italic; font-size: clamp(2.2rem, 1rem + 4vw, 4.2rem); line-height: 1; color: var(--cloud); }
  :lang(ar) .gust__title { font-style: normal; line-height: 1.4; }
  .gust__note { max-inline-size: 30rem; font-size: var(--step--1); color: #c9d1ce; }
  .gust__note span { color: #e9a86a; }

  .gust__language { display: grid; justify-items: center; gap: 0.25rem; color: #c9d1ce; font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; }
  .gust__language .gate__tabs { gap: 1.2rem; }
  .gust__language .gate__tabs button { color: #c9d1ce; }
  .gust__language .gate__tabs button[aria-selected='true'] { color: var(--cloud); }
  .gust__language .gate__tabs button::after { background: #e9a86a; }
  :lang(ar) .gust__language { letter-spacing: 0; text-transform: none; font-size: 0.85rem; }

  .gust__controls { display: flex; gap: 0.4rem; }
  .gust__controls[hidden] { display: none; }
  .gust__controls button { position: relative; isolation: isolate; padding: 0.7rem 1.2rem; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--storm); }
  .gust__controls button::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--cloud); -webkit-mask: url('/ink/swash.png') center / 100% 100% no-repeat; mask: url('/ink/swash.png') center / 100% 100% no-repeat; }
  .gust__controls button[aria-pressed='true'] { color: var(--cloud); }
  .gust__controls button[aria-pressed='true']::before { background: var(--rust); }
  :lang(ar) .gust__controls button { letter-spacing: 0; text-transform: none; font-size: 0.8rem; }

  /* Keep the caption track clear on short landscape screens, where the normal height budget is negative. */
  @media (orientation: landscape) and (max-height: 620px) {
    .gust__stage { display: flex; flex-direction: column; justify-content: center; gap: 0.85rem; padding: 2rem var(--gutter) 0.25rem; overflow-y: auto; }
    .gust__language { gap: 0; font-size: 0; }
    .gust__language > span { display: none; }
    .gust__language .gate__tabs { gap: 0.7rem; }
    .gust__language .gate__tabs button { padding-block: 0.1rem; font-size: 0.85rem; }
    .gust__screen { flex: 0 0 auto; inline-size: min(88vw, calc((100dvh - 8.5rem) * 16 / 9)); max-block-size: calc(100dvh - 8.5rem); }
    .gust__controls { gap: 0.15rem; padding: 0.1rem 0.35rem; background: rgb(18 20 19 / 0.96); border-radius: 4px; }
    .gust__controls button { padding: 0.35rem 0.65rem; font-size: 0.58rem; }
    :lang(ar) .gust__controls button { font-size: 0.7rem; }
  }

  .gust__close { position: absolute; inset-block-start: 1.2rem; inset-inline-end: var(--gutter); z-index: 2; color: var(--cloud); opacity: 0; transition: opacity 0.4s 0.5s, color var(--dur-2); }
  .gust:global(.is-in) .gust__close { opacity: 1; }
  .gust:global(.is-out) .gust__close { opacity: 0; transition-delay: 0s; }
  .gust__close:hover { color: #e9a86a; }
</style>

<script>
  import { initIntro } from '../scripts/intro';
  document.querySelectorAll<HTMLElement>('[data-intro]').forEach(initIntro);
</script>
