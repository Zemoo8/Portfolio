---
// The moon gate: a circular window onto the ink landscape. It holds the three personal intro
// films (EN / FR / AR), detected at build time:
//   public/media/intros/intro-<lang>.mp4   (+ optional .webm, .vtt; poster: intro-<lang>-poster.webp)
// Missing films keep the painted view and are never requested (no 404s).
// Adding a file and rebuilding/redeploying is all it takes. See docs/README.md → "Intro films".
import Brush from './Brush.astro';
import { locales, localeMeta, asset, tr, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { exists } from '../lib/media';

interface Props { lang: Locale }
const { lang } = Astro.props;
const base = asset('media/intros');
const files = Object.fromEntries(
  locales.map((l) => [l, { mp4: exists(`media/intros/intro-${l}.mp4`), webm: exists(`media/intros/intro-${l}.webm`), vtt: exists(`media/intros/intro-${l}.vtt`), poster: exists(`media/intros/intro-${l}-poster.webp`) }]),
);
---

<figure class="gate" data-intro data-base={base} data-lang={lang} data-files={JSON.stringify(files)}>
  <div class="gate__frame">
    <Brush kind="circle" seed={7} class="gate__enso" />
    <div class="gate__window">
      <img class="gate__view" src={asset('art/gate.webp')} alt="" width="900" height="900" fetchpriority="high" loading="eager" />
      <div class="gate__mist" aria-hidden="true"></div>
      <video class="gate__video" muted playsinline loop preload="none" hidden data-intro-video></video>
      <div class="gate__tag" data-intro-placeholder>
        <span class="gate__dot" aria-hidden="true"></span>
        <span>{tr(ui.intro.label, lang)} · {tr(ui.intro.pending, lang)}</span>
      </div>
    </div>
    <div class="gate__controls" hidden data-intro-controls>
      <button type="button" data-intro-sound data-on={tr(ui.intro.sound, lang)} data-off={tr(ui.intro.mute, lang)}>{tr(ui.intro.sound, lang)}</button>
      <button type="button" data-intro-cc aria-pressed="false" hidden>{tr(ui.intro.captions, lang)}</button>
      <button type="button" data-intro-replay>{tr(ui.intro.replay, lang)}</button>
    </div>
  </div>

  <figcaption class="gate__caption">
    <p class="gate__note">{tr(ui.intro.pendingNote, lang)}</p>
    <div class="gate__tabs" role="tablist" aria-label={tr(ui.intro.choose, lang)}>
      {locales.map((l) => (
        <button type="button" role="tab" lang={l} aria-selected={l === lang ? 'true' : 'false'} data-intro-tab={l}>{localeMeta[l].name}</button>
      ))}
    </div>
  </figcaption>
</figure>

<style>
  .gate { display: grid; justify-items: center; gap: 1.6rem; }
  .gate__frame { position: relative; inline-size: min(100%, 34rem); aspect-ratio: 1; display: grid; place-items: center; }
  .gate__frame :global(.gate__enso) { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; z-index: 2; pointer-events: none; }
  .gate__window {
    position: relative;
    inline-size: 84%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--mist);
    box-shadow: inset 0 0 0 1px rgb(31 29 26 / 0.12), inset 0 20px 60px -30px rgb(31 29 26 / 0.45);
    isolation: isolate;
  }
  .gate__view, .gate__video { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }
  .gate__view { transform-origin: 50% 40%; animation: gate-breathe 28s ease-in-out infinite alternate; }
  @keyframes gate-breathe { from { transform: scale(1.04) translate3d(-1.5%, 0, 0); } to { transform: scale(1.12) translate3d(1.5%, -1%, 0); } }
  .gate__mist {
    position: absolute;
    inset: 45% -30% -10%;
    background: radial-gradient(closest-side, rgb(247 242 230 / 0.9), rgb(247 242 230 / 0));
    animation: gate-mist 22s ease-in-out infinite alternate;
  }
  @keyframes gate-mist { from { translate: -10% 0; } to { translate: 10% -4%; } }
  .gate__video { z-index: 2; }
  .gate__tag {
    position: absolute;
    inset-block-end: 12%;
    inset-inline: 0;
    margin-inline: auto;
    inline-size: max-content;
    max-inline-size: 78%;
    z-index: 3;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: rgb(247 242 230 / 0.88);
    backdrop-filter: blur(6px);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--ink-2);
  }
  :lang(ar) .gate__tag { letter-spacing: 0; text-transform: none; }
  .gate__dot { inline-size: 0.5rem; block-size: 0.5rem; border-radius: 50%; background: var(--seal); animation: rec 2.4s ease-in-out infinite; }
  @keyframes rec { 50% { opacity: 0.25; } }

  .gate__controls { position: absolute; inset-block-end: 4%; z-index: 4; display: flex; gap: 0.4rem; }
  .gate__controls[hidden] { display: none; }
  .gate__controls button { padding: 0.45rem 0.85rem; border-radius: 999px; background: rgb(247 242 230 / 0.9); font-size: 0.78rem; font-weight: 600; box-shadow: 0 6px 16px -10px rgb(0 0 0 / 0.5); }
  .gate__controls button[aria-pressed='true'] { background: var(--ink); color: var(--paper); }

  .gate__caption { display: grid; justify-items: center; gap: 0.9rem; text-align: center; }
  .gate__note { font-size: var(--step--1); color: var(--muted); max-inline-size: 22rem; }
  .gate__tabs { display: flex; gap: 0.2rem; padding: 0.25rem; border-radius: 999px; background: rgb(247 242 230 / 0.7); backdrop-filter: blur(8px); box-shadow: 0 0 0 1px var(--line); }
  .gate__tabs button { padding: 0.4rem 0.9rem; border-radius: 999px; font-size: 0.86rem; font-weight: 500; color: var(--muted); transition: color var(--dur-1), background var(--dur-1); }
  .gate__tabs button[lang='ar'] { font-family: var(--font-arabic-display); }
  .gate__tabs button:hover { color: var(--ink); }
  .gate__tabs button[aria-selected='true'] { background: var(--ink); color: var(--paper); }
</style>

<script>
  import { initIntro } from '../scripts/intro';
  document.querySelectorAll<HTMLElement>('[data-intro]').forEach(initIntro);
</script>
