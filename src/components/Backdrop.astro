---
// The painted world behind every page: procedural ink-wash layers (scripts/art/landscape.mjs).
// Scrolling makes the camera "climb": each layer sinks at its own depth and the mist veil
// thickens, so text deeper in the page sits on calm, misty paper. Both are CSS scroll-driven
// animations — a pure function of scroll position, run by the compositor in step with native
// scrolling. The wind is ambient and time-based: mist drifting slowly past the peaks, the same
// whether or not you scroll. Decorative only.
import { asset } from '../i18n/config';
---

<div class="world" aria-hidden="true" data-world>
  <img class="world__sky" src={asset('art/sky.webp')} srcset={`${asset('art/sky-1000.webp')} 1000w, ${asset('art/sky.webp')} 2000w`} sizes="100vw" alt="" width="2000" height="1250" fetchpriority="low" decoding="async" />
  <div class="world__depth" style="--depth:0.05">
    <img src={asset('art/peaks.webp')} srcset={`${asset('art/peaks-1000.webp')} 1000w, ${asset('art/peaks.webp')} 2000w`} sizes="100vw" alt="" width="2000" height="1250" decoding="async" />
  </div>
  <div class="world__depth" style="--depth:0.065">
    <div class="world__breeze"><i></i><i></i><i></i></div>
  </div>
  <div class="world__depth" style="--depth:0.08">
    <div class="world__mist world__mist--a"></div>
  </div>
  <div class="world__depth" style="--depth:0.11">
    <img src={asset('art/near.webp')} srcset={`${asset('art/near-1000.webp')} 1000w, ${asset('art/near.webp')} 2000w`} sizes="100vw" alt="" width="2000" height="1250" decoding="async" />
  </div>
  <div class="world__mist world__mist--b"></div>
  <div class="world__veil" data-veil></div>
</div>

<style>
  .world {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: linear-gradient(180deg, #f6f1e4, #efeadc 50%, #e6e1d4);
    pointer-events: none;
  }
  .world img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 100%;
  }
  .world__depth { position: absolute; inset: 0; will-change: transform; }

  /* mist banks at the foot of the mountains, breathing sideways */
  .world__mist {
    position: absolute;
    inset-inline: -20%;
    block-size: 38%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(247 242 230 / 0.95), rgb(247 242 230 / 0));
    will-change: translate;
  }
  .world__mist--a { inset-block-end: 16%; animation: mist-drift 70s ease-in-out infinite alternate; }
  .world__mist--b { inset-block-end: -12%; block-size: 42%; animation: mist-drift 90s ease-in-out infinite alternate-reverse; }
  @keyframes mist-drift { from { translate: -6% 0; } to { translate: 6% 0; } }

  /* the wind: long, soft wisps crossing the sky at a constant, unhurried pace */
  .world__breeze { position: absolute; inset: 0; }
  .world__breeze i {
    position: absolute;
    inset-inline-start: 0;
    inline-size: 58vw;
    block-size: max(2.8rem, 6vh);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(250 247 239 / 0.7), rgb(250 247 239 / 0));
    translate: -80vw 0;
    animation: breeze 120s linear infinite;
    will-change: translate;
  }
  .world__breeze i:nth-child(1) { inset-block-start: 24%; animation-delay: -38s; }
  .world__breeze i:nth-child(2) { inset-block-start: 37%; inline-size: 44vw; block-size: max(2rem, 4.5vh); opacity: 0.8; animation-duration: 95s; animation-delay: -74s; }
  .world__breeze i:nth-child(3) { inset-block-start: 49%; inline-size: 70vw; opacity: 0.65; animation-duration: 150s; animation-delay: -12s; }
  /* physical direction on purpose: the painting is the same in every language */
  @keyframes breeze { from { translate: -80vw 0; } to { translate: 110vw 0; } }

  .world__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(245 239 225 / 0.2), rgb(245 239 225 / 0.72));
    opacity: 0;
  }

  /* scroll-driven: position in, position out — never velocity.
     The timeline lives in its own, more specific rule: CSS minifiers otherwise fold it into the
     `animation` shorthand, a form browsers reject (the animation then silently never runs). */
  @supports (animation-timeline: scroll()) {
    .world__veil { animation: veil-in linear both; }
    .world > .world__veil { animation-timeline: scroll(root block); animation-range: 0 100vh; }
    @media (prefers-reduced-motion: no-preference) {
      .world__depth { animation: world-sink linear both; }
      .world > .world__depth { animation-timeline: scroll(root block); animation-range: 0 220vh; }
    }
    @media (prefers-reduced-motion: reduce) {
      /* the veil only fades (no movement), so it keeps following the page */
      .world__veil { animation-duration: auto !important; }
    }
  }
  @keyframes world-sink { to { transform: translate3d(0, calc(220vh * var(--depth)), 0); } }
  @keyframes veil-in { to { opacity: 0.62; } }

  :global(.motion-off) .world__depth { animation: none; }
  :global(.motion-off) .world__veil { animation-play-state: running !important; }
</style>
