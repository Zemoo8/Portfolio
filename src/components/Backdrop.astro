---
// The painted world behind every page — and it is painted as you read. At the top there is only
// sky, the distant ranges and the back spires; scrolling raises the main peaks out of the mist,
// sets the temple on its crest, closes the framing peaks in, lifts the near ridges and grows the
// pines. Scroll back up and it comes apart again: every stage is a CSS scroll-driven animation of
// position and opacity (compositor-run, tied to scroll POSITION, never speed). The layers come
// from scripts/art/landscape.mjs and composite to exactly the full painting.
// Without scroll-driven animations, with reduced motion, or with the motion switch off, the
// finished painting is simply there. The wind (mist drifting past) is time-based. Decorative.
// Phones build the same painting in three stages instead of six (the middle and near stages come
// pre-merged: build-mid, build-near) and skip the wind wisps — far fewer full-screen layers for a
// phone's GPU to composite on every scroll frame. Stages a screen doesn't show are never loaded.
import { asset } from '../i18n/config';

const layer = (name: string) => ({
  src: asset(`art/build-${name}.webp`),
  srcset: `${asset(`art/build-${name}-1000.webp`)} 1000w, ${asset(`art/build-${name}.webp`)} 2000w`,
});
const stages = ['back', 'main', 'temple', 'frame'].map((n) => ({ n, ...layer(n) }));
const near = ['ridges', 'pines'].map((n) => ({ n, ...layer(n) }));
// the phone's merged stages (1000 w is plenty for a phone-sized painting)
const phone = (n: string) => ({ n, src: asset(`art/build-${n}-1000.webp`) });
---

<div class="world" aria-hidden="true" data-world>
  <img class="world__sky" src={asset('art/sky.webp')} srcset={`${asset('art/sky-1000.webp')} 1000w, ${asset('art/sky.webp')} 2000w`} sizes="100vw" alt="" width="2000" height="1250" fetchpriority="low" decoding="async" />
  {stages.map((s) => s.n === 'back'
    ? <img class={`build build--${s.n}`} src={s.src} srcset={s.srcset} sizes="100vw" alt="" width="2000" height="1250" decoding="async" />
    : <img class={`build build--${s.n}`} data-src={s.src} data-srcset={s.srcset} sizes="100vw" alt="" width="2000" height="1250" decoding="async" />)}
  <img class="build build--mid" data-src={phone('mid').src} alt="" width="1000" height="625" decoding="async" />
  <div class="world__breeze"><i></i><i></i><i></i></div>
  <div class="world__mist world__mist--a"></div>
  {near.map((s) => <img class={`build build--${s.n}`} data-src={s.src} data-srcset={s.srcset} sizes="100vw" alt="" width="2000" height="1250" decoding="async" />)}
  <img class="build build--near" data-src={phone('near').src} alt="" width="1000" height="625" decoding="async" />
  <div class="world__mist world__mist--b"></div>
  <div class="world__veil" data-veil></div>
</div>

<script>
  // Stages that are not yet painted at the top of the page load once the page itself has loaded,
  // so they never compete with the first view.
  // Only the stages this screen shows are loaded (a phone's merged stages, or the wide screen's six).
  const paint = () =>
    document.querySelectorAll<HTMLImageElement>('.world img[data-src]').forEach((i) => {
      if (getComputedStyle(i).display === 'none') return;
      if (i.dataset.srcset) i.srcset = i.dataset.srcset;
      i.src = i.dataset.src!;
      i.removeAttribute('data-src');
    });
  const idle = (window as any).requestIdleCallback ?? ((f: () => void) => setTimeout(f, 200));
  if (document.readyState === 'complete') idle(paint); else addEventListener('load', () => idle(paint), { once: true });
  matchMedia('(max-width: 760px)').addEventListener('change', () => idle(paint));
</script>

<style>
  .world {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: linear-gradient(180deg, #f6f1e4, #efeadc 50%, #e6e1d4);
    pointer-events: none;
  }
  .world img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 100%;
  }
  .build { will-change: translate, opacity; transform-origin: 50% 100%; }

  /* mist banks at the foot of the mountains, breathing sideways */
  .world__mist {
    position: absolute;
    inset-inline: -20%;
    block-size: 38%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(247 242 230 / 0.95), rgb(247 242 230 / 0));
    will-change: translate;
  }
  .world__mist--a { inset-block-end: 16%; animation: mist-drift 70s ease-in-out infinite alternate; }
  .world__mist--b { inset-block-end: -12%; block-size: 42%; animation: mist-drift 90s ease-in-out infinite alternate-reverse; }
  @keyframes mist-drift { from { translate: -6% 0; } to { translate: 6% 0; } }

  /* the wind: long, soft wisps crossing the sky at a constant, unhurried pace */
  .world__breeze { position: absolute; inset: 0; }
  .world__breeze i {
    position: absolute;
    inset-inline-start: 0;
    inline-size: 58vw;
    block-size: max(2.8rem, 6vh);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(250 247 239 / 0.7), rgb(250 247 239 / 0));
    translate: -80vw 0;
    animation: breeze 120s linear infinite;
    will-change: translate;
  }
  .world__breeze i:nth-child(1) { inset-block-start: 24%; animation-delay: -38s; }
  .world__breeze i:nth-child(2) { inset-block-start: 37%; inline-size: 44vw; block-size: max(2rem, 4.5vh); opacity: 0.8; animation-duration: 95s; animation-delay: -74s; }
  .world__breeze i:nth-child(3) { inset-block-start: 49%; inline-size: 70vw; opacity: 0.65; animation-duration: 150s; animation-delay: -12s; }
  @keyframes breeze { from { translate: -80vw 0; } to { translate: 110vw 0; } }

  .world__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(245 239 225 / 0.2), rgb(245 239 225 / 0.72));
    opacity: 0;
  }

  /* ---- the painting, built by scroll position -----------------------------------------------
     Each stage runs over its own stretch of the page (in viewport heights of scrolling).
     The timeline lives in its own, more specific rule: CSS minifiers otherwise fold it into the
     `animation` shorthand, a form browsers reject. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .build { animation: build-in linear both; }
      .world > .build { animation-timeline: scroll(root block); }
      .world > .build--back { animation-range: 0vh 90vh; --o0: 0.5; --y0: 6%; }
      .world > .build--main { animation-range: 12vh 150vh; --o0: 0; --y0: 24%; }
      .world > .build--temple { animation-range: 135vh 200vh; --o0: 0; --y0: 3%; }
      .world > .build--frame { animation-range: 180vh 290vh; --o0: 0; --y0: 0%; --s0: 1.1; }
      .world > .build--ridges { animation-range: 260vh 400vh; --o0: 0; --y0: 32%; }
      .world > .build--pines { animation-range: 360vh 480vh; --o0: 0; --y0: 30%; }
      /* the veil gathers only once the painting is complete, behind the later chapters */
      .world__veil { animation: veil-in linear both; }
      .world > .world__veil { animation-timeline: scroll(root block); animation-range: 480vh 700vh; }
    }
  }
  @keyframes build-in {
    from { opacity: var(--o0, 0); translate: 0 var(--y0, 0%); scale: var(--s0, 1); }
    to { opacity: 1; translate: 0 0; scale: 1; }
  }
  @keyframes veil-in { to { opacity: 0.4; } }

  :global(.motion-off) .build, :global(.motion-off) .world__veil { animation: none; }

  /* ---- phones: three stages, one mist bank, no wind wisps ----------------------------------- */
  .build--mid, .build--near { display: none; }
  @media (max-width: 760px) {
    .build--main, .build--temple, .build--frame, .build--ridges, .build--pines, .world__breeze, .world__mist--a { display: none; }
    .build--mid, .build--near { display: block; }
    .world > .build { animation: none !important; opacity: 1; translate: none; scale: 1; }
    .world__mist--b { animation: none; }
    .build { will-change: auto; }
  }
</style>
