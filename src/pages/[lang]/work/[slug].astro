---
import Base from '../../../layouts/Base.astro';
import Film from '../../../components/Film.astro';
import Shot from '../../../components/Shot.astro';
import Brush from '../../../components/Brush.astro';
import Seal from '../../../components/Seal.astro';
import { film, exists } from '../../../lib/media';
import { locales, path, tr, type Locale } from '../../../i18n/config';
import { ui } from '../../../i18n/ui';
import { projects, type Project } from '../../../content/projects';
import { profile } from '../../../content/profile';

export const getStaticPaths = () =>
  locales.flatMap((lang) => projects.map((project) => ({ params: { lang, slug: project.slug }, props: { project } })));

const lang = Astro.params.lang as Locale;
const { project: p } = Astro.props as { project: Project };
const i = projects.indexOf(p);
const next = projects[(i + 1) % projects.length];
const desk = film(p.film?.desktop);
const mob = film(p.film?.mobile);
const featureFilm = film(p.feature?.film);
const featurePoster = film(p.feature?.poster);
const label = `${p.title} — ${tr(ui.work.film, lang)}`;
const ogImage = exists(`og/${p.slug}-${lang}.jpg`) ? `og/${p.slug}-${lang}.jpg` : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: p.title,
  description: tr(p.tagline, lang),
  inLanguage: lang,
  dateCreated: p.year.replace(/\D.*$/, ''),
  author: { '@type': 'Person', name: profile.name.en, url: new URL(path('en'), Astro.site).href },
  keywords: p.stack.join(', '),
};
---

<Base lang={lang} title={`${p.title} — ${tr(profile.name, lang)}`} description={tr(p.tagline, lang)} route={`work/${p.slug}`} ogImage={ogImage} jsonLd={jsonLd}>
  <article class="case" style={`--tone:${p.tone}`}>
    <header class="case__head wrap">
      <a class="case__back link-u" href={`${path(lang)}#work`}><span class="arrow" aria-hidden="true">←</span> {tr(ui.work.back, lang)}</a>
      <p class="kicker" data-reveal>{p.index} · {tr(p.category, lang)}</p>
      <h1 class="case__title display">
        <span class="line-mask" data-onload><span>{p.title}</span></span>
        {p.alias && <span class="case__alias" lang="ar">{p.alias}</span>}
      </h1>
      <Brush seed={70 + i} length={480} class="case__stroke" />
      <p class="case__tagline" data-reveal style="--i:1">{tr(p.tagline, lang)}</p>
      <dl class="case__meta" data-reveal style="--i:2">
        <div><dt class="label">{tr(ui.work.year, lang)}</dt><dd>{p.year}</dd></div>
        <div><dt class="label">{tr(ui.work.role, lang)}</dt><dd>{tr(p.role, lang)}</dd></div>
        <div><dt class="label">{tr(ui.work.context, lang)}</dt><dd>{tr(p.context, lang)}</dd></div>
      </dl>
    </header>

    <div class="case__hero wrap" data-reveal>
      <div class="mat">
        {desk ? (
          <Film film={desk} label={label} lang={lang} ratio="16 / 10" />
        ) : p.cover.kind === 'figure' ? (
          <Shot src={p.cover.src} alt={tr(p.cover.alt, lang)} figure fit="contain" ratio="16 / 10" eager sizes="100vw" />
        ) : (
          <Shot src={p.cover.src} alt={tr(p.cover.alt, lang)} eager sizes="100vw" />
        )}
      </div>
      {desk && <p class="case__credit label">{tr(ui.work.film, lang)}</p>}
    </div>

    <section class="section wrap">
      <div class="scroll case__story" data-unroll>
        <p class="case__summary" data-reveal>{tr(p.summary, lang)}</p>
        <div class="case__cols">
          <div>
            <h2 class="label case__h">{tr(ui.work.built, lang)}</h2>
            <ol class="case__built">
              {p.built.map((b, n) => <li data-reveal style={`--i:${n}`}><span class="case__n display">{String(n + 1).padStart(2, '0')}</span><p>{tr(b, lang)}</p></li>)}
            </ol>
          </div>
          <aside class="case__side">
            {p.metric && (
              <div class="case__metric" data-reveal>
                <p class="display" dir="ltr">{p.metric.value}</p>
                <p class="label">{tr(p.metric.label, lang)}</p>
              </div>
            )}
            <div data-reveal>
              <h2 class="label case__h">{tr(ui.work.stack, lang)}</h2>
              <ul class="case__stack" lang="en">{p.stack.map((s) => <li class="pill">{s}</li>)}</ul>
            </div>
            {p.notes && (
              <div data-reveal>
                <h2 class="label case__h">{tr(ui.work.details, lang)}</h2>
                {p.notes.map((n) => <p class="case__note">{tr(n, lang)}</p>)}
              </div>
            )}
            {p.links.length > 0 && (
              <div data-reveal>
                <h2 class="label case__h">{tr(ui.work.links, lang)}</h2>
                <ul class="case__links">
                  {p.links.map((l) => (
                    <li><a class="link-u" href={l.href} target="_blank" rel="noopener"><span class="label">{tr(l.label === 'live' ? ui.work.live : ui.work.source, lang)}</span> <span dir="ltr">{l.text ?? l.href}</span> <span class="arrow" aria-hidden="true">↗</span></a></li>
                  ))}
                </ul>
              </div>
            )}
          </aside>
        </div>
      </div>
    </section>

    {(mob || p.feature) && (
      <section class="case__feature wrap">
        {p.feature && (
          <header class="case__feature-head" data-reveal>
            <h2 class="display">{tr(p.feature.title, lang)}</h2>
            <p>{tr(p.feature.body, lang)}</p>
          </header>
        )}
        <div class="case__feature-media">
          {featureFilm && <div class="phone" data-reveal data-parallax="6"><Film film={featureFilm} label={label} lang={lang} ratio="390 / 844" /></div>}
          {mob && <div class="phone" data-reveal data-parallax="6"><Film film={mob} label={label} lang={lang} ratio="390 / 844" /></div>}
          {featurePoster && <div class="case__feature-wide mat" data-reveal><Film film={featurePoster} label={`${p.title} — film`} lang={lang} ratio="16 / 9" /></div>}
        </div>
      </section>
    )}

    {p.gallery.length > 0 && (
      <section class="case__gallery wrap" aria-label={tr(ui.work.gallery, lang)}>
        <h2 class="kicker case__gallery-h">{tr(ui.work.gallery, lang)}</h2>
        <div class="gallery">
          {p.gallery.map((g) => (
            <figure class:list={['gallery__item', `gallery__item--${g.kind}`]} data-reveal>
              {g.kind === 'mobile' ? (
                <div class="phone"><Shot src={g.src} alt={tr(g.alt, lang)} ratio="390 / 844" sizes="20rem" /></div>
              ) : (
                <div class="mat"><Shot src={g.src} alt={tr(g.alt, lang)} figure={g.kind === 'figure'} fit={g.kind === 'figure' ? 'contain' : 'cover'} sizes="(max-width: 900px) 100vw, 50vw" /></div>
              )}
              <figcaption class="label">{tr(g.alt, lang)}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {p.caveat && (
      <aside class="case__caveat wrap" data-reveal>
        <p><span class="case__caveat-seal"><Seal size="1.6rem" /></span><span><strong>{tr(ui.work.note, lang)}.</strong> {tr(p.caveat, lang)}</span></p>
      </aside>
    )}

    <a class="case__next wrap" href={path(lang, `work/${next.slug}`)}>
      <span class="kicker">{tr(ui.work.next, lang)} · {next.index}</span>
      <span class="case__next-title display">{next.title} <span class="arrow" aria-hidden="true">→</span></span>
      <Brush seed={90 + i} length={900} class="case__next-stroke" />
    </a>
  </article>
</Base>

<style>
  .case__head { position: relative; display: grid; gap: 1.1rem; justify-items: start; padding-block: 8.5rem 3rem; }
  .case__head::before {
    content: '';
    position: absolute;
    inset: 10% 20% 0 -10%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(246 241 229 / 0.94), rgb(246 241 229 / 0));
    pointer-events: none;
  }
  .case__back { font-size: var(--step--1); font-weight: 600; color: var(--muted); }
  [dir='rtl'] .case__back .arrow { transform: scaleX(-1); }
  .case__title { font-size: clamp(3.6rem, 1.6rem + 8vw, 10rem); font-weight: 600; line-height: 0.9; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.2em 0.35em; }
  :lang(ar) .case__title { line-height: 1.2; }
  .case__title .line-mask > span { display: block; }
  .case__alias { font-family: var(--font-arabic-display); font-size: 0.34em; font-weight: 500; color: var(--muted); }
  .case :global(.case__stroke) { inline-size: min(100%, 26rem); block-size: 20px; margin-block: -0.4rem 0.3rem; }
  .case__tagline { font-family: var(--font-display); font-style: italic; font-size: var(--step-2); line-height: 1.25; max-inline-size: 42rem; color: var(--ink-2); }
  :lang(ar) .case__tagline { font-style: normal; line-height: 1.7; }
  .case__meta {
    display: grid;
    grid-template-columns: 7rem 1fr 1.6fr;
    gap: var(--gutter);
    inline-size: 100%;
    margin-block-start: 1rem;
    padding: 1.1rem 1.4rem;
    border-radius: 14px;
    background: rgb(247 242 230 / 0.75);
    backdrop-filter: blur(8px);
    box-shadow: 0 0 0 1px var(--line);
  }
  .case__meta dd { margin-block-start: 0.3rem; font-weight: 500; }

  .case__hero { position: relative; }
  .case__credit { margin-block-start: 0.8rem; }

  .case__summary { font-family: var(--font-display); font-size: var(--step-3); font-weight: 500; line-height: 1.2; max-inline-size: 60rem; }
  :lang(ar) .case__summary { font-size: var(--step-2); line-height: 1.8; }
  .case__cols { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: calc(var(--gutter) * 2); margin-block-start: 4rem; }
  .case__h { display: block; margin-block-end: 1rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }
  :lang(ar) .case__h { letter-spacing: 0; text-transform: none; }
  .case__built { border-block-start: 1px solid var(--line); }
  .case__built li { display: grid; grid-template-columns: 3.2rem 1fr; gap: 1rem; padding-block: 1.3rem; border-block-end: 1px solid var(--line); color: var(--ink-2); }
  .case__n { font-size: 1.8rem; color: var(--seal); line-height: 1; }
  .case__side { display: grid; gap: 2.4rem; align-content: start; }
  .case__metric { padding: 1.6rem; border-radius: 16px; background: var(--ink); color: var(--paper); }
  .case__metric .display { font-family: 'Cormorant Garamond', serif; font-size: var(--step-5); font-weight: 600; color: var(--amber); line-height: 1; margin-block-end: 0.6rem; }
  .case__metric .label { color: #cfc8b8; }
  .case__stack { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .case__note { color: var(--ink-2); font-size: var(--step--1); line-height: 1.65; }
  .case__note + .case__note { margin-block-start: 0.8rem; }
  .case__links { display: grid; gap: 0.7rem; font-weight: 500; }
  .case__links .label { margin-inline-end: 0.5rem; }

  .case__feature { padding-block: var(--section) 0; display: grid; gap: 3rem; }
  .case__feature-head { display: grid; gap: 1rem; max-inline-size: 40rem; }
  .case__feature-head h2 { font-size: var(--step-4); font-weight: 600; }
  .case__feature-head p { color: var(--ink-2); }
  .case__feature-media { display: flex; gap: calc(var(--gutter) * 1.2); align-items: center; }
  .case__feature-media .phone { flex: 0 0 clamp(11rem, 17vw, 17rem); }
  .case__feature-media .phone:nth-child(2) { margin-block-start: 5rem; }
  .case__feature-wide { flex: 1 1 0; min-inline-size: 0; }

  .case__gallery { padding-block: var(--section) 0; }
  .case__gallery-h { margin-block-end: 2rem; }
  .gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: calc(var(--gutter) * 1.2) var(--gutter); }
  .gallery__item { display: grid; gap: 0.8rem; align-content: start; }
  .gallery__item--figure { grid-column: 1 / -1; }
  .gallery__item--mobile { max-inline-size: 20rem; }
  .gallery:has(.gallery__item--poster) { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .gallery:has(.gallery__item--poster) .gallery__item--desktop { grid-column: span 3; }
  .gallery:has(.gallery__item--poster) .gallery__item--poster { grid-column: span 2; }

  .case__caveat { padding-block-start: 4rem; }
  .case__caveat p { display: flex; gap: 1rem; align-items: flex-start; max-inline-size: 50rem; padding: 1.2rem 1.4rem; border-radius: 14px; background: rgb(247 242 230 / 0.85); box-shadow: 0 0 0 1px var(--line); color: var(--ink-2); font-size: var(--step--1); line-height: 1.6; }
  .case__caveat-seal { flex: none; }

  .case__next { display: grid; gap: 0.6rem; justify-items: start; margin-block-start: var(--section); padding-block: 2rem 1rem; }
  .case__next-title { font-size: clamp(3rem, 1.5rem + 6vw, 7.5rem); font-weight: 600; transition: color var(--dur-2); }
  .case__next:hover .case__next-title { color: var(--rust); }
  .case__next:hover .arrow { transform: translateX(12px); }
  [dir='rtl'] .case__next .arrow { transform: scaleX(-1); }
  [dir='rtl'] .case__next:hover .arrow { transform: scaleX(-1) translateX(12px); }
  .case :global(.case__next-stroke) { inline-size: 100%; block-size: 20px; opacity: 0.75; }

  @media (max-width: 900px) {
    .case__meta { grid-template-columns: 1fr; gap: 0.8rem; }
    .case__cols { grid-template-columns: 1fr; }
    .case__feature-media { flex-wrap: wrap; justify-content: center; }
    .case__feature-media .phone { flex-basis: calc(50% - var(--gutter)); max-inline-size: 16rem; }
    .case__feature-media .phone:nth-child(2) { margin-block-start: 2.5rem; }
    .case__feature-wide { flex-basis: 100%; }
    .gallery, .gallery:has(.gallery__item--poster) { grid-template-columns: 1fr 1fr; }
    .gallery:has(.gallery__item--poster) .gallery__item--desktop, .gallery__item--desktop { grid-column: 1 / -1; }
    .gallery:has(.gallery__item--poster) .gallery__item--poster { grid-column: span 1; }
  }
</style>
