---
import Base from '../../../layouts/Base.astro';
import Film from '../../../components/Film.astro';
import Shot from '../../../components/Shot.astro';
import { film, exists } from '../../../lib/media';
import { locales, path, tr, type Locale } from '../../../i18n/config';
import { ui } from '../../../i18n/ui';
import { projects, type Project } from '../../../content/projects';
import { profile } from '../../../content/profile';

export const getStaticPaths = () =>
  locales.flatMap((lang) => projects.map((project) => ({ params: { lang, slug: project.slug }, props: { project } })));

const lang = Astro.params.lang as Locale;
const { project: p } = Astro.props as { project: Project };
const i = projects.indexOf(p);
const next = projects[(i + 1) % projects.length];
const desk = film(p.film?.desktop);
const mob = film(p.film?.mobile);
const featureFilm = film(p.feature?.film);
const featurePoster = film(p.feature?.poster);
const label = `${p.title} — ${tr(ui.work.film, lang)}`;
const ogImage = exists(`og/${p.slug}-${lang}.jpg`) ? `og/${p.slug}-${lang}.jpg` : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: p.title,
  description: tr(p.tagline, lang),
  inLanguage: lang,
  dateCreated: p.year.replace(/\D.*$/, ''),
  author: { '@type': 'Person', name: profile.name.en, url: new URL(path('en'), Astro.site).href },
  keywords: p.stack.join(', '),
};
---

<Base lang={lang} title={`${p.title} — ${tr(profile.name, lang)}`} description={tr(p.tagline, lang)} route={`work/${p.slug}`} ogImage={ogImage} jsonLd={jsonLd}>
  <article class="case" style={`--tone:${p.tone}`}>
    <header class="case__head wrap">
      <a class="case__back mono link-u" href={`${path(lang)}#work`}><span class="arrow" aria-hidden="true" style="display:inline-block">←</span> {tr(ui.work.back, lang)}</a>
      <p class="case__index mono" data-reveal><span>{p.index}</span> {tr(p.category, lang)}</p>
      <h1 class="case__title display">
        <span class="line-mask" data-onload><span>{p.title}</span></span>
        {p.alias && <span class="case__alias" lang="ar">{p.alias}</span>}
      </h1>
      <p class="case__tagline" data-reveal style="--i:1">{tr(p.tagline, lang)}</p>
      <dl class="case__meta" data-reveal style="--i:2">
        <div><dt class="mono">{tr(ui.work.year, lang)}</dt><dd>{p.year}</dd></div>
        <div><dt class="mono">{tr(ui.work.role, lang)}</dt><dd>{tr(p.role, lang)}</dd></div>
        <div><dt class="mono">{tr(ui.work.context, lang)}</dt><dd>{tr(p.context, lang)}</dd></div>
      </dl>
    </header>

    <div class="case__hero wrap" data-reveal>
      {desk ? (
        <Film film={desk} label={label} lang={lang} ratio="16 / 10" />
      ) : p.cover.kind === 'figure' ? (
        <Shot src={p.cover.src} alt={tr(p.cover.alt, lang)} figure fit="contain" ratio="16 / 10" eager sizes="100vw" />
      ) : (
        <Shot src={p.cover.src} alt={tr(p.cover.alt, lang)} eager sizes="100vw" />
      )}
      {desk && <p class="case__credit mono">{tr(ui.work.film, lang)}</p>}
    </div>

    <section class="case__story wrap">
      <p class="case__summary" data-reveal>{tr(p.summary, lang)}</p>
      <div class="case__cols">
        <div>
          <h2 class="mono case__h">{tr(ui.work.built, lang)}</h2>
          <ol class="case__built">
            {p.built.map((b, n) => <li data-reveal style={`--i:${n}`}><span class="mono">{String(n + 1).padStart(2, '0')}</span><p>{tr(b, lang)}</p></li>)}
          </ol>
        </div>
        <aside class="case__side">
          {p.metric && (
            <div class="case__metric" data-reveal>
              <p class="display" dir="ltr">{p.metric.value}</p>
              <p class="mono">{tr(p.metric.label, lang)}</p>
            </div>
          )}
          <div data-reveal>
            <h2 class="mono case__h">{tr(ui.work.stack, lang)}</h2>
            <ul class="case__stack" lang="en">{p.stack.map((s) => <li class="pill">{s}</li>)}</ul>
          </div>
          {p.notes && (
            <div data-reveal>
              <h2 class="mono case__h">{tr(ui.work.details, lang)}</h2>
              {p.notes.map((n) => <p class="case__note">{tr(n, lang)}</p>)}
            </div>
          )}
          {p.links.length > 0 && (
            <div data-reveal>
              <h2 class="mono case__h">{tr(ui.work.links, lang)}</h2>
              <ul class="case__links">
                {p.links.map((l) => (
                  <li><a class="link-u" href={l.href} target="_blank" rel="noopener"><span class="mono">{tr(l.label === 'live' ? ui.work.live : ui.work.source, lang)}</span> <span dir="ltr">{l.text ?? l.href}</span> <span class="arrow" aria-hidden="true">↗</span></a></li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </section>

    {(mob || p.feature) && (
      <section class="case__feature wrap">
        {p.feature && (
          <header class="case__feature-head" data-reveal>
            <h2 class="display">{tr(p.feature.title, lang)}</h2>
            <p>{tr(p.feature.body, lang)}</p>
          </header>
        )}
        <div class="case__feature-media">
          {featureFilm && <div class="phone" data-reveal data-parallax="6"><Film film={featureFilm} label={label} lang={lang} ratio="390 / 844" /></div>}
          {mob && <div class="phone" data-reveal data-parallax="6"><Film film={mob} label={label} lang={lang} ratio="390 / 844" /></div>}
          {featurePoster && <div class="case__feature-wide" data-reveal><Film film={featurePoster} label={`${p.title} — film`} lang={lang} ratio="16 / 9" /></div>}
        </div>
      </section>
    )}

    {p.gallery.length > 0 && (
      <section class="case__gallery wrap" aria-label={tr(ui.work.gallery, lang)}>
        <h2 class="mono case__h">{tr(ui.work.gallery, lang)}</h2>
        <div class="gallery">
          {p.gallery.map((g) => (
            <figure class:list={['gallery__item', `gallery__item--${g.kind}`]} data-reveal>
              {g.kind === 'mobile' ? (
                <div class="phone"><Shot src={g.src} alt={tr(g.alt, lang)} ratio="390 / 844" sizes="20rem" /></div>
              ) : (
                <Shot src={g.src} alt={tr(g.alt, lang)} figure={g.kind === 'figure'} fit={g.kind === 'figure' ? 'contain' : 'cover'} sizes="(max-width: 900px) 100vw, 50vw" />
              )}
              <figcaption class="mono">{tr(g.alt, lang)}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {p.caveat && (
      <aside class="case__caveat wrap" data-reveal>
        <p><span class="mono">{tr(ui.work.note, lang)}</span> {tr(p.caveat, lang)}</p>
      </aside>
    )}

    <a class="case__next" href={path(lang, `work/${next.slug}`)} style={`--tone:${next.tone}`}>
      <span class="wrap case__next-inner">
        <span class="mono">{tr(ui.work.next, lang)} — {next.index}</span>
        <span class="display case__next-title">{next.title} <span class="arrow" aria-hidden="true">→</span></span>
      </span>
    </a>
  </article>
</Base>

<style>
  .case__head { display: grid; gap: 1.4rem; padding-block: 8rem 3.5rem; }
  .case__back { justify-self: start; color: var(--muted); }
  [dir='rtl'] .case__back .arrow { transform: scaleX(-1); }
  .case__index span { color: var(--tone-text); margin-inline-end: 0.8rem; }
  .case__title { font-size: var(--step-6); line-height: 0.85; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.2em 0.35em; }
  :lang(ar) .case__title { line-height: 1.1; }
  .case__title .line-mask > span { display: block; }
  .case__alias { font-family: var(--font-arabic); font-size: 0.3em; font-weight: 300; color: var(--muted); letter-spacing: 0; }
  .case__tagline { font-size: var(--step-2); line-height: 1.25; max-inline-size: 42rem; color: var(--paper-2); font-family: var(--font-display); }
  :lang(ar) .case__tagline { font-family: var(--font-arabic); font-weight: 300; line-height: 1.6; }
  .case__meta { display: grid; grid-template-columns: 8rem 1fr 1.6fr; gap: var(--gutter); padding-block-start: 1.6rem; border-block-start: 1px solid var(--line); }
  .case__meta dd { margin-block-start: 0.35rem; color: var(--paper-2); }

  .case__hero { position: relative; }
  .case__hero::before { content: ''; position: absolute; inset: 10% 15% -5%; z-index: -1; background: radial-gradient(closest-side, var(--tone), transparent); opacity: 0.16; filter: blur(80px); }
  .case__credit { margin-block-start: 0.8rem; }

  .case__story { padding-block: var(--section) 0; }
  .case__summary { font-family: var(--font-display); font-size: var(--step-3); line-height: 1.15; max-inline-size: 58rem; }
  :lang(ar) .case__summary { font-family: var(--font-arabic); font-weight: 300; font-size: var(--step-2); line-height: 1.7; }
  .case__cols { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: calc(var(--gutter) * 2); margin-block-start: 5rem; }
  .case__h { margin-block-end: 1.2rem; }
  .case__built { border-block-start: 1px solid var(--line); }
  .case__built li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding-block: 1.3rem; border-block-end: 1px solid var(--line); color: var(--paper-2); }
  .case__built li .mono { color: var(--tone-text); padding-block-start: 0.2rem; }
  .case__side { display: grid; gap: 2.6rem; align-content: start; }
  .case__metric { padding: 1.6rem; border-radius: var(--radius-lg); background: var(--ink-2); box-shadow: 0 0 0 1px var(--line) inset; }
  .case__metric .display { font-size: var(--step-5); color: var(--tone-text); line-height: 1; margin-block-end: 0.6rem; font-family: 'Instrument Serif', serif; }
  .case__stack { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .case__note { color: var(--paper-2); font-size: var(--step--1); line-height: 1.6; }
  .case__note + .case__note { margin-block-start: 0.8rem; }
  .case__links { display: grid; gap: 0.7rem; }
  .case__links .mono { margin-inline-end: 0.5rem; }

  .case__feature { padding-block: var(--section) 0; display: grid; gap: 3rem; }
  .case__feature-head { display: grid; gap: 1rem; max-inline-size: 40rem; }
  .case__feature-head h2 { font-size: var(--step-4); }
  .case__feature-head p { color: var(--paper-2); }
  .case__feature-media { display: flex; gap: calc(var(--gutter) * 1.2); align-items: center; }
  .case__feature-media .phone { flex: 0 0 clamp(11rem, 17vw, 17rem); }
  .case__feature-media .phone:nth-child(2) { margin-block-start: 5rem; }
  .case__feature-wide { flex: 1 1 0; min-inline-size: 0; }

  .case__gallery { padding-block: var(--section) 0; }
  .gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: calc(var(--gutter) * 1.2) var(--gutter); }
  .gallery__item { display: grid; gap: 0.7rem; align-content: start; }
  .gallery__item--figure { grid-column: 1 / -1; }
  .gallery__item--poster { grid-column: span 1; }
  .gallery__item--mobile { max-inline-size: 20rem; }
  .gallery:has(.gallery__item--poster) { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .gallery:has(.gallery__item--poster) .gallery__item--desktop { grid-column: span 3; }
  .gallery:has(.gallery__item--poster) .gallery__item--poster { grid-column: span 2; }

  .case__caveat { padding-block-start: 4rem; }
  .case__caveat p { max-inline-size: 48rem; padding: 1.2rem 1.4rem; border-inline-start: 2px solid var(--tone); background: var(--ink-2); color: var(--paper-2); font-size: var(--step--1); }
  .case__caveat .mono { color: var(--paper); margin-inline-end: 0.6rem; }

  .case__next { display: block; margin-block-start: var(--section); border-block: 1px solid var(--line); padding-block: 4rem; transition: background 0.8s var(--ease-out); }
  .case__next:hover { background: color-mix(in srgb, var(--tone) 10%, transparent); }
  .case__next-inner { display: grid; gap: 1rem; }
  .case__next-title { font-size: var(--step-5); }
  .case__next:hover .arrow { transform: translateX(10px); }
  [dir='rtl'] .case__next .arrow { transform: scaleX(-1); }
  [dir='rtl'] .case__next:hover .arrow { transform: scaleX(-1) translateX(10px); }

  @media (max-width: 900px) {
    .case__meta { grid-template-columns: 1fr; gap: 1rem; }
    .case__cols { grid-template-columns: 1fr; }
    .case__feature-media { flex-wrap: wrap; justify-content: center; }
    .case__feature-media .phone { flex-basis: calc(50% - var(--gutter)); max-inline-size: 16rem; }
    .case__feature-media .phone:nth-child(2) { margin-block-start: 2.5rem; }
    .case__feature-wide { flex-basis: 100%; }
    .gallery, .gallery:has(.gallery__item--poster) { grid-template-columns: 1fr 1fr; }
    .gallery:has(.gallery__item--poster) .gallery__item--desktop { grid-column: 1 / -1; }
    .gallery:has(.gallery__item--poster) .gallery__item--poster { grid-column: span 1; }
    .gallery__item--desktop { grid-column: 1 / -1; }
  }
</style>
