---
import Base from '../../layouts/Base.astro';
import Hero from '../../sections/Hero.astro';
import Work from '../../sections/Work.astro';
import About from '../../sections/About.astro';
import Path from '../../sections/Path.astro';
import Credentials from '../../sections/Credentials.astro';
import Capabilities from '../../sections/Capabilities.astro';
import MoreWork from '../../sections/MoreWork.astro';
import Contact from '../../sections/Contact.astro';
import { locales, tr, type Locale } from '../../i18n/config';
import { profile } from '../../content/profile';

export const getStaticPaths = () => locales.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Locale;
const title = `${tr(profile.name, lang)} — ${tr(profile.role, lang)}`;
---

<Base lang={lang} title={title} description={tr(profile.statement, lang)}>
  <Hero lang={lang} />
  <Work lang={lang} />
  <About lang={lang} />
  <Path lang={lang} />
  <Credentials lang={lang} />
  <Capabilities lang={lang} />
  <MoreWork lang={lang} />
  <Contact lang={lang} />
</Base>
